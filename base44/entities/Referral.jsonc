{
  "name": "Referral",
  "type": "object",
  "description": "SOFTWARE-AFFILIATE referral record (company signups / subscription referrals) \u2014 deliberately distinct from real-estate referral compensation. Referral Rebuild Phase 1 access rules: a participant reads only referrals they gave or received; a signed-in user may CREATE only their OWN outgoing PENDING invite records (referrer_id = self, status pending) \u2014 qualifying state (subscribed/paid, first_payment_date, reward_status) is written only by admin backend functions; updates and deletes are admin-only.",
  "properties": {
    "referrer_id": {
      "type": "string",
      "description": "User ID of the person who made the referral"
    },
    "referrer_name": {
      "type": "string",
      "description": "Name of the referrer"
    },
    "referrer_email": {
      "type": "string",
      "description": "Email of the referrer"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique referral code"
    },
    "referred_user_id": {
      "type": "string",
      "description": "User ID of the person who signed up"
    },
    "referred_user_name": {
      "type": "string",
      "description": "Name of the referred user"
    },
    "referred_user_email": {
      "type": "string",
      "description": "Email of the referred user"
    },
    "referred_company_name": {
      "type": "string",
      "description": "Company name of referred business"
    },
    "referred_email": {
      "type": "string",
      "description": "Email of referred business (legacy field)"
    },
    "account_type": {
      "type": "string",
      "description": "Account type of the referred user"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "signed_up",
        "subscribed",
        "converted",
        "paid"
      ],
      "default": "pending",
      "description": "Status of the referral"
    },
    "subscription_started_date": {
      "type": "string",
      "format": "date-time",
      "description": "When they started their subscription"
    },
    "first_payment_date": {
      "type": "string",
      "format": "date-time",
      "description": "When first payment was received"
    },
    "reward_amount": {
      "type": "number",
      "default": 25,
      "description": "Reward amount in dollars"
    },
    "reward_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "sent",
        "claimed"
      ],
      "default": "pending",
      "description": "Status of the reward"
    }
  },
  "required": [
    "referrer_id",
    "referral_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.referrer_id": "{{user.id}}"
        },
        {
          "data.referred_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.referrer_id": "{{user.id}}"
            },
            {
              "data.status": "pending"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}