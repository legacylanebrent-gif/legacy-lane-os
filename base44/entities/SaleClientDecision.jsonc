{
  "name": "SaleClientDecision",
  "type": "object",
  "description": "Chapter 1 P1 \u2014 canonical sale-scoped client decision record with change history. Answers WHO authorized it, WHEN, WHAT they instructed, HOW it was received, and WHETHER it later changed. KEEP/SELL/REVIEW merchandise decisions are decision_type 'merchandise' on this same architecture \u2014 there is no second merchandise-decision system. Item.status (selling/transaction state) remains fully independent of these records. Chapter 4 P1: decision_type 'financial' with current_decision 'authorized' and charge_amount > 0 records a client-AUTHORIZED ADDITIONAL SERVICE CHARGE that flows to the settlement statement \u2014 there is no separate charge-approval entity. Chapter 6 P2: decision_type 'financial' with related_expense_id set authorizes CLIENT REIMBURSEMENT of a canonical Expense \u2014 it is deliberately EXCLUDED from service-charge revenue and instead flows to settlement as an authorized reimbursable expense line. A company expense never reduces client proceeds without a decision like this. Chapter 13 P1 adds the REQUEST STATE (a client request is NOT an approved change): while request_status is REQUESTED/UNDER_REVIEW the requested instruction NEVER changes current_decision or project truth \u2014 only explicit operator approval appends the controlling history entry. Chapter 13 P1 adds image_index for image-level merchandise decisions: a KEEP decision on a property photo marks it retained-private (excluded_from_public) so it never enters the public gallery or marketing.",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "EstateSale this decision belongs to."
    },
    "operator_id": {
      "type": "string",
      "description": "EstateSale.operator_id projection \u2014 sale owner (RLS anchor). Derived from the sale at creation."
    },
    "company_id": {
      "type": "string",
      "description": "EstateSale.company_id projection when present."
    },
    "sale_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "READ-SCOPE PROJECTION of EstateSale.sale_team for RLS. The sale remains the source of truth."
    },
    "decision_type": {
      "type": "string",
      "enum": [
        "general",
        "merchandise",
        "pricing",
        "disposition",
        "financial",
        "property_access",
        "other"
      ],
      "default": "general",
      "description": "What kind of matter this decision governs. 'merchandise' = KEEP/SELL/REVIEW. 'financial' + current_decision 'authorized' = client-authorized additional service charge (Chapter 4 P1). 'financial' + related_expense_id = client-authorized reimbursement of a canonical Expense (Chapter 6 P2)."
    },
    "subject": {
      "type": "string",
      "description": "What the decision is about (description of the matter, item, or question)."
    },
    "item_id": {
      "type": "string",
      "description": "Canonical Item this merchandise decision attaches to (decision_type 'merchandise' only). Item selling status is never modified by this record."
    },
    "image_index": {
      "type": "integer",
      "description": "Chapter 13 P1 \u2014 index into EstateSale.images for an image-level merchandise decision (decision_type 'merchandise' without item_id). A KEEP image decision marks the photo retained-private (sale.images[i].excluded_from_public = true): it never appears in the public gallery, marketing kit, or public website. SELL clears the retained-private mark."
    },
    "charge_amount": {
      "type": "number",
      "description": "For decision_type 'financial': the dollar amount involved. Without related_expense_id it is a client-authorized ADDITIONAL SERVICE CHARGE (Chapter 4 P1) that flows to settlement as company revenue while current_decision is 'authorized'. WITH related_expense_id it mirrors the linked reimbursable Expense amount for audit and is EXCLUDED from service-charge revenue \u2014 the linked expense flows to settlement as an authorized reimbursable expense instead. Never a merchandise price."
    },
    "related_expense_id": {
      "type": "string",
      "description": "Chapter 6 P2 \u2014 canonical Expense ID when this decision authorizes CLIENT REIMBURSEMENT of a sale expense marked is_reimbursable. Presence alone changes the financial semantics: the decision is a reimbursement authorization, not a service charge. The expense remains the record of the cost (description, amount, date, receipt); this decision is the authorization/agreement basis that lets it reduce client proceeds."
    },
    "current_decision": {
      "type": "string",
      "description": "The CONTROLLING instruction. For merchandise: 'keep' | 'sell' | 'review'. For financial service charges: 'authorized' | 'declined' (or free text for other financial matters). Free text for other types. NEVER changed by a mere request \u2014 only by operator-recorded approval."
    },
    "request_status": {
      "type": "string",
      "enum": [
        "REQUESTED",
        "UNDER_REVIEW",
        "APPROVED",
        "DECLINED",
        "CANCELLED"
      ],
      "description": "Chapter 13 P1 \u2014 the CLIENT REQUEST state on this same record (no DecisionRequest entity). REQUESTED/UNDER_REVIEW = the client asked for something (see requested_decision) that is NOT yet approved \u2014 current_decision and project truth stay unchanged. APPROVED = the operator approved the request; the approval is recorded as the controlling history entry (requester + approver + timestamp preserved). DECLINED/CANCELLED = the request did not proceed; history keeps the request visible. Null = no outstanding request \u2014 the record is a direct operator-recorded authorized decision (all pre-Chapter-13 semantics unchanged)."
    },
    "requested_decision": {
      "type": "string",
      "description": "Chapter 13 P1 \u2014 WHAT the client asked for, kept distinct from current_decision until approved (e.g. current_decision 'sell', requested_decision 'keep')."
    },
    "requested_by_name": {
      "type": "string",
      "description": "Chapter 13 P1 \u2014 who made the request (client/family member name)."
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 13 P1 \u2014 when the request arrived."
    },
    "answer_by": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 13 P1 \u2014 when the client needs an answer to the request. Past date with REQUESTED/UNDER_REVIEW = ANSWER OVERDUE (deterministic display only, never a deadline engine)."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ],
      "default": "open",
      "description": "Open = attention remains needed (e.g. REVIEW merchandise awaiting a client decision). Resolved = the matter is settled; the controlling decision and full history remain visible."
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string"
          },
          "authorized_by": {
            "type": "string",
            "description": "SaleAuthority ID."
          },
          "authorized_by_name": {
            "type": "string",
            "description": "Authority display-name snapshot at decision time."
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "description": "How the instruction was received (phone, email, in_person, text, contract, other)."
          },
          "reason": {
            "type": "string",
            "description": "Why the decision changed, when it did."
          },
          "notes": {
            "type": "string"
          },
          "recorded_by": {
            "type": "string"
          },
          "recorded_by_name": {
            "type": "string"
          }
        },
        "default": []
      },
      "default": [],
      "description": "Chronological decision history. The LAST entry is the current controlling decision; earlier entries are never overwritten."
    },
    "authorized_by": {
      "type": "string",
      "description": "SaleAuthority ID of the decision-maker for the current controlling decision (mirrors last history entry)."
    },
    "authorized_by_name": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "description": "How the current instruction was received."
    },
    "evidence_ref": {
      "type": "string",
      "description": "Optional reference to supporting evidence/attachment."
    },
    "notes": {
      "type": "string"
    },
    "recorded_by": {
      "type": "string",
      "description": "EstateSalen user who recorded the current decision."
    },
    "recorded_by_name": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_note": {
      "type": "string"
    }
  },
  "required": [
    "sale_id",
    "subject",
    "current_decision"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}