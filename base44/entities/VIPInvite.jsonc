{
  "name": "VIPInvite",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "VIP Event ID"
    },
    "operator_id": {
      "type": "string",
      "description": "VIPEvent.operator_id projection \u2014 event owner (RLS anchor). Derived from the event at creation."
    },
    "name": {
      "type": "string",
      "description": "Invitee name"
    },
    "email": {
      "type": "string",
      "description": "Invitee email"
    },
    "phone": {
      "type": "string",
      "description": "Invitee phone"
    },
    "user_id": {
      "type": "string",
      "description": "Chapter 5 P1 \u2014 canonical platform User ID of the invitee when known. Invites are operator-entered on behalf of third parties, so this is usually null until a buyer-side RSVP flow can capture the authenticated identity. Never auto-filled by email resemblance alone."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending",
      "description": "RSVP status"
    },
    "tickets_allocated": {
      "type": "integer",
      "default": 1,
      "description": "Number of tickets allocated to this invite"
    },
    "invited_date": {
      "type": "string",
      "format": "date-time",
      "description": "When invite was sent"
    },
    "responded_date": {
      "type": "string",
      "format": "date-time",
      "description": "When they responded"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "event_id",
    "name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}