{
  "name": "SaleRecap",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "/sale-recap/{slug}"
    },
    "title": {
      "type": "string"
    },
    "operator_id": {
      "type": "string"
    },
    "operator_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "sale_dates": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "total_items": {
      "type": "integer",
      "default": 0
    },
    "total_sold": {
      "type": "integer",
      "default": 0
    },
    "total_views": {
      "type": "integer",
      "default": 0
    },
    "estimated_sale_value": {
      "type": "number"
    },
    "actual_revenue": {
      "type": "number"
    },
    "top_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notable_brands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "most_valuable_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sold_price": {
            "type": "number"
          },
          "image_url": {
            "type": "string"
          },
          "item_knowledge_id": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "category_breakdown": {
      "type": "object",
      "description": "{ category: count }"
    },
    "ai_summary": {
      "type": "string"
    },
    "historical_notes": {
      "type": "string"
    },
    "primary_image_url": {
      "type": "string"
    },
    "seo_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "schema_json": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "indexed_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "submitted",
        "indexed",
        "not_indexed",
        "unknown"
      ],
      "default": "not_submitted"
    },
    "would_take_ten_more": {
      "type": "string",
      "enum": [
        "YES",
        "MAYBE",
        "NO"
      ],
      "description": "Chapter 5 P1 \u2014 owner post-sale reflection: would you want ten more sales like this one? Operator-owned judgment on the canonical recap record; AI may analyze it later but never overwrites it. Feeds future Ideal Sale Profile / market intelligence."
    },
    "would_take_ten_more_why": {
      "type": "string",
      "description": "Chapter 5 P1 \u2014 the operator's free-text reason (excellent client, strong merchandise, too much labor, poor parking, great referral source, etc.). Never hard-coded conclusions."
    },
    "would_take_ten_more_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reflection was last saved."
    }
  },
  "required": [
    "sale_id"
  ]
}