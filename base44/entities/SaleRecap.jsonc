{
  "name": "SaleRecap",
  "type": "object",
  "description": "Chapter 24 P0-2 \u2014 a recap is generated as a PRIVATE DRAFT (status 'draft') with an AI summary from canonical sale records. The AI summary remains an AI-GENERATED DRAFT until a human approves it: only the sale operator (or an admin) may publish (publishSaleRecap), and publication strips private financial figures. actual_revenue/estimated_sale_value are deliberately written as null \u2014 a PUBLIC RECAP MUST NOT EXPOSE PRIVATE FINANCIAL DATA.",
  "properties": {
    "sale_id": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "/sale-recap/{slug}"
    },
    "title": {
      "type": "string"
    },
    "operator_id": {
      "type": "string",
      "description": "Estate Sale Company Owner user ID (RLS anchor)."
    },
    "operator_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "sale_dates": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "total_items": {
      "type": "integer",
      "default": 0
    },
    "total_sold": {
      "type": "integer",
      "default": 0
    },
    "total_views": {
      "type": "integer",
      "default": 0
    },
    "estimated_sale_value": {
      "type": "number",
      "description": "Chapter 24 P0-2B \u2014 deliberately null: private financial figures are never stored on the public-facing recap record."
    },
    "actual_revenue": {
      "type": "number",
      "description": "Chapter 24 P0-2B \u2014 deliberately null: private financial figures are never stored on the public-facing recap record."
    },
    "top_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notable_brands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "most_valuable_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sold_price": {
            "type": "number"
          },
          "image_url": {
            "type": "string"
          },
          "item_knowledge_id": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "category_breakdown": {
      "type": "object",
      "description": "{ category: count }"
    },
    "ai_summary": {
      "type": "string",
      "description": "Chapter 24 \u2014 AI-GENERATED DRAFT text. It is written by the automation, never publishes on its own, and never becomes evidence merely because it was generated from records."
    },
    "historical_notes": {
      "type": "string"
    },
    "primary_image_url": {
      "type": "string"
    },
    "seo_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "schema_json": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "description": "Chapter 24 P0-2 \u2014 'draft' is the automation's only output; 'published' is written exclusively by the human approval path (publishSaleRecap)."
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 24 P0-2A \u2014 when the operator approved publication."
    },
    "published_by_name": {
      "type": "string",
      "description": "Chapter 24 P0-2A \u2014 display-name snapshot of the approving operator."
    },
    "indexed_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "submitted",
        "indexed",
        "not_indexed",
        "unknown"
      ],
      "default": "not_submitted"
    },
    "would_take_ten_more": {
      "type": "string",
      "enum": [
        "YES",
        "MAYBE",
        "NO"
      ],
      "description": "Chapter 5 P1 \u2014 owner post-sale reflection: would you want ten more sales like this one? Operator-owned judgment on the canonical recap record; AI may analyze it later but never overwrites it. Feeds future Ideal Sale Profile / market intelligence."
    },
    "would_take_ten_more_why": {
      "type": "string",
      "description": "Chapter 5 P1 \u2014 the operator's free-text reason (excellent client, strong merchandise, too much labor, poor parking, great referral source, etc.). Never hard-coded conclusions."
    },
    "would_take_ten_more_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reflection was last saved."
    },
    "post_sale_review": {
      "type": "object",
      "default": {},
      "description": "Chapter 23 P1 \u2014 the operator's structured FIVE-MINUTE POST-SALE REVIEW on the canonical recap record (no new entity): what worked, what didn't, what surprised, what to change next time, optional team input. Plain operator-owned reflection \u2014 never AI-written, never client-facing.",
      "properties": {
        "what_worked": {
          "type": "string"
        },
        "what_didnt": {
          "type": "string"
        },
        "surprised_us": {
          "type": "string"
        },
        "change_next_time": {
          "type": "string"
        },
        "team_input": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_by_name": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "sale_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}