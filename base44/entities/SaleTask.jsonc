{
  "name": "SaleTask",
  "type": "object",
  "description": "Chapter 1 P1 \u2014 persisted operator task for the canonical SaleTasks workflow (15-step template). Adds accountability to the existing task system: assignee, due date, blocked state, priority, attention flag, and completion audit. NOT a parallel task-management application \u2014 SaleTasks (page) remains the single task surface. Chapter 13 P1 adds the smallest real DEPENDENCY MODEL (blocked_by_task_ids / blocked_by_decision_ids / blocked_by_issue_ids \u2014 references, never a graph engine) and TASK PROVENANCE (source_type/source_id/source_label answers WHY DOES THIS TASK EXIST). The boolean blocked flag remains the display cache; when any dependency is unresolved the task is blocked and the UI shows WHAT IT IS WAITING FOR. Resolving all dependencies unblocks the task but NEVER auto-completes it. Chapter 19 P1 adds definition_of_done \u2014 the plain acceptance criteria the assignee can read in My Sale Day before starting work.",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "EstateSale this task belongs to."
    },
    "operator_id": {
      "type": "string",
      "description": "EstateSale.operator_id projection \u2014 sale owner (RLS anchor). Derived from the sale at creation."
    },
    "sale_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "READ-SCOPE PROJECTION of EstateSale.sale_team for RLS. The sale remains the source of truth."
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "definition_of_done": {
      "type": "string",
      "description": "Chapter 19 P1-4 \u2014 acceptance criteria in plain words: what must be TRUE for this task to count as complete ('All zone tables labeled with prices; photos of each display taken'). Honest criteria the assignee can verify themselves; optional, and never a substitute for the human completion decision."
    },
    "category": {
      "type": "string",
      "description": "Task category (Planning, Preparation, Marketing, Execution, Post-Sale)."
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started",
      "description": "Canonical SaleTasks statuses \u2014 unchanged."
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "assignee_user_id": {
      "type": "string",
      "description": "User ID of the responsible person (operator or sale_team member). Empty = unassigned."
    },
    "assignee_name": {
      "type": "string",
      "description": "Assignee display-name snapshot at assignment time."
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "description": "Separate blocked flag \u2014 intentionally NOT a status, so not_started/in_progress/completed stay intact. Chapter 13 P1: a display cache synced from the dependency fields below; the dependency references are the truth."
    },
    "blocked_reason": {
      "type": "string",
      "description": "Human-readable 'waiting for' summary synced from the dependency fields (what/who it is waiting for)."
    },
    "blocked_by_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Chapter 13 P1 \u2014 this task waits on these SaleTask ids completing. Reference-only dependency \u2014 no graph engine, and a simple deterministic cycle guard prevents A\u2192B\u2192A loops."
    },
    "blocked_by_decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Chapter 13 P1 \u2014 this task waits on these SaleClientDecision ids being approved and resolved."
    },
    "blocked_by_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Chapter 13 P1 \u2014 this task waits on these SaleIssue ids reaching RESOLVED/CANCELLED."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "CONSULTATION",
        "CLIENT_DECISION",
        "SALE_ISSUE",
        "SALE_NOTE",
        "COMMUNICATION",
        "ACCEPTANCE_CONDITION",
        "ONBOARDING_TEMPLATE",
        "MANUAL"
      ],
      "default": "MANUAL",
      "description": "Chapter 13 P1 \u2014 task PROVENANCE: why this task exists (a promise converted to work, an approved decision, an issue resolution, onboarding template, or manual)."
    },
    "source_id": {
      "type": "string",
      "description": "Id of the source record (note, decision, issue, activity...) when applicable."
    },
    "source_label": {
      "type": "string",
      "description": "Short excerpt/label of the source promise \u2014 no sensitive full communication text copied."
    },
    "attention": {
      "type": "boolean",
      "default": false,
      "description": "Operator-set escalation/attention flag."
    },
    "attention_reason": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the task was completed (historical accountability)."
    },
    "completed_by": {
      "type": "string",
      "description": "User ID that completed the task."
    },
    "completed_by_name": {
      "type": "string"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "sale_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}