{
  "name": "ReferralDealAgreement",
  "type": "object",
  "description": "Legacy referral exchange deal agreement record. Referral Rebuild Phase 1: acceptance that creates new agreements is paused server-side; a record is never evidence of a signed or executed agreement (contract_generated stays false until a real executed document exists). The deal's agent and operator may read their own agreements; all writes are admin-only / service-role. Existing documents and status history are preserved.",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Unique deal identifier"
    },
    "lead_id": {
      "type": "string",
      "description": "Reference to the ReferralLead"
    },
    "property_address": {
      "type": "string",
      "description": "Full property address"
    },
    "agent_id": {
      "type": "string",
      "description": "User ID of the real estate agent"
    },
    "operator_id": {
      "type": "string",
      "description": "User ID of the Estate Sale Company Owner"
    },
    "referral_agent_name": {
      "type": "string",
      "description": "Name of the designated referral agent (e.g., Brent Cramp)"
    },
    "referral_agent_brokerage": {
      "type": "string",
      "description": "Brokerage of the designated referral agent"
    },
    "acceptance_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when deal agreement was accepted"
    },
    "acceptance_ip": {
      "type": "string",
      "description": "IP address at time of acceptance"
    },
    "contract_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether a real contract document has been generated for this deal. Generating a record never sets this \u2014 only an actual document does."
    },
    "contract_url": {
      "type": "string",
      "description": "URL to the generated contract document (only ever set to a real document URL \u2014 never a placeholder)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "disputed"
      ],
      "default": "active",
      "description": "Current status of the deal agreement"
    }
  },
  "required": [
    "deal_id",
    "lead_id",
    "property_address",
    "agent_id",
    "operator_id",
    "referral_agent_name",
    "referral_agent_brokerage",
    "acceptance_timestamp",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}