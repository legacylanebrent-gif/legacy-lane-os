{
  "name": "ProviderDirectory",
  "type": "object",
  "description": "Platform-facing public provider directory for life-transition resource pages. Chapter 11 P0-1: PUBLIC READ stays open (intentional public directory); ALL writes are admin-only \u2014 PUBLIC READ \u2260 PUBLIC WRITE. The rating/review_count fields are preserved for historical records only; there is no non-admin write path and Chapter 11 direction is no public consumer star-rating system.",
  "properties": {
    "provider_type": {
      "type": "string",
      "enum": [
        "estate_sale_operator",
        "realtor",
        "cleanout_vendor",
        "investor",
        "attorney_resource"
      ]
    },
    "business_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "counties_served_json": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "zip_codes_served_json": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "specialties_json": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "profile_slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "description": "Historical data only. No public rating write path; not part of the Chapter 11 operator network."
    },
    "review_count": {
      "type": "integer",
      "default": 0,
      "description": "Historical data only."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending"
      ],
      "default": "pending"
    }
  },
  "required": [
    "provider_type",
    "business_name",
    "state"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}