{
  "name": "Offer",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "Estate sale ID"
    },
    "operator_id": {
      "type": "string",
      "description": "EstateSale.operator_id projection \u2014 sale owner (RLS anchor). Derived from the sale at creation."
    },
    "item_name": {
      "type": "string",
      "description": "Item being offered on"
    },
    "offer_amount": {
      "type": "number",
      "description": "Offer amount"
    },
    "full_name": {
      "type": "string",
      "description": "Buyer's full name"
    },
    "phone": {
      "type": "string",
      "description": "Buyer's phone number"
    },
    "email": {
      "type": "string",
      "description": "Buyer's email"
    },
    "user_id": {
      "type": "string",
      "description": "Chapter 5 P1 \u2014 canonical platform User ID of the buyer when the offer comes from (or is later claimed by) an authenticated user. Offers are operator-recorded on behalf of buyers, so this is commonly null; it is never inferred from a similar email/phone. Name/phone/email remain for display and operations."
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "default": "pending",
      "description": "Offer status"
    }
  },
  "required": [
    "sale_id",
    "item_name",
    "offer_amount",
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.user_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}