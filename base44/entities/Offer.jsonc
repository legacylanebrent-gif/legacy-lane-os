{
  "name": "Offer",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "Estate sale ID"
    },
    "operator_id": {
      "type": "string",
      "description": "EstateSale.operator_id projection \u2014 sale owner (RLS anchor). Derived from the sale at creation."
    },
    "item_id": {
      "type": "string",
      "description": "Chapter 15 P1-35 \u2014 CANONICAL Item link (stable database ID). New offers reference this ID; the merchandise is never identified by its mutable name. Legacy offers created before Chapter 15 may have this empty \u2014 they keep item_name for display and are linked only through deterministic backfill or operator review, never guessed."
    },
    "item_name": {
      "type": "string",
      "description": "LEGACY display snapshot of the item title at offer time. Display only \u2014 never the offer's identity (item_id is)."
    },
    "offer_amount": {
      "type": "number",
      "description": "Offer amount"
    },
    "full_name": {
      "type": "string",
      "description": "Buyer's full name"
    },
    "phone": {
      "type": "string",
      "description": "Buyer's phone number"
    },
    "email": {
      "type": "string",
      "description": "Buyer's email"
    },
    "user_id": {
      "type": "string",
      "description": "Chapter 5 P1 \u2014 canonical platform User ID of the buyer when the offer comes from (or is later claimed by) an authenticated user. Offers are operator-recorded on behalf of buyers, so this is commonly null; it is never inferred from a similar email/phone. Name/phone/email remain for display and operations."
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "default": "pending",
      "description": "Offer status. Accepted means commercial intent / accepted price \u2014 it is NEVER payment; payment truth stays in the Order/Transaction system."
    },
    "converted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 15 P1-40 \u2014 when an ACCEPTED offer was handed off to the checkout workflow. IDEMPOTENCY ANCHOR: presence means the handoff already happened; a repeated conversion must never create a second cart/transaction."
    },
    "converted_cart_id": {
      "type": "string",
      "description": "Chapter 15 P1-39 \u2014 the Cart prepared from this accepted offer (when the buyer is a platform user), for completion at the Checkout Station. No payment is claimed by this handoff."
    }
  },
  "required": [
    "sale_id",
    "item_name",
    "offer_amount",
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.user_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}