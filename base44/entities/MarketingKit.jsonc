{
  "name": "MarketingKit",
  "type": "object",
  "description": "Chapter 7 P2 \u2014 per-sale MARKETING KIT orchestration record. The kit is PREPARATION, never publication: it coordinates existing marketing surfaces (sale page, social, email, SMS, QR, printable signs, featured merchandise) around ONE canonical source of truth (Company identity, EstateSale, Items, OperatorService). Drafts are generated from verified records only and always remain DRAFT until the operator acts \u2014 every publish/send still happens through its own existing system. PHOTO APPROVAL: the smallest useful marketing-approval state lives here as approved_photo_indexes \u2014 kit content uses ONLY explicitly approved sale photos (Chapter 6 sensitive-material guardrails respected; nothing is assumed public-safe). Publication statuses of existing systems (SocialPost, campaigns, sale page) are read LIVE from those systems \u2014 never duplicated here.",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "EstateSale this kit belongs to. One kit per sale."
    },
    "operator_id": {
      "type": "string",
      "description": "EstateSale.operator_id projection \u2014 sale owner (RLS anchor). Derived from the sale."
    },
    "company_id": {
      "type": "string",
      "description": "EstateSale.company_id projection when present."
    },
    "sale_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "READ-SCOPE PROJECTION of EstateSale.sale_team for RLS. The sale remains the source of truth."
    },
    "approved_photo_indexes": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": [],
      "description": "Indexes into EstateSale.images explicitly APPROVED FOR MARKETING by the operator. The smallest useful approval state \u2014 no image is marketing-eligible by default. Photos marked skip/do-not-search are never approvable."
    },
    "sale_description": {
      "type": "string",
      "description": "Coordinated sale description draft (AI-assisted, brand-truth validated, operator-editable). DRAFT \u2014 publishing happens through the sale's own description/publication surfaces."
    },
    "social_posts": {
      "type": "array",
      "default": [],
      "description": "Coordinated social post drafts derived from canonical sale facts. DRAFTS ONLY \u2014 publishing goes through the existing social systems.",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "facebook",
              "instagram",
              "nextdoor",
              "email_list",
              "other"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "email_draft": {
      "type": "object",
      "description": "Email campaign draft (subject + body) derived from canonical facts. Sending happens ONLY through the existing campaign system with its own consent rules.",
      "properties": {
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "default": {}
    },
    "sms_draft": {
      "type": "string",
      "description": "SMS content DRAFT. SMS SENDING IS NOT AVAILABLE PRE-LAUNCH \u2014 this is content preparation only; the kit never sends and never implies send capability."
    },
    "qr_url": {
      "type": "string",
      "description": "Canonical public destination the kit's QR code points at (the sale's public page on EstateSalen). Deterministic \u2014 derived from the sale, never invented."
    },
    "component_status": {
      "type": "object",
      "default": {},
      "description": "Per-component PREPARATION state of the kit: not_created | draft | ready. This tracks kit preparation only \u2014 publication states live in their own systems (SocialPost, campaigns, sale page) and are read live.",
      "properties": {
        "description": {
          "type": "string",
          "enum": [
            "not_created",
            "draft",
            "ready"
          ]
        },
        "social": {
          "type": "string",
          "enum": [
            "not_created",
            "draft",
            "ready"
          ]
        },
        "email": {
          "type": "string",
          "enum": [
            "not_created",
            "draft",
            "ready"
          ]
        },
        "sms": {
          "type": "string",
          "enum": [
            "not_created",
            "draft",
            "ready"
          ]
        },
        "qr": {
          "type": "string",
          "enum": [
            "not_created",
            "draft",
            "ready"
          ]
        },
        "signs": {
          "type": "string",
          "enum": [
            "not_created",
            "draft",
            "ready"
          ]
        },
        "featured": {
          "type": "string",
          "enum": [
            "not_created",
            "draft",
            "ready"
          ]
        }
      }
    },
    "ai_removals": {
      "type": "array",
      "default": [],
      "description": "Transparency ledger: unsupported claims the shared brand-truth guardrail removed from AI drafts. Kept visible to the operator \u2014 never silently dropped.",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "sale_id",
    "operator_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}