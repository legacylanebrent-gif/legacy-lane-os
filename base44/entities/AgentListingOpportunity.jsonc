{
  "name": "AgentListingOpportunity",
  "type": "object",
  "description": "An importing agent's PRIVATE CRM relationship to one canonical Property, plus its property-service opportunity and the traceable PropStream ownership evidence. One record per (agent_user_id, property_id). This is a relationship record, NOT a competing property database: the canonical property stays in Property, the CRM pipeline record stays in Opportunity, referrals stay in AgentListingPoolSubmission. A pending listing is NEVER evidence that the seller needs a service. Reference ownership is 'owner of record' as of the source date and is never proof of who the seller, occupant, executor or authorized decision-maker is. Agents read only their own records; every write happens through sanctioned server functions (admin-only record writes).",
  "properties": {
    "agent_user_id": {
      "type": "string",
      "description": "Authenticated importing agent (server-derived). Access anchor."
    },
    "agent_name": {
      "type": "string"
    },
    "property_id": {
      "type": "string",
      "description": "Canonical Property id."
    },
    "match_key": {
      "type": "string",
      "description": "Top-level normalized address key (street|unit~city~state~zip). Lets a second agent reuse the SAME canonical Property without ever reading the other agent's records."
    },
    "crm_opportunity_id": {
      "type": "string",
      "description": "The agent's existing generic CRM Opportunity record for this property."
    },
    "import_id": {
      "type": "string",
      "description": "Import that first created this opportunity."
    },
    "last_import_id": {
      "type": "string"
    },
    "address": {
      "type": "object",
      "default": {},
      "properties": {
        "street": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "formatted_address": {
          "type": "string"
        }
      }
    },
    "listing": {
      "type": "object",
      "default": {},
      "description": "Listing snapshot from the source export (latest known values).",
      "properties": {
        "listing_id": {
          "type": "string"
        },
        "listing_source": {
          "type": "string"
        },
        "listing_status_raw": {
          "type": "string"
        },
        "listing_status_mapped": {
          "type": "string",
          "enum": [
            "pending",
            "under_contract",
            "active",
            "sold",
            "withdrawn",
            "unknown"
          ]
        },
        "status_review_required": {
          "type": "boolean",
          "default": false,
          "description": "True when the source status was not confidently mapped; never silently treated as pending."
        },
        "pending_date": {
          "type": "string",
          "format": "date"
        },
        "expected_closing_date": {
          "type": "string",
          "format": "date"
        },
        "county": {
          "type": "string"
        },
        "parcel_id": {
          "type": "string"
        },
        "listing_agent_name": {
          "type": "string"
        },
        "listing_agent_email": {
          "type": "string"
        },
        "listing_agent_phone": {
          "type": "string"
        },
        "brokerage": {
          "type": "string"
        },
        "seller_name_provided": {
          "type": "string",
          "description": "Seller information supplied by the importing agent (not verified)."
        },
        "seller_contact_provided": {
          "type": "string"
        },
        "list_price": {
          "type": "number"
        },
        "source_date": {
          "type": "string",
          "format": "date"
        },
        "imported_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ownership": {
      "type": "object",
      "default": {},
      "description": "Traceable ownership evidence from the stored PropStream reference database. Only fields the admin permits are returned to agents. Owner mailing address is kept separate from the property address.",
      "properties": {
        "match_status": {
          "type": "string",
          "enum": [
            "unmatched",
            "verified",
            "possible",
            "no_match",
            "reference_unavailable",
            "failed"
          ],
          "default": "unmatched"
        },
        "review_status": {
          "type": "string",
          "enum": [
            "none",
            "pending",
            "confirmed",
            "rejected"
          ],
          "default": "none"
        },
        "owner_of_record": {
          "type": "string"
        },
        "co_owner_of_record": {
          "type": "string",
          "description": "Additional owner of record on the matched reference record, when supplied. Kept separate from the primary owner; never merged into one name."
        },
        "ownership_type": {
          "type": "string",
          "enum": [
            "individual",
            "trust",
            "company",
            "unknown"
          ]
        },
        "owner_mailing_address": {
          "type": "string"
        },
        "owner_mailing_city": {
          "type": "string"
        },
        "owner_mailing_state": {
          "type": "string"
        },
        "owner_mailing_zip": {
          "type": "string"
        },
        "parcel_id": {
          "type": "string"
        },
        "characteristics": {
          "type": "object",
          "default": {}
        },
        "source": {
          "type": "string"
        },
        "source_record_id": {
          "type": "string"
        },
        "source_date": {
          "type": "string",
          "format": "date"
        },
        "matched_at": {
          "type": "string",
          "format": "date-time"
        },
        "matching_version": {
          "type": "string"
        },
        "rule_used": {
          "type": "string"
        },
        "confidence_basis": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "candidates": {
          "type": "array",
          "default": [],
          "description": "Redacted candidate evidence for 'possible match - review required'.",
          "items": {
            "type": "object"
          }
        },
        "conflict_note": {
          "type": "string",
          "description": "Set when newer reference evidence conflicts with an agent-confirmed match; surfaced for review, never silently overwritten."
        },
        "agent_verified_owner": {
          "type": "string",
          "description": "Owner information the agent confirmed independently. Never overwritten by reference data."
        },
        "agent_verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "resolved_by_name": {
          "type": "string"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "contacts": {
      "type": "array",
      "default": [],
      "description": "Owner contact values attached ONLY from the matched reference record for a verified or admin-confirmed ownership association. One entry per distinct phone/email value. Nothing is invented, borrowed from another household member, or attached from an ambiguous match. Each value keeps its own source, source date, verification and restrictions, plus the agent's own mark; marks survive every refresh and a rejected value is never restored as usable. Provider contact details stay UNVERIFIED: a verified property match never verifies a phone number or email.",
      "items": {
        "type": "object",
        "properties": {
          "contact_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "email",
              "phone"
            ]
          },
          "value": {
            "type": "string",
            "description": "Normalized value used for dedupe and export (lowercase email, digits with country code for phone)."
          },
          "value_display": {
            "type": "string",
            "description": "Value as shown to the agent."
          },
          "owner_name": {
            "type": "string",
            "description": "Owner or co-owner of record this value is associated with."
          },
          "phone_type": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "source_record_id": {
            "type": "string"
          },
          "source_date": {
            "type": "string"
          },
          "verification": {
            "type": "string",
            "enum": [
              "unverified",
              "provider_reported"
            ],
            "default": "unverified"
          },
          "restrictions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Known source-use restrictions (dnc_listed, do_not_mail, ...)."
          },
          "agent_status": {
            "type": "string",
            "enum": [
              "none",
              "confirmed",
              "incorrect",
              "disconnected",
              "not_owner"
            ],
            "default": "none",
            "description": "The importing agent's own mark. Identity evidence only \u2014 never advertising permission."
          },
          "agent_status_by_name": {
            "type": "string"
          },
          "agent_status_at": {
            "type": "string",
            "format": "date-time"
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "property_facts": {
      "type": "object",
      "default": {},
      "description": "Explicit allowlist of facts about the SUBJECT property from the matched reference record. Never the owner's mailing address, never demographics, health or financial fields.",
      "properties": {
        "county": {
          "type": "string"
        },
        "parcel_id": {
          "type": "string"
        },
        "property_type": {
          "type": "string"
        },
        "beds": {
          "type": "number"
        },
        "baths": {
          "type": "number"
        },
        "building_sqft": {
          "type": "number"
        },
        "lot_size": {
          "type": "string"
        },
        "year_built": {
          "type": "number"
        },
        "listing_status": {
          "type": "string"
        },
        "list_date": {
          "type": "string"
        },
        "days_on_market": {
          "type": "number"
        },
        "last_sale_date": {
          "type": "string"
        }
      }
    },
    "enrichment": {
      "type": "object",
      "default": {},
      "description": "Owner/property enrichment status. Written only by the sanctioned enrichment function. Enrichment never rewrites ownership evidence or an admin confirmation \u2014 a disagreement is surfaced as a review flag instead.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "never",
            "enriched",
            "current",
            "partial",
            "review_required",
            "no_reference",
            "failed"
          ],
          "default": "never"
        },
        "last_enriched_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "source_date": {
          "type": "string"
        },
        "reference_record_id": {
          "type": "string"
        },
        "added_count": {
          "type": "integer",
          "default": 0
        },
        "unchanged_count": {
          "type": "integer",
          "default": 0
        },
        "unavailable_count": {
          "type": "integer",
          "default": 0
        },
        "message": {
          "type": "string"
        },
        "conflict_note": {
          "type": "string",
          "description": "Set when the reference record now disagrees with stored/confirmed ownership evidence. Review flag only \u2014 never replaces confirmed data."
        },
        "job_id": {
          "type": "string"
        }
      }
    },
    "advertising_permission": {
      "type": "object",
      "default": {},
      "description": "Documented permission evidence for customer-list advertising about this owner. Contact visibility, ownership matching, pending status and CRM presence never imply it. Requires a stated basis and a reference to the evidence \u2014 a bare checkbox is not evidence.",
      "properties": {
        "granted": {
          "type": "boolean",
          "default": false
        },
        "basis": {
          "type": "string",
          "enum": [
            "owner_written_permission",
            "signed_agreement_advertising_clause",
            "platform_opt_in",
            "other_documented"
          ]
        },
        "reference": {
          "type": "string",
          "description": "Where the evidence lives (agreement section, dated email, recorded call note)."
        },
        "scope_note": {
          "type": "string"
        },
        "captured_by_name": {
          "type": "string"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ai_match_hint": {
      "type": "object",
      "default": {},
      "description": "AI interpretation of SUPPLIED candidates only. Never invents an owner, contact, parcel or result; never on its own approves ownership.",
      "properties": {
        "summary": {
          "type": "string"
        },
        "recommended_candidate_id": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "service_need": {
      "type": "string",
      "enum": [
        "unknown",
        "full_estate_sale",
        "furniture_sale",
        "buyout",
        "donation",
        "cleanout",
        "unsure",
        "none"
      ],
      "default": "unknown",
      "description": "Agent-recorded service need. Unknown until the agent (or the seller/representative) confirms it."
    },
    "service_need_note": {
      "type": "string"
    },
    "service_need_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Confirmed service deadline (move-out/closing) driving the next action."
    },
    "next_action": {
      "type": "string"
    },
    "next_action_due": {
      "type": "string",
      "format": "date"
    },
    "tasks": {
      "type": "array",
      "default": [],
      "description": "Follow-up tasks inside this opportunity record (no competing task system).",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "done"
            ],
            "default": "open"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by_name": {
            "type": "string"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "ai_next_step": {
      "type": "object",
      "default": {},
      "properties": {
        "summary": {
          "type": "string"
        },
        "missing_info": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "recommended_action": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "outreach_draft": {
      "type": "object",
      "default": {},
      "description": "Draft only. Sending stays in the existing authorized, consent-checked sending workflow.",
      "properties": {
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved"
          ],
          "default": "draft"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "service_request_id": {
      "type": "string",
      "description": "AgentListingPoolSubmission created when the seller/representative authorized sharing."
    },
    "service_request_status": {
      "type": "string"
    },
    "dismissed": {
      "type": "boolean",
      "default": false
    },
    "dismissed_at": {
      "type": "string",
      "format": "date-time"
    },
    "handled": {
      "type": "boolean",
      "default": false
    },
    "handled_at": {
      "type": "string",
      "format": "date-time"
    },
    "handled_note": {
      "type": "string"
    },
    "correction_count": {
      "type": "integer",
      "default": 0
    },
    "last_corrected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "agent_user_id",
    "property_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.agent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}