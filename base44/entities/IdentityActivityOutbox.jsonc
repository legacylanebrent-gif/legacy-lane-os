{
  "name": "IdentityActivityOutbox",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Idempotency key sent to Houszu \u2014 stable across retries; never regenerated"
    },
    "contract_version": {
      "type": "string",
      "default": "1.6.0",
      "description": "Houszu Partner API contract version the payload was built for"
    },
    "source_app": {
      "type": "string",
      "default": "estatesalen",
      "description": "Canonical source app identifier"
    },
    "masterUserID": {
      "type": "string",
      "description": "Canonical Houszu masterUserID (lowercase, mu_ prefix)"
    },
    "localUserID": {
      "type": "string",
      "description": "EstateSalen local user ID"
    },
    "event_type": {
      "type": "string",
      "description": "Activity type, e.g. consumer_signup, profile_sync, vip_signup, seller_inquiry, lead_scored, sale_created"
    },
    "identity_context": {
      "type": "object",
      "description": "Canonical identity inputs (email, names, phone) required by the frozen contract"
    },
    "product_context": {
      "type": "object",
      "description": "Product/relationship context (product_id, relationship_type)"
    },
    "agent_context": {
      "type": "object",
      "description": "Agent attribution \u2014 present ONLY when legitimately established; never guessed"
    },
    "territory_context": {
      "type": "object",
      "description": "Canonical territory context \u2014 present ONLY when legitimately resolved"
    },
    "consent_context": {
      "type": "object",
      "description": "Consent evidence captured at the time of the action (never reconstructed later)"
    },
    "payload": {
      "type": "object",
      "description": "Activity payload sent to the Houszu v1.6.0 ingestion gateway"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the activity happened"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sending",
        "sent",
        "retrying",
        "dead_letter"
      ],
      "default": "pending",
      "description": "Delivery state"
    },
    "attempts": {
      "type": "integer",
      "default": 0,
      "description": "Delivery attempts so far"
    },
    "last_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string",
      "description": "Last delivery error (sanitized)"
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time",
      "description": "Earliest time the flusher should retry this event"
    },
    "claim_token": {
      "type": "string",
      "description": "Worker claim token \u2014 prevents overlapping hourly workers from sending the same record"
    },
    "claimed_until": {
      "type": "string",
      "format": "date-time",
      "description": "Claim lease expiry \u2014 expired claims are reclaimable"
    }
  },
  "required": [
    "event_type",
    "payload"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}