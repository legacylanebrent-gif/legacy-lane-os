{
  "name": "EarlySignIn",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "EstateSale ID"
    },
    "operator_id": {
      "type": "string",
      "description": "EstateSale.operator_id projection \u2014 sale owner (RLS anchor). Derived from the sale at creation."
    },
    "sale_title": {
      "type": "string",
      "description": "Cached sale title"
    },
    "sale_date": {
      "type": "string",
      "description": "ISO date (YYYY-MM-DD) for which day the user signed up"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user who signed"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the user who signed"
    },
    "user_id": {
      "type": "string",
      "description": "Chapter 5 P1 \u2014 canonical platform User ID of the signer when authenticated. The historical name/email fields remain for display; user_id is the join key for buyer history. Null is legitimate for genuinely anonymous guest flows."
    },
    "signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user signed"
    },
    "discovery_source": {
      "type": "string",
      "enum": [
        "estate_sale_listing_site",
        "email",
        "sms",
        "facebook",
        "instagram",
        "other_social",
        "sign",
        "qr",
        "referral",
        "walk_by",
        "other",
        "unknown"
      ],
      "default": "unknown",
      "description": "Chapter 18 P1-36/P1-37 \u2014 how this attendee says they found THIS sale: an EXPLICIT attendee response only (deterministic evidence). Campaign causality is NEVER inferred from timing. unknown is honest and valid \u2014 never substituted with an assumption."
    }
  },
  "required": [
    "sale_id",
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.user_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.user_email": "{{user.email}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}