{
  "name": "CleanoutVendorProfile",
  "type": "object",
  "description": "Chapter 22 P0-1 \u2014 DIRECTORY-SAFE public provider profile for the cleanout network (business name, contact, services, territory): deliberately readable as a public provider directory. PRIVATE company operational information (assignments, quotes, seller identity, property addresses of active projects, access notes, performance notes) lives on operator-anchored records and is never exposed here. Writes are restricted to the profile's own vendor user and platform admins.",
  "properties": {
    "business_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "service_radius": {
      "type": "number",
      "description": "Miles radius from base"
    },
    "service_states": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "territory_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "whole_house",
          "partial_house",
          "garage",
          "attic",
          "basement",
          "storage_unit",
          "hoarding",
          "estate_cleanout",
          "foreclosure",
          "rental_property"
        ]
      },
      "default": []
    },
    "lead_notifications_enabled": {
      "type": "boolean",
      "default": false
    },
    "membership_status": {
      "type": "string",
      "enum": [
        "free",
        "network_member",
        "suspended"
      ],
      "default": "free"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "trial",
        "expired",
        "cancelled"
      ],
      "default": "none"
    },
    "user_id": {
      "type": "string",
      "description": "Platform user ID of the vendor who owns this profile (write anchor)."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "business_name",
    "contact_name",
    "email"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.user_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}