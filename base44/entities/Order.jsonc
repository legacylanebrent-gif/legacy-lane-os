{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "item_title": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "price": {
            "type": "number"
          },
          "seller_id": {
            "type": "string"
          },
          "seller_name": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "sale_id": {
      "type": "string",
      "description": "Chapter 21 P1 \u2014 the EstateSale this Order belongs to (set at POS/marketplace checkout). Per-sale money truth groups through this link; legacy orders created before Chapter 21 lack it and are matched by item overlap only."
    },
    "provider_order_id": {
      "type": "string",
      "description": "Chapter 21 P0-2 \u2014 the PROVIDER's order reference for online payments, copied from the APPROVED PaymentAttempt at completion. Permanent financial evidence for investigation/dispute; never a transient payload dependency."
    },
    "subtotal": {
      "type": "number"
    },
    "shipping_cost": {
      "type": "number",
      "default": 0
    },
    "platform_fee": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "processing",
        "shipped",
        "delivered",
        "completed",
        "cancelled",
        "disputed"
      ],
      "default": "pending_payment",
      "description": "Chapter 21 doctrine: for POS sales, 'paid' is written ONLY when money is confirmed (provider webhook for online; the cashier's completed offline tender). pending_payment/processing are never paid."
    },
    "payment_method": {
      "type": "string"
    },
    "pending_checkout_id": {
      "type": "string",
      "description": "Wix checkout session ID when online payment is in progress. LEGACY/convenience pointer only \u2014 Chapter 21 canonical attempt truth lives on PaymentAttempt; webhook resolution never depends solely on this mutable field."
    },
    "escrow_status": {
      "type": "string",
      "enum": [
        "held",
        "released",
        "refunded"
      ],
      "default": "held"
    },
    "shipping_address": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "fulfillment_method": {
      "type": "string",
      "enum": [
        "shipping",
        "pickup",
        "digital"
      ],
      "default": "shipping"
    },
    "pickup_details": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string"
        },
        "scheduled_date": {
          "type": "string",
          "format": "date-time"
        },
        "instructions": {
          "type": "string"
        }
      }
    },
    "tracking_number": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "buyer_id",
    "items",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.items": {
            "$elemMatch": {
              "seller_id": "{{user.id}}"
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}