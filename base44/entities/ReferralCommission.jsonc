{
  "name": "ReferralCommission",
  "type": "object",
  "description": "Legacy referral exchange commission record. Referral Rebuild Phase 1 adds the 'recorded' status: an INFORMATIONAL closing record created by the Houszu closed-deal callback while legacy compensation is paused \u2014 it preserves closing information and creates NO monetary entitlement (no wallet credit, nothing payable). The deal's agent and operator may read their own records; all writes are admin-only / service-role.",
  "properties": {
    "commission_id": {
      "type": "string",
      "description": "Unique commission identifier"
    },
    "deal_id": {
      "type": "string",
      "description": "Reference to the ReferralDealAgreement"
    },
    "property_address": {
      "type": "string",
      "description": "Full property address"
    },
    "agent_id": {
      "type": "string",
      "description": "User ID of the real estate agent"
    },
    "operator_id": {
      "type": "string",
      "description": "User ID of the Estate Sale Company Owner"
    },
    "referral_agent_name": {
      "type": "string",
      "description": "Name of the designated referral agent"
    },
    "estimated_sale_price": {
      "type": "number",
      "description": "Estimated sale price (in cents)"
    },
    "estimated_commission": {
      "type": "number",
      "description": "Estimated total real estate commission (in cents)"
    },
    "referral_percentage": {
      "type": "number",
      "description": "Estate Sale Company Owner's referral percentage of the commission (e.g., 25 for 25%)"
    },
    "expected_referral_fee": {
      "type": "number",
      "description": "Expected referral fee to Estate Sale Company Owner based on estimates (in cents)"
    },
    "actual_sale_price": {
      "type": "number",
      "description": "Actual final sale price (in cents)"
    },
    "actual_commission": {
      "type": "number",
      "description": "Actual total real estate commission earned (in cents)"
    },
    "actual_referral_fee": {
      "type": "number",
      "description": "Actual referral fee paid to Estate Sale Company Owner (in cents)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "paid",
        "recorded"
      ],
      "default": "pending",
      "description": "Commission payment status. 'recorded' = informational closing record only \u2014 NO compensation entitlement (Referral Rebuild Phase 1)."
    },
    "closing_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date when the transaction closed"
    },
    "notes": {
      "type": "string",
      "description": "Context for informational 'recorded' entries (provenance, paused-program note)."
    }
  },
  "required": [
    "commission_id",
    "deal_id",
    "property_address",
    "agent_id",
    "operator_id",
    "referral_agent_name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.agent_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}