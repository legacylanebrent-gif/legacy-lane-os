{
  "name": "LaborEntry",
  "type": "object",
  "description": "Chapter 4 P1 \u2014 canonical labor-hour entry for a sale. An OPERATIONAL dimension (hours worked), NOT an expense line: cash labor cost is always DERIVED (hours x rate for paid/non-owner entries), never stored here. Owner time is tracked as hours only and is never silently counted as cash cost. Distinct from Expense (a cost line) by design \u2014 do not merge them. Chapter 6 P1 adds team_member_id so entries from the operator's worker directory keep a consistent worker identity; the entry's hourly_rate remains a snapshot that never changes when a TeamMember's default rate changes later. Chapter 14 P1 adds the optional prep-zone reference (prep_zone_id/prep_zone_name snapshot) and extends the work_category vocabulary with prep activities (sorting, cleaning, pricing, photography, moving) \u2014 additive only; existing records and Chapter 4 economics are unchanged. Chapter 15 P1-58 adds inventory and measurement categories for progressive-inventory work \u2014 additive only; no per-Item time tracking is required for ordinary merchandise. Chapter 17 P1-41 adds the sale-floor staging categories (grouping, lighting, signage, sale_floor_maintenance) \u2014 additive only; LaborEntry remains the ONE labor record and projected-vs-actual comparison is unchanged.",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "EstateSale this labor entry belongs to."
    },
    "operator_id": {
      "type": "string",
      "description": "EstateSale.operator_id projection \u2014 sale owner (RLS anchor). Derived from the sale at creation."
    },
    "sale_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "READ-SCOPE PROJECTION of EstateSale.sale_team for RLS. The sale remains the source of truth."
    },
    "user_id": {
      "type": "string",
      "description": "Platform user ID of the worker when they are a platform team member. Null for the owner or a named helper."
    },
    "team_member_id": {
      "type": "string",
      "description": "Chapter 6 P1 \u2014 canonical TeamMember ID when the worker comes from the operator's worker directory. Gives consistent worker identity across name changes; member_name/user_id remain independent snapshots. LaborEntry stays the canonical project labor record."
    },
    "member_name": {
      "type": "string",
      "description": "Display name of the worker (owner, team member, or non-platform helper)."
    },
    "work_category": {
      "type": "string",
      "enum": [
        "preparation",
        "inventory",
        "sorting",
        "cleaning",
        "research",
        "pricing",
        "staging",
        "grouping",
        "lighting",
        "signage",
        "photography",
        "measurement",
        "moving",
        "sale_day",
        "sale_floor_maintenance",
        "pickup",
        "closeout",
        "travel",
        "other"
      ],
      "description": "What kind of work the hours were spent on. Chapter 14 P1-45 added prep activities additively; Chapter 15 P1-58 adds inventory and measurement for progressive-inventory work. Chapter 17 P1-41 adds grouping/lighting/signage/sale_floor_maintenance for staging and sale-floor work \u2014 existing records keep their original category and Chapter 4 economics never change."
    },
    "prep_zone_id": {
      "type": "string",
      "description": "Chapter 14 P1-44 \u2014 optional prep zone (EstateSale.prep_zones zone_id) the hours were spent in. Null = not zone-specific."
    },
    "prep_zone_name": {
      "type": "string",
      "description": "Zone-name snapshot at entry time (the zone may be renamed later; the entry keeps what was true)."
    },
    "entry_date": {
      "type": "string",
      "format": "date",
      "description": "The date the work happened."
    },
    "hours": {
      "type": "number",
      "description": "Decimal hours worked."
    },
    "hourly_rate": {
      "type": "number",
      "description": "Hourly cash wage for paid labor. Null for owner time or unpaid help \u2014 cash cost is derived only when both hours and rate exist. SNAPSHOT at entry creation: never silently changed when a TeamMember default rate changes later."
    },
    "is_owner_time": {
      "type": "boolean",
      "default": false,
      "description": "Owner's own time. Reported as an ECONOMIC resource in hours \u2014 never included in cash labor cost."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "sale_id",
    "work_category",
    "entry_date",
    "hours"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}