{
  "name": "WalletTransaction",
  "type": "object",
  "description": "Legacy referral-program wallet ledger. Referral Rebuild Phase 1: operators may READ their own transactions only; creation and all mutations are admin-only (backend functions operate as service role with explicit authorization). Existing transactions are preserved.",
  "properties": {
    "transaction_id": {
      "type": "string",
      "description": "Unique transaction identifier"
    },
    "operator_id": {
      "type": "string",
      "description": "User ID of the Estate Sale Company Owner"
    },
    "deal_id": {
      "type": "string",
      "description": "Reference to Houszu deal (if applicable)"
    },
    "property_address": {
      "type": "string",
      "description": "Property address associated with transaction"
    },
    "type": {
      "type": "string",
      "enum": [
        "credit",
        "adjustment",
        "withdrawal",
        "hold",
        "clawback"
      ],
      "description": "Type of wallet transaction"
    },
    "amount": {
      "type": "number",
      "description": "Transaction amount in cents"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "available",
        "completed",
        "hold",
        "rejected"
      ],
      "default": "pending",
      "description": "Current status of the transaction"
    },
    "description": {
      "type": "string",
      "description": "Transaction description or notes"
    },
    "available_after": {
      "type": "string",
      "format": "date-time",
      "description": "When credits become available (hold release date)"
    }
  },
  "required": [
    "transaction_id",
    "operator_id",
    "type",
    "amount",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}