{
  "name": "Expense",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "Estate sale ID"
    },
    "operator_id": {
      "type": "string",
      "description": "EstateSale.operator_id projection \u2014 sale owner (RLS anchor). Derived from the sale at creation."
    },
    "sale_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "READ-SCOPE PROJECTION of EstateSale.sale_team for RLS. The sale remains the source of truth."
    },
    "category": {
      "type": "string",
      "enum": [
        "advertising_marketing",
        "cleaning_services",
        "dumpster_disposal",
        "equipment_rental",
        "insurance",
        "labor_wages",
        "meals_entertainment",
        "permits_licenses",
        "photography",
        "processing_fees",
        "professional_services",
        "security",
        "signage_banners",
        "staging_setup",
        "supplies_materials",
        "transportation_fuel",
        "utilities",
        "other"
      ],
      "description": "Expense category. Sale-scoped DIRECT sale cost (advertising, supplies, transport, processing, labor wages where hours are not tracked in LaborEntry, outside/professional services, other). Company OVERHEAD belongs on BusinessExpense, not here. processing_fees = Chapter 4 P1 card/POS processing costs for this sale."
    },
    "amount": {
      "type": "number",
      "description": "Expense amount"
    },
    "vendor": {
      "type": "string",
      "description": "Vendor name"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Expense date"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "credit_card",
        "debit_card",
        "check",
        "company_card"
      ],
      "default": "credit_card",
      "description": "Payment method"
    },
    "description": {
      "type": "string",
      "description": "Expense description"
    },
    "receipt_url": {
      "type": "string",
      "description": "Receipt image (private storage URI; view via signed URL)"
    },
    "is_reimbursable": {
      "type": "boolean",
      "default": false,
      "description": "Whether expense is reimbursable"
    }
  },
  "required": [
    "sale_id",
    "category",
    "amount",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.sale_team_ids": {
                "$in": [
                  "{{user.id}}"
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}