{
  "name": "Company",
  "type": "object",
  "properties": {
    "legal_name": {
      "type": "string",
      "description": "Legal business name (e.g. Legacy Lane Estates LLC). Renaming this never changes the Company ID."
    },
    "display_name": {
      "type": "string",
      "description": "Public display name / DBA (e.g. Legacy Lane). Independent of the Company ID."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending",
        "suspended"
      ],
      "default": "active",
      "description": "Company lifecycle state"
    },
    "primary_contact_user_id": {
      "type": "string",
      "description": "EstateSalen User ID of the company's primary owner/operator contact"
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "EstateSalen User IDs mapped to this company (operators, admins, staff). Additive \u2014 existing user ownership fields are untouched."
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "logo_url": {
      "type": "string",
      "description": "Company logo media reference"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "service_area_notes": {
      "type": "string",
      "description": "Free-text service area metadata (structured territories live in OperatorTerritoryProfile)"
    },
    "inventory_rules": {
      "type": "array",
      "default": [],
      "description": "Chapter 15 P1-9 \u2014 operator-defined deterministic GUIDANCE for inventory depth (category/price-based suggestions shown at item creation). GUIDELINES ONLY: the human operator always chooses the actual level; nothing is automatic truth and no rule implies value alone (P1-2/P1-74).",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "Optional Item category the rule applies to."
          },
          "min_price": {
            "type": "number",
            "description": "Optional price floor for the suggestion."
          },
          "max_price": {
            "type": "number",
            "description": "Optional price ceiling for the suggestion."
          },
          "suggested_level": {
            "type": "string",
            "enum": [
              "QUICK",
              "STANDARD",
              "RESEARCH",
              "HIGH_VALUE"
            ]
          },
          "note": {
            "type": "string",
            "description": "Why the operator suggests this depth \u2014 shown to the employee as guidance."
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "legal_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.id}}"
        },
        {
          "data.primary_contact_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.primary_contact_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}