{
  "name": "MasterOperatorDirectory",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Primary company name (richest source wins)"
    },
    "phone": {
      "type": "string",
      "description": "Display phone number (raw, richest source wins)"
    },
    "phone_normalized": {
      "type": "string",
      "description": "Digits-only normalized phone used as the primary cross-source dedup key"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "geocoded_address": {
      "type": "string"
    },
    "geocoded_city": {
      "type": "string"
    },
    "geocoded_county": {
      "type": "string"
    },
    "geocoded_zip": {
      "type": "string"
    },
    "geocode_status": {
      "type": "string",
      "enum": [
        "not_geocoded",
        "geocoded",
        "failed",
        "skipped"
      ],
      "default": "not_geocoded"
    },
    "geocode_last_run": {
      "type": "string",
      "format": "date-time"
    },
    "facebook": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "twitter": {
      "type": "string",
      "description": "Twitter profile URL (from FutureEstateOperator)"
    },
    "youtube": {
      "type": "string",
      "description": "YouTube channel URL (from FutureEstateOperator)"
    },
    "pinterest": {
      "type": "string",
      "description": "Pinterest profile URL (from FutureEstateOperator)"
    },
    "about_text": {
      "type": "string"
    },
    "services_offered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "memberships": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "service_area_cities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "membership_tier": {
      "type": "string",
      "enum": [
        "elite",
        "platinum",
        "basic",
        "unknown"
      ],
      "default": "unknown"
    },
    "member_since": {
      "type": "string"
    },
    "years_in_business": {
      "type": "number"
    },
    "sales_posted": {
      "type": "number"
    },
    "active_sales_count": {
      "type": "number"
    },
    "bonded_insured": {
      "type": "boolean",
      "default": false
    },
    "award_winner": {
      "type": "boolean",
      "default": false
    },
    "logo_image_url": {
      "type": "string"
    },
    "profile_url": {
      "type": "string",
      "description": "Estatesales.org profile URL"
    },
    "company_id": {
      "type": "string",
      "description": "Estatesales.org company ID"
    },
    "source_url": {
      "type": "string",
      "description": "Estatesales.net profile URL (from FutureEstateOperator)"
    },
    "package_type": {
      "type": "string",
      "description": "Estatesales.net package/plan type (from FutureEstateOperator)"
    },
    "alternate_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Additional emails found during enrichment (from FutureEstateOperator)"
    },
    "email_confidence_score": {
      "type": "number",
      "description": "Email enrichment confidence 0-100 (from FutureEstateOperator)"
    },
    "email_verified_status": {
      "type": "string",
      "description": "Email verification result (from FutureEstateOperator)"
    },
    "email_source_type": {
      "type": "string",
      "description": "Where the email was found (from FutureEstateOperator)"
    },
    "email_source_url": {
      "type": "string",
      "description": "Page the email was found on (from FutureEstateOperator)"
    },
    "email_last_checked": {
      "type": "string",
      "format": "date-time",
      "description": "Last email enrichment/verification check (from FutureEstateOperator)"
    },
    "enrichment_notes": {
      "type": "string",
      "description": "Notes from email enrichment runs (from FutureEstateOperator)"
    },
    "do_not_contact": {
      "type": "boolean",
      "default": false,
      "description": "Outreach compliance flag (from FutureEstateOperator)"
    },
    "unsubscribe_status": {
      "type": "string",
      "description": "Email unsubscribe state (from FutureEstateOperator)"
    },
    "outreach_status": {
      "type": "string",
      "description": "Outreach pipeline state (from FutureEstateOperator)"
    },
    "lead_access_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this operator receives lead opportunities (from FutureEstateOperator)"
    },
    "claim_status": {
      "type": "string",
      "description": "Claim pipeline state: pending, verified, rejected (from FutureEstateOperator)"
    },
    "claim_verification_status": {
      "type": "string",
      "description": "Claim verification stage (from FutureEstateOperator)"
    },
    "claimed_listing": {
      "type": "boolean",
      "default": false,
      "description": "Whether this listing has been claimed (from FutureEstateOperator)"
    },
    "claimed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the listing was claimed (from FutureEstateOperator)"
    },
    "claim_contact_name": {
      "type": "string",
      "description": "Name of the person who submitted the claim (from FutureEstateOperator)"
    },
    "claim_contact_email": {
      "type": "string",
      "description": "Email of the claim submitter (from FutureEstateOperator)"
    },
    "claim_contact_phone": {
      "type": "string",
      "description": "Phone of the claim submitter (from FutureEstateOperator)"
    },
    "claim_notes": {
      "type": "string",
      "description": "Notes from the claim submission (from FutureEstateOperator)"
    },
    "free_trial_started": {
      "type": "boolean",
      "default": false,
      "description": "Whether a free trial was started via claim (from FutureEstateOperator)"
    },
    "free_trial_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Free trial start date (from FutureEstateOperator)"
    },
    "free_trial_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Free trial end date (from FutureEstateOperator)"
    },
    "has_facebook": {
      "type": "boolean",
      "default": false,
      "description": "ES.org flag that the company has a Facebook page (from EstatesalesOrgOperator)"
    },
    "last_scraped_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last scrape timestamp (from EstatesalesOrgOperator)"
    },
    "scrape_status": {
      "type": "string",
      "description": "Scrape result status (from EstatesalesOrgOperator)"
    },
    "dedup_key": {
      "type": "string",
      "description": "Lead deduplication key (from FutureOperatorLead)"
    },
    "source_id": {
      "type": "string",
      "description": "Original source identifier (from FutureOperatorLead)"
    },
    "process_status": {
      "type": "string",
      "description": "Lead processing status (from FutureOperatorLead)"
    },
    "lead_source": {
      "type": "string",
      "description": "Where this lead originated (from FutureOperatorLead source)"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "free_lead_access",
        "free_trial",
        "active",
        "expired",
        "cancelled"
      ],
      "default": "none",
      "description": "Best subscription status across merged source records (from FutureEstateOperator)"
    },
    "claimed_by_user_id": {
      "type": "string",
      "description": "EstateSalen User ID of the person who claimed this listing (from FutureEstateOperator)"
    },
    "territory_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Canonical Houszu micro_territory_id values this company operates in (matched from home-base city/county/coords)"
    },
    "territory_match_status": {
      "type": "string",
      "enum": [
        "matched",
        "unmatched"
      ],
      "default": "unmatched",
      "description": "Whether this directory record was successfully linked to Houszu micro-territories"
    },
    "enrichment_status": {
      "type": "string",
      "enum": [
        "not_started",
        "searching",
        "found",
        "failed"
      ],
      "default": "not_started"
    },
    "lead_stage": {
      "type": "string",
      "default": "future_operator"
    },
    "audience_sync_status": {
      "type": "string",
      "default": "not_synced"
    },
    "meta_custom_audience_id": {
      "type": "string"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Which source entities contributed to this record (e.g. FutureEstateOperator, EstatesalesOrgOperator, FutureOperatorLead)"
    },
    "source_record_ids": {
      "type": "object",
      "description": "Map of source entity name to original record ID",
      "default": {}
    },
    "merge_status": {
      "type": "string",
      "enum": [
        "single_source",
        "merged",
        "unmatched"
      ],
      "default": "single_source",
      "description": "Whether this record came from one source or was merged from multiple"
    }
  },
  "required": [
    "company_name"
  ]
}