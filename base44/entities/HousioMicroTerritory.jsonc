{
  "name": "HousioMicroTerritory",
  "type": "object",
  "properties": {
    "micro_territory_id": {
      "type": "string",
      "description": "Unique micro-territory identifier"
    },
    "territory_id": {
      "type": "string",
      "description": "Parent territory ID"
    },
    "state": {
      "type": "string",
      "description": "State abbreviation"
    },
    "county": {
      "type": "string",
      "description": "County name"
    },
    "cities_json": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Array of city/township names in this micro-territory (legacy string format)"
    },
    "cities_geo_json": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "formatted_address": {
            "type": "string"
          }
        },
        "required": [
          "city",
          "lat",
          "lng"
        ]
      },
      "default": [],
      "description": "Cities with coordinates from Houszu \u2014 used for mapping and geo-matching"
    },
    "synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was last synced from Housio"
    }
  },
  "required": [
    "micro_territory_id",
    "state",
    "county",
    "cities_json"
  ]
}