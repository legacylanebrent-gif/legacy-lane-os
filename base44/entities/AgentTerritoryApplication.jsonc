{
  "name": "AgentTerritoryApplication",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "brokerage": {
      "type": "string"
    },
    "license_state": {
      "type": "string"
    },
    "interested_in": {
      "type": "string",
      "enum": [
        "preferred",
        "exclusive",
        "unsure"
      ]
    },
    "cities_requested": {
      "type": "string"
    },
    "county_requested": {
      "type": "string"
    },
    "territory_cities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Plain name list of all cities/municipalities within the assigned county territory"
    },
    "territory_municipalities": {
      "type": "array",
      "default": [],
      "description": "Full rich municipality data including type, incorporated status, and notes",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Borough, Township, City, CDP, Village, Town, etc."
          },
          "incorporated": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "avg_sale_price": {
      "type": "number"
    },
    "has_estate_sale_relationships": {
      "type": "string"
    },
    "why_should_be_considered": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewing",
        "approved",
        "denied"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an admin approved or denied this application. Set by the review screen; never edited by the applicant."
    },
    "decided_by_name": {
      "type": "string",
      "description": "Admin who made the decision, kept for accountability on shared territories."
    },
    "conflict_override": {
      "type": "boolean",
      "default": false,
      "description": "TRUE only when an admin approved this territory knowing it overlaps an already approved agent. Records a deliberate decision, never an automatic grant."
    }
  },
  "required": [
    "name",
    "email"
  ]
}