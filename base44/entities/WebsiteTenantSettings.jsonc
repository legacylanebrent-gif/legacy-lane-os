{
  "name": "WebsiteTenantSettings",
  "type": "object",
  "properties": {
    "website_tenant_id": {
      "type": "string",
      "description": "WebsiteTenant this configuration belongs to. Ownership chain validated server-side: User \u2192 Company membership \u2192 Company \u2192 WebsiteTenant \u2192 Settings."
    },
    "company_id": {
      "type": "string",
      "description": "Canonical Company. DERIVED server-side from the tenant \u2014 never accepted from the client."
    },
    "site_title": {
      "type": "string",
      "description": "Website title (browser tab / header)."
    },
    "display_business_name": {
      "type": "string",
      "description": "Website-visible business name override. Company legal identity is never edited here."
    },
    "tagline": {
      "type": "string"
    },
    "branding": {
      "type": "object",
      "description": "Template branding tokens (logo, favicon, colors, fonts, design preset).",
      "properties": {
        "logo_url": {
          "type": "string"
        },
        "alternate_logo_url": {
          "type": "string",
          "description": "Compact/alternate logo for small surfaces (only when required)."
        },
        "favicon_url": {
          "type": "string"
        },
        "primary_color": {
          "type": "string",
          "description": "Hex color token for Template #1 primary surfaces."
        },
        "secondary_color": {
          "type": "string"
        },
        "accent_color": {
          "type": "string"
        },
        "background_color": {
          "type": "string"
        },
        "text_color": {
          "type": "string"
        },
        "heading_font_family": {
          "type": "string"
        },
        "body_font_family": {
          "type": "string"
        },
        "design_preset": {
          "type": "string",
          "description": "Name of the applied safe design preset (classic/modern/elegant/bold). Presets write controlled branding tokens; they never create separate templates."
        }
      },
      "default": {}
    },
    "contact": {
      "type": "object",
      "description": "Website contact PRESENTATION. Canonical operational contact truth stays on Company.",
      "properties": {
        "use_company_phone": {
          "type": "boolean",
          "default": true
        },
        "phone_display": {
          "type": "string",
          "description": "Presentation override used only when use_company_phone is false."
        },
        "sms_number": {
          "type": "string",
          "description": "Optional text/SMS number shown when different from the public phone."
        },
        "use_company_email": {
          "type": "boolean",
          "default": true
        },
        "email_display": {
          "type": "string",
          "description": "Presentation override used only when use_company_email is false."
        },
        "inquiry_email": {
          "type": "string",
          "description": "Optional dedicated inquiries address displayed for leads."
        },
        "mailing_address": {
          "type": "string",
          "description": "Mailing address presentation when different from the business address."
        },
        "address_display": {
          "type": "string",
          "description": "Website-visible address presentation (e.g. city/state line)."
        },
        "show_address": {
          "type": "boolean",
          "default": true,
          "description": "Whether the physical address line renders publicly."
        },
        "business_hours": {
          "type": "string",
          "description": "Business hours presentation, one line per entry."
        },
        "contact_cta_label": {
          "type": "string",
          "description": "Label for the contact call-to-action."
        }
      },
      "default": {}
    },
    "social": {
      "type": "object",
      "description": "Structured social profile URLs shown by the template. https URLs only.",
      "properties": {
        "facebook": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "twitter": {
          "type": "string"
        },
        "youtube": {
          "type": "string"
        },
        "pinterest": {
          "type": "string"
        },
        "tiktok": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        }
      },
      "default": {}
    },
    "business": {
      "type": "object",
      "description": "Website business profile PRESENTATION. Seeds from canonical Company but never writes back to it.",
      "properties": {
        "short_description": {
          "type": "string"
        },
        "long_description": {
          "type": "string"
        },
        "year_founded": {
          "type": "string"
        },
        "years_experience": {
          "type": "string"
        },
        "owner_name": {
          "type": "string"
        },
        "business_type_label": {
          "type": "string",
          "description": "Public descriptor (e.g. Estate Sale Company)."
        },
        "primary_city": {
          "type": "string"
        },
        "primary_county": {
          "type": "string"
        },
        "counties_served": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "cities_served": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "states_served": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "service_area_notes": {
          "type": "string"
        },
        "show_address": {
          "type": "boolean",
          "default": false,
          "description": "Whether a full street address renders on public pages."
        }
      },
      "default": {}
    },
    "homepage": {
      "type": "object",
      "description": "Homepage hero, introduction, CTA and controlled section configuration (no general page-builder).",
      "properties": {
        "hero_headline": {
          "type": "string"
        },
        "hero_subheadline": {
          "type": "string"
        },
        "hero_image_url": {
          "type": "string"
        },
        "hero_layout": {
          "type": "string",
          "enum": [
            "overlay",
            "centered",
            "text_left",
            "full_background"
          ],
          "description": "Curated hero layout variant. Null/overlay preserves the certified Template #1 rendering."
        },
        "intro_copy": {
          "type": "string"
        },
        "cta_label": {
          "type": "string"
        },
        "cta_link": {
          "type": "string",
          "description": "Internal template path (e.g. /site/sales) or https URL."
        },
        "secondary_cta_text": {
          "type": "string"
        },
        "secondary_cta_link": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "visible": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "default": [],
          "description": "Controlled homepage section visibility/order. Keys come from the platform section registry \u2014 never arbitrary content."
        }
      },
      "default": {}
    },
    "why_choose_us": {
      "type": "object",
      "description": "Structured trust/value points for the homepage. Only explicit operator-entered claims render.",
      "properties": {
        "headline": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "Key from the platform-approved icon library."
              }
            }
          },
          "default": []
        }
      },
      "default": {}
    },
    "how_it_works": {
      "type": "object",
      "description": "Structured process section \u2014 operator-defined steps, never a hardcoded process.",
      "properties": {
        "headline": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "visible": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "default": []
        }
      },
      "default": {}
    },
    "trust": {
      "type": "object",
      "description": "Structured credentials/trust indicators. Only explicit operator-entered data renders \u2014 never inferred or invented.",
      "properties": {
        "headline": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          },
          "default": []
        }
      },
      "default": {}
    },
    "about": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "description": "About page copy (plain text paragraphs separated by blank lines)."
        },
        "mission": {
          "type": "string"
        },
        "owner_bio": {
          "type": "string"
        },
        "owner_photo_url": {
          "type": "string"
        },
        "team_intro": {
          "type": "string"
        },
        "team_photo_url": {
          "type": "string"
        },
        "team_members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "photo_url": {
                "type": "string"
              },
              "bio": {
                "type": "string"
              }
            }
          },
          "default": []
        }
      },
      "default": {}
    },
    "services": {
      "type": "object",
      "description": "Services library. Starter services are platform-provided presets; custom services are operator-defined. Template renders only enabled services.",
      "properties": {
        "headline": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "long_description": {
                "type": "string",
                "description": "Dedicated service page overview copy."
              },
              "icon": {
                "type": "string",
                "description": "Key from the platform-approved icon library."
              },
              "image_url": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "show_on_homepage": {
                "type": "boolean",
                "default": true
              },
              "dedicated_page": {
                "type": "boolean",
                "default": false,
                "description": "When true (with an seo_slug) Template #1 renders a structured service detail page."
              },
              "seo_slug": {
                "type": "string",
                "description": "URL slug for the dedicated service page, normalized server-side."
              },
              "cta_label": {
                "type": "string"
              },
              "cta_link": {
                "type": "string"
              },
              "library_key": {
                "type": "string",
                "description": "Starter-library key this service came from (diagnostics only)."
              }
            }
          },
          "default": []
        }
      },
      "default": {}
    },
    "testimonials": {
      "type": "object",
      "description": "Website testimonials (presentation-only social proof). Template renders nothing when empty.",
      "properties": {
        "headline": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "quote": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "context": {
                "type": "string",
                "description": "Optional attribution context (e.g. role, service used)."
              },
              "photo_url": {
                "type": "string"
              },
              "featured": {
                "type": "boolean",
                "default": false
              },
              "visible": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "default": []
        }
      },
      "default": {}
    },
    "gallery": {
      "type": "object",
      "description": "Tenant presentation gallery \u2014 separate from canonical Estate Sale inventory.",
      "properties": {
        "headline": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "image_url": {
                "type": "string"
              },
              "media_id": {
                "type": "string",
                "description": "Optional reference to a WebsiteTenantMedia record."
              },
              "caption": {
                "type": "string"
              },
              "alt_text": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "visible": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "default": []
        }
      },
      "default": {}
    },
    "cta": {
      "type": "object",
      "description": "Reusable seller CTA band configuration (canonical lead funnel connects in Phase 4C).",
      "properties": {
        "label": {
          "type": "string"
        },
        "sublabel": {
          "type": "string"
        },
        "link": {
          "type": "string"
        }
      },
      "default": {}
    },
    "seo": {
      "type": "object",
      "description": "Tenant-level SEO defaults. Canonical URL always derives from the resolved active WebsiteDomain \u2014 never stored or hardcoded.",
      "properties": {
        "default_title": {
          "type": "string"
        },
        "default_description": {
          "type": "string"
        },
        "social_image_url": {
          "type": "string"
        },
        "search_visibility": {
          "type": "string",
          "enum": [
            "index",
            "noindex"
          ],
          "default": "index",
          "description": "Phase 4E \u2014 search engine visibility policy. 'index' (default) allows search engines to index the LIVE website; 'noindex' opts the whole website out of search indexing. The included EstateSalen subdomain is always a valid, indexable identity."
        }
      },
      "default": {}
    },
    "page_seo": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Page SEO title override."
          },
          "description": {
            "type": "string",
            "description": "Page meta description override."
          },
          "social_image_url": {
            "type": "string",
            "description": "Page social share image override."
          }
        }
      },
      "description": "Phase 4E (Parts 21/22) \u2014 per-page presentation SEO overrides keyed by the platform page vocabulary (home, estate_sales, sale_detail, services, service_detail, about, gallery, faq, contact). Blanks fall back to deterministic safe defaults. Never arbitrary head markup."
    },
    "faq": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              },
              "visible": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "default": []
        }
      },
      "default": {}
    },
    "policies": {
      "type": "object",
      "description": "Structured tenant-level policies. Canonical Sale-specific policies always take precedence over these defaults.",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "visible": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "default": []
        }
      },
      "default": {}
    },
    "navigation": {
      "type": "object",
      "description": "Header navigation manager. Paths are constrained to the platform-controlled template route allowlist \u2014 never arbitrary URLs.",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "Controlled template path from the navigation allowlist."
              },
              "visible": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "default": []
        }
      },
      "default": {}
    },
    "footer": {
      "type": "object",
      "description": "Footer presentation configuration.",
      "properties": {
        "logo_url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "copyright_name": {
          "type": "string"
        },
        "show_powered_by": {
          "type": "boolean",
          "default": true,
          "description": "EstateSalen-powered attribution."
        }
      },
      "default": {}
    },
    "legal": {
      "type": "object",
      "description": "Presentation copy references for policy/legal pages.",
      "properties": {
        "privacy_policy_text": {
          "type": "string"
        },
        "terms_text": {
          "type": "string"
        }
      },
      "default": {}
    },
    "sale_display": {
      "type": "object",
      "description": "Sale display preferences. Never copies operational Sale state.",
      "properties": {
        "show_sold_items": {
          "type": "boolean",
          "default": true
        },
        "show_prices": {
          "type": "boolean",
          "default": true
        }
      },
      "default": {}
    },
    "inventory_display": {
      "type": "object",
      "description": "Inventory presentation controls for Template #1.",
      "properties": {
        "show_prices": {
          "type": "boolean",
          "default": true
        },
        "show_condition": {
          "type": "boolean",
          "default": true
        }
      },
      "default": {}
    },
    "settings_version": {
      "type": "integer",
      "default": 1,
      "description": "Configuration version marker (future draft/publish versioning)."
    },
    "last_saved_section": {
      "type": "string",
      "description": "Section key of the most recent editor save (change attribution, Part 4B/27)."
    },
    "last_saved_by": {
      "type": "string",
      "description": "User ID of the most recent editor save actor (change attribution)."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "MVP: one active configuration per tenant."
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "READ-SCOPE PROJECTION of the tenant's Company membership for RLS. Company remains the membership source of truth."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "website_tenant_id",
    "company_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}