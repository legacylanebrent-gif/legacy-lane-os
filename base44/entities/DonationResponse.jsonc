{
  "name": "DonationResponse",
  "type": "object",
  "properties": {
    "donation_id": {
      "type": "string",
      "description": "Reference to Donation entity"
    },
    "operator_id": {
      "type": "string",
      "description": "Chapter 22 P0-1 \u2014 Donation.operator_id projection (RLS anchor), derived from the parent donation at creation. The owning operator can read and manage every response to their donation."
    },
    "vendor_id": {
      "type": "string",
      "description": "User ID of the donation company"
    },
    "vendor_name": {
      "type": "string",
      "description": "Donation company business name"
    },
    "vendor_email": {
      "type": "string"
    },
    "vendor_phone": {
      "type": "string"
    },
    "interested_items": {
      "type": "string",
      "description": "What items the donation company is interested in picking up"
    },
    "can_facilitate_pickup": {
      "type": "boolean",
      "default": false,
      "description": "Whether they can facilitate pickups during the required timeframe"
    },
    "available_dates": {
      "type": "string",
      "description": "When they are available to pick up (free text or date range)"
    },
    "message": {
      "type": "string",
      "description": "Additional message to the operator or seller"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending",
      "description": "Status of this response"
    }
  },
  "required": [
    "donation_id",
    "vendor_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}