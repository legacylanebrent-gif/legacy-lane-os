{
  "name": "OperatorWallet",
  "type": "object",
  "description": "Legacy referral-program wallet. Referral Rebuild Phase 1: ALL mutations are admin-only (backend functions operate as service role with explicit authorization); operators may READ their own wallet only \u2014 they can no longer create wallets or edit balances, hold dates, or payout status directly. Existing balances and history are preserved.",
  "properties": {
    "operator_id": {
      "type": "string",
      "description": "User ID of the Estate Sale Company Owner"
    },
    "total_credits": {
      "type": "number",
      "default": 0,
      "description": "Total platform credits earned (in cents)"
    },
    "available_balance": {
      "type": "number",
      "default": 0,
      "description": "Credits available for withdrawal (in cents)"
    },
    "pending_balance": {
      "type": "number",
      "default": 0,
      "description": "Credits pending release after hold period (in cents)"
    },
    "withdrawn_total": {
      "type": "number",
      "default": 0,
      "description": "Total credits withdrawn to date (in cents)"
    },
    "frozen_balance": {
      "type": "number",
      "default": 0,
      "description": "Credits on hold due to dispute or investigation (in cents)"
    },
    "wallet_status": {
      "type": "string",
      "enum": [
        "active",
        "frozen",
        "suspended"
      ],
      "default": "active",
      "description": "Wallet operational status"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last time wallet was updated"
    }
  },
  "required": [
    "operator_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}