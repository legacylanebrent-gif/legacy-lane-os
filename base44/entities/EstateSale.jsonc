              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "views": {
      "type": "integer",
      "default": 0
    },
    "saves": {
      "type": "integer",
      "default": 0
    },
    "premium_listing": {
      "type": "boolean",
      "default": false
    },
    "payment_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "cash",
        "credit_card",
        "venmo"
      ]
    },
    "special_notes": {
      "type": "string"
    },
    "parking_info": {
      "type": "string"
    },
    "referral_source_type": {
      "type": "string",
      "enum": [
        "real_estate_agent",
        "attorney",
        "senior_move_manager",
        "professional_organizer",
        "estate_sale_company",
        "past_client",
        "buyer_customer",
        "friend_family",
        "online_search",
        "social_media",
        "website",
        "other"
      ],
      "description": "Chapter 2 P1 \u2014 PROJECTION of the structured referral source from the linked SaleConversionPipeline deal (copied when the deal is linked to this sale). Display/source attribution only; the pipeline deal remains the capture point.",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
