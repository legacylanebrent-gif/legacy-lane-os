            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "referral_source_name": {
      "type": "string",
      "description": "Chapter 2 P1 \u2014 PROJECTION of the referrer name from the linked SaleConversionPipeline deal.",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
