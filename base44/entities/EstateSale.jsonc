    "early_sign_in_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether early sign-in list is allowed for this sale"
    },
    "buyout_config": {
      "type": "object",
      "description": "Configuration for buyout events \u2014 only applies when sale_type is buyout_or_cleanout",
      "properties": {
        "bid_deadline": {
          "type": "string",
          "format": "date-time",
          "description": "Deadline for resellers to submit buyout bids"
        },
        "buyout_mode": {
          "type": "string",
          "enum": [
            "full_buyout",
            "cherry_pick"
          ],
          "default": "full_buyout",
          "description": "Full buyout = all or nothing; cherry_pick = resellers can pick individual items"
        },
        "reseller_radius_miles": {
          "type": "integer",
          "default": 25,
          "description": "Marketing radius in miles to notify resellers"
        },
        "minimum_bid": {
          "type": "number",
          "description": "Minimum acceptable buyout bid (whole dollars)"
        },
        "estimated_total_value": {
          "type": "number",
          "description": "Estimated total value of all contents (whole dollars)"
        },
        "inventory_summary": {
          "type": "string",
          "description": "Brief summary of what is included in the buyout"
        },
        "pickup_deadline": {
          "type": "string",
          "format": "date",
          "description": "Deadline for the winning bidder to remove all items"
        },
        "payment_terms": {
          "type": "string",
          "description": "Payment terms for the buyout (e.g. cash, certified check, wire transfer)"
        },
        "reseller_registration_required": {
          "type": "boolean",
          "default": true,
          "description": "Whether resellers must register before bidding"
        },
        "max_reseller_spots": {
          "type": "integer",
          "description": "Maximum number of resellers who can participate"
        },
        "highlights": {
          "type": "string",
          "description": "Notable or high-value items to promote in the buyout listing"
        },
        "cleanout_required": {
          "type": "boolean",
          "default": false,
          "description": "Whether the property must be completely emptied (cleanout)"
        }
      },
      "default": null
    },
    "promoted_to_all_users": {
      "type": "boolean",
      "default": false,
      "description": "Whether this sale is promoted to all platform users"
    },
    "sale_team": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "User IDs of team members assigned to manage this sale",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "seo_title": {
      "type": "string",
      "description": "SEO optimized page title"
    },
    "seo_description": {
      "type": "string",
      "description": "SEO meta description"
    },
    "seo_slug": {
      "type": "string",
      "description": "URL slug for SEO"
    },
    "seo_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "SEO keywords"
    },
    "ai_summary": {
      "type": "string",
      "description": "AI-generated summary of the sale"
    },
    "schema_json": {
      "type": "object",
      "description": "JSON-LD structured data schema"
    },
    "indexed_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "submitted",
        "indexed",
        "not_indexed",
        "unknown"
      ],
      "default": "not_submitted",
      "description": "Google indexing status"
    },
    "website_slug": {
      "type": "string",
      "description": "Public website URL slug (human-readable, normalized, URL-safe; Company-scoped unique; deterministic initial generation with collision-safe ordinal suffixes). Presentation/routing identity ONLY \u2014 never replaces the canonical Sale ID. Generated server-side."
    }
  },
  "required": [
    "title",
    "operator_id",
    "property_address"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.sale_team": {
                "$in": [
                  "{{user.id}}"
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.status": {
            "$in": [
              "upcoming",
              "active",
              "completed"
            ]
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.sale_team": {
                "$in": [
                  "{{user.id}}"
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}