          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "early_sign_in_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether early sign-in list is allowed for this sale"
    },
    "buyout_config": {
      "type": "object",
      "description": "Configuration for buyout events \u2014 only applies when sale_type is buyout_or_cleanout",
      "properties": {
        "bid_deadline": {
          "type": "string",
          "format": "date-time",
          "description": "Deadline for resellers to submit buyout bids"
        },
        "buyout_mode": {
          "type": "string",
          "enum": [
            "full_buyout",
            "cherry_pick"
          ],
          "default": "full_buyout",
          "description": "Full buyout = all or nothing; cherry_pick = resellers can pick individual items"
        },
        "reseller_radius_miles": {
          "type": "integer",
          "default": 25,
          "description": "Marketing radius in miles to notify resellers"
        },
        "minimum_bid": {
          "type": "number",
          "description": "Minimum acceptable buyout bid (whole dollars)"
        },
        "estimated_total_value": {
          "type": "number",
          "description": "Estimated total value of all contents (whole dollars)"
        },
        "inventory_summary": {
          "type": "string",
          "description": "Brief summary of what is included in the buyout"
        },
        "pickup_deadline": {
          "type": "string",
          "format": "date",
          "description": "Deadline for the winning bidder to remove all items"
        },
        "payment_terms": {
          "type": "string",
          "description": "Payment terms for the buyout (e.g. cash, certified check, wire transfer)"
        },
        "reseller_registration_required": {
          "type": "boolean",
          "default": true,
          "description": "Whether resellers must register before bidding"
        },
        "max_reseller_spots": {
          "type": "integer",
          "description": "Maximum number of resellers who can participate"
        },
        "highlights": {
          "type": "string",
          "description": "Notable or high-value items to promote in the buyout listing"
        },
        "cleanout_required": {
          "type": "boolean",
          "default": false,
          "description": "Whether the property must be completely emptied (cleanout)"
        }
      },
      "default": null
    },
    "promoted_to_all_users": {
      "type": "boolean",
      "default": false,
      "description": "Whether this sale is promoted to all platform users"
    },
    "sale_team": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "User IDs of team members assigned to manage this sale",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "seo_title": {
      "type": "string",
      "description": "SEO optimized page title"
    },
    "seo_description": {
      "type": "string",
      "description": "SEO meta description"
    },
    "seo_slug": {
      "type": "string",
      "description": "URL slug for SEO"
    },
    "seo_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "SEO keywords"
    },
    "ai_summary": {
      "type": "string",
      "description": "AI-generated summary of the sale"
    },
    "schema_json": {
      "type": "object",
      "description": "JSON-LD structured data schema"
    },
    "indexed_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "submitted",
        "indexed",
        "not_indexed",
        "unknown"
      ],
      "default": "not_submitted",
      "description": "Google indexing status"
    },
    "website_slug": {
      "type": "string",
      "description": "Public website URL slug (human-readable, normalized, URL-safe; Company-scoped unique; deterministic initial generation with collision-safe ordinal suffixes). Presentation/routing identity ONLY \u2014 never replaces the canonical Sale ID. Generated server-side."
    },
    "source_deal_id": {
      "type": "string",
      "description": "Chapter 13 P1 \u2014 ACTIVATION PROVENANCE: the SaleConversionPipeline deal this active project was activated from. The deal's estate_sale_id link points back here; this field lets the sale itself answer WHERE DID THIS ACTIVE PROJECT COME FROM? even before/without the deal link."
    },
    "activation": {
      "type": "object",
      "default": {},
      "description": "Chapter 13 P1 \u2014 activation provenance snapshot (references only \u2014 immutable snapshot truth stays in the proposal/agreement records and is never copied here): deal, accepted proposal, executed agreement, when, and who activated.",
      "properties": {
        "deal_id": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string",
          "description": "The ACCEPTED SaleProposal at activation time, when one exists (reference, never a copy)."
        },
        "agreement_id": {
          "type": "string",
          "description": "The EXECUTED/READY SaleAgreement at activation time, when one exists (reference, never a copy)."
        },
        "activated_at": {
          "type": "string",
          "format": "date-time"
        },
        "activated_by": {
          "type": "string"
        },
        "activated_by_name": {
          "type": "string"
        }
      }
    },
    "communication_plan": {
      "type": "object",
      "default": {},
      "description": "Chapter 13 P1 \u2014 the project's CLIENT COMMUNICATION PLAN: primary communication contact, preferred method, and update cadence. This is OPERATIONAL PREFERENCE ONLY \u2014 it is NEVER marketing consent, and an SMS preference is NEVER SMS marketing consent. Customer.io / marketing consent state is never created or changed by this field.",
      "properties": {
        "primary_contact_id": {
          "type": "string",
          "description": "Optional canonical Contact link for the primary communication contact."
        },
        "primary_contact_name": {
          "type": "string",
          "description": "Who the operator communicates with routinely (client or family member). INVOLVEMENT IS NOT AUTHORITY \u2014 the authorized decision-makers live in SaleAuthority."
        },
        "relationship": {
          "type": "string",
          "description": "Relationship to the client/estate (e.g. daughter, executor, attorney)."
        },
        "preferred_method": {
          "type": "string",
          "enum": [
            "EMAIL",
            "SMS",
            "PHONE",
            "OTHER"
          ],
          "description": "How this contact prefers routine project updates. PREFERENCE \u2260 CONSENT \u2014 it never opts anyone into marketing."
        },
        "cadence": {
          "type": "string",
          "enum": [
            "AS_NEEDED",
            "WEEKLY",
            "TWICE_WEEKLY",
            "MILESTONE",
            "CUSTOM"
          ],
          "description": "How often the operator committed to updating the client. Informs the human (and optional client-update tasks); nothing is auto-sent."
        },
        "update_note": {
          "type": "string",
          "description": "Custom cadence / context in the operator's words."
        }
      }
    },
    "excluded_areas": {
      "type": "array",
      "default": [],
      "description": "Chapter 13 P1 \u2014 areas EXCLUDED / RESTRICTED FROM SALE (rooms, closets, cabinets, storage, outbuildings the client retains or restricts). TEAM-SAFE by design: names and notes only \u2014 never access codes or credentials (those live in the operator-only site_assessment.access_details). Deliberately on the sale (team-readable), not the operator-private consultation deal.",
      "items": {
        "type": "object",
        "properties": {
          "area_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Area name (e.g. Primary bedroom closet, Garage workshop, Attic)."
          },
          "type": {
            "type": "string",
            "enum": [
              "room",
              "closet",
              "cabinet",
              "storage",
              "outbuilding",
              "other"
            ],
            "default": "room"
          },
          "note": {
            "type": "string",
            "description": "Why it is excluded / handling notes (team-safe, no codes)."
          },
          "family_deadline": {
            "type": "string",
            "format": "date",
            "description": "Chapter 13 P1 \u2014 CLIENT/FAMILY ACTION DEADLINE: the date the family committed to handle this area by (e.g. remove retained items). Deliberately distinct from any team task due date \u2014 this is the family's own commitment, surfaced on the timeline, never a scheduling engine."
          },
          "resolved": {
            "type": "boolean",
            "default": false,
            "description": "Family/owner confirmed the area is handled."
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "prep_zones": {
      "type": "array",
      "default": [],
      "description": "Chapter 14 P1 \u2014 TEAM-READABLE PREP ZONES (rooms / work areas) for preparation. Same projection pattern as excluded_areas: deliberately ON THE SALE (team-readable), NOT on the operator-private Chapter 12 consultation deal. source_type/source_id preserves provenance back to the consultation room a zone originated from WITHOUT exposing private consultation content \u2014 only the room NAME is projected, so the two never drift independently. Zone notes are TEAM-SAFE (no codes/credentials). Prep status is honest human-set state \u2014 no percentage progress anywhere. Discovery counts are DERIVED at read time from SaleDiscovery records, never stored here.",
      "items": {
        "type": "object",
        "properties": {
          "zone_id": {
            "type": "string",
            "description": "Stable zone identifier (referenced by SaleDiscovery.zone_id and work-zone QR signs)."
          },
          "name": {
            "type": "string",
            "description": "Zone/room name (Living Room, Basement, Garage, Attic...)."
          },
          "source_type": {
            "type": "string",
            "enum": [
              "CONSULTATION_ROOM",
              "EXCLUDED_AREA",
              "MANUAL"
            ],
            "default": "MANUAL",
            "description": "Chapter 14 P1-7 \u2014 where this zone came from."
          },
          "source_id": {
            "type": "string",
            "description": "Provenance reference (consultation room_id) when source_type is CONSULTATION_ROOM."
          },
          "prep_status": {
            "type": "string",
            "enum": [
              "untouched",
              "sorting",
              "waiting_decision",
              "waiting_research",
              "ready_for_inventory",
              "complete"
            ],
            "default": "untouched",
            "description": "Chapter 14 P1-8 \u2014 deterministic preparation state, human-set. WAITING states pair with the canonical open decision/research records; never a percentage."
          },
          "assignee_user_id": {
            "type": "string",
            "description": "User ID of the responsible team member. Work assignment itself reuses SaleTask (ASSIGN WORK creates a task) \u2014 this is the zone-level responsibility display."
          },
          "assignee_name": {
            "type": "string",
            "description": "Assignee display-name snapshot."
          },
          "access_class": {
            "type": "string",
            "enum": [
              "UNCLASSIFIED",
              "OPEN_TO_CUSTOMERS",
              "STAFF_ONLY",
              "CLOSED_RESTRICTED",
              "PICKUP_ONLY",
              "CHECKOUT"
            ],
            "default": "UNCLASSIFIED",
            "description": "Chapter 14 P1-37 \u2014 customer access plan for this area. Reuses the Chapter 8/13 security walkthrough; UNCLASSIFIED is the honest default, never guessed."
          },
          "security_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "difficult_to_monitor",
                "high_value_control_needed",
                "customer_flow_concern",
                "other_security_concern"
              ]
            },
            "default": [],
            "description": "Chapter 14 P1-38 \u2014 sightline/security attention flags. Planning aids only \u2014 never a claim of surveillance or safety."
          },
          "removal_route_note": {
            "type": "string",
            "description": "Chapter 14 P1-41 \u2014 large-item removal route / special concern for this zone. Chapter 21 transaction/pickup state is untouched."
          },
          "protection_note": {
            "type": "string",
            "description": "Chapter 14 P1-39 \u2014 property-protection concern for this zone (floors, walls, doors, stairs, landscaping, architectural features)."
          },
          "condition_photo_uri": {
            "type": "string",
            "description": "Chapter 14 P1-40 \u2014 PRIVATE pre-sale property-condition photo (private storage; viewed via short-lived signed URL). NEVER public gallery or marketing."
          },
          "notes": {
            "type": "string",
            "description": "Team-safe prep notes (no codes/credentials)."
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "description": "When prep_status was set to complete."
          }
        }
      }
    },
    "pickup_plan": {
      "type": "object",
      "default": {},
      "description": "Chapter 13 P1 \u2014 project-level DEFAULT large-item pickup plan (window/location/instructions) for buyer pickups. A planning default only: Chapter 21 transaction truth stays on Item records and checkout \u2014 this plan never alters it.",
      "properties": {
        "pickup_window": {
          "type": "string",
          "description": "Default pickup window (e.g. 'Sat 3pm\u20135pm, Sun 12pm\u20134pm')."
        },
        "pickup_location": {
          "type": "string",
          "description": "Where buyers pick up (e.g. 'Side driveway, 2nd garage door')."
        },
        "instructions": {
          "type": "string",
          "description": "Default pickup instructions for buyers."
        }
      }
    },
    "discount_schedule": {
      "type": "array",
      "default": [],
      "description": "Chapter 16 P1-39/P1-40 \u2014 the operator's PLANNED discount stages for this sale (Day 1 full price, Day 2, final hours...). OPERATOR-DEFINED PLAN ONLY: the system never applies a discount automatically; a stage is guidance for the team, and an Item marked excluded_from_discounts is never silently discounted \u2014 applying a stage to such an item is an explicit human price change through the normal price-change path (changeItemPrice), never a batch effect.",
      "items": {
        "type": "object",
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Stage name (e.g. 'Day 2', 'Final Hours')."
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the stage begins (optional)."
          },
          "discount_percent": {
            "type": "number",
            "description": "Planned percent off the current price at this stage."
          },
          "note": {
            "type": "string",
            "description": "Operator note (e.g. 'Everything except jewelry and the dining set')."
          }
        }
      }
    }
  },
  "required": [
    "title",
    "operator_id",
    "property_address"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
