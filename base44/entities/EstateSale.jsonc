{
  "name": "EstateSale",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sale_type": {
      "type": "string",
      "enum": [
        "estate_tag_sale_private_home",
        "online_only_auction",
        "auction",
        "moving_sale_private_home",
        "estate_tag_sale_offsite_warehouse",
        "auction_house",
        "appointment_required_sale",
        "estate_sale_offsite_store",
        "business_closing",
        "online_estate_sale",
        "outside_sale",
        "buyout_or_cleanout",
        "five_and_under_sale",
        "demolition_sale",
        "single_item_type_collection",
        "bundle_buyout"
      ],
      "description": "Type of sale"
    },
    "operator_id": {
      "type": "string",
      "description": "Estate Sale Company Owner user ID"
    },
    "operator_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "description": "Canonical owning Company ID; legacy operator_id ownership is preserved."
    },
    "property_address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "formatted_address": {
          "type": "string"
        }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "Geographic coordinates"
    },
    "distance_miles": {
      "type": "number",
      "description": "Operational distance snapshot from operating base; null is unknown, never invented zero. Recomputed only on explicit save.",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "distance_calculated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Distance snapshot timestamp.",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "site_assessment": {
      "type": "object",
      "description": "Canonical PRIVATE operational site assessment, not a home inspection. Owner/creator/admin only; sale-team assignment does not grant access to codes, key locations or alarm plans. Never project access credentials into public pages, marketing, proposals, agreements or unnecessary AI context.",
      "properties": {
        "property_type": {
          "type": "string"
        },
        "approx_size": {
          "type": "string"
        },
        "stairs_levels": {
          "type": "string",
          "enum": [
            "single_level",
            "one_flight",
            "multiple_flights",
            "unknown"
          ],
          "default": "unknown"
        },
        "elevator": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "default": "unknown"
        },
        "parking": {
          "type": "string",
          "enum": [
            "easy",
            "limited",
            "difficult",
            "unknown"
          ],
          "default": "unknown"
        },
        "gated_access": {
          "type": "string",
          "enum": [
            "no",
            "gated",
            "controlled_entry",
            "unknown"
          ],
          "default": "unknown"
        },
        "community_restrictions": {
          "type": "string",
          "enum": [
            "none",
            "some",
            "significant",
            "unknown"
          ],
          "default": "unknown"
        },
        "loading_access": {
          "type": "string",
          "enum": [
            "easy",
            "limited",
            "difficult",
            "unknown"
          ],
          "default": "unknown"
        },
        "merchandise_volume": {
          "type": "string",
          "enum": [
            "light",
            "moderate",
            "heavy",
            "unknown"
          ],
          "default": "unknown"
        },
        "storage_areas": {
          "type": "string"
        },
        "pickup_constraints": {
          "type": "string",
          "enum": [
            "none",
            "limited",
            "difficult",
            "unknown"
          ],
          "default": "unknown"
        },
        "sale_day_restrictions": {
          "type": "string"
        },
        "access_details": {
          "type": "object",
          "description": "HIGHLY SENSITIVE private access plan. Never public or team-readable. Client documents may reference responsibility, never credentials.",
          "properties": {
            "key_access_method": {
              "type": "string"
            },
            "alarm_considerations": {
              "type": "string"
            },
            "gate_access": {
              "type": "string"
            },
            "pets": {
              "type": "string"
            },
            "association_requirements": {
              "type": "string"
            },
            "contractors": {
              "type": "string"
            },
            "occupied_areas": {
              "type": "string"
            },
            "restricted_rooms": {
              "type": "string"
            },
            "access_windows": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "default": {}
        },
        "notes": {
          "type": "string"
        }
      },
      "default": {},
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "sale_dates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "upcoming",
        "active",
        "completed",
        "archived"
      ],
      "default": "draft",
      "description": "Draft/archived are private; upcoming/active/completed are deliberate public listing states."
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "synopsis": {
            "type": "string",
            "description": "Internal AI research synopsis, not public copy."
          },
          "rotation": {
            "type": "number",
            "default": 0
          },
          "price": {
            "type": "number"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "skip_item": {
            "type": "boolean",
            "default": false
          },
          "skip_saved_name": {
            "type": "string"
          },
          "skip_saved_description": {
            "type": "string"
          },
          "skip_updated_at": {
            "type": "string"
          },
          "skip_serp_search": {
            "type": "boolean"
          },
          "serp_search_status": {
            "type": "string"
          },
          "ai_first_search_price": {
            "type": "number",
            "description": "Standard model estate-sale estimate; never asking price."
          },
          "ai_deep_search_price": {
            "type": "number",
            "description": "Deep Scan comparable asking-price average; not sold evidence."
          },
          "thumbnail_url": {
            "type": "string"
          },
          "excluded_from_public": {
            "type": "boolean",
            "default": false,
            "description": "Retained/KEEP merchandise photo; private by default, excluded from public gallery, Marketing Kit, website and social imagery. Files are preserved."
          },
          "name_source": {
            "type": "string"
          },
          "description_source": {
            "type": "string"
          },
          "ai_updated_at": {
            "type": "string"
          },
          "ai_result_id": {
            "type": "string"
          },
          "pipeline": {
            "type": "object",
            "description": "Stable photo identity, image/content revision, operator edit revision, saved classification and durable provider receipts. No credentials or file bytes. Internal operational metadata, never public presentation.",
            "properties": {
              "id": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              },
              "edit_revision": {
                "type": "string"
              },
              "classification": {
                "type": "string"
              },
              "classification_reason": {
                "type": "string"
              },
              "operator_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "review_required": {
                "type": "boolean"
              },
              "repair_backup_uri": {
                "type": "string"
              },
              "repair_backup_sha256": {
                "type": "string"
              },
              "repaired_at": {
                "type": "string"
              },
              "jobs": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "description": "Photos with per-photo metadata. Identity and structural writers use conditional updates, not stale whole-array replacement.",
      "default": []
    },
    "image_thumbnails": {
      "type": "object",
      "description": "Lightweight thumbnail URL map.",
      "default": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "featured_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "estimated_value": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "total_items": {
      "type": "integer",
      "default": 0
    },
    "estimated_value": {
      "type": "number"
    },
    "actual_revenue": {
      "type": "number",
      "default": 0,
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "commission_rate": {
      "type": "number",
      "description": "Percentage",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "commission_earned": {
      "type": "number",
      "default": 0,
