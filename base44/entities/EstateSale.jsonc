                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "national_featured": {
      "type": "boolean",
      "default": false
    },
    "local_featured": {
      "type": "boolean",
      "default": false
    },
    "local_featured_until": {
      "type": "string",
      "format": "date-time",
      "description": "Expiry timestamp for local featured status (set to 30 days from activation)",
