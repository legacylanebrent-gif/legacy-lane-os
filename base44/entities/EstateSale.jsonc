{
  "name": "EstateSale",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sale_type": {
      "type": "string",
      "enum": [
        "estate_tag_sale_private_home",
        "online_only_auction",
        "auction",
        "moving_sale_private_home",
        "estate_tag_sale_offsite_warehouse",
        "auction_house",
        "appointment_required_sale",
        "estate_sale_offsite_store",
        "business_closing",
        "online_estate_sale",
        "outside_sale",
        "buyout_or_cleanout",
        "five_and_under_sale",
        "demolition_sale",
        "single_item_type_collection",
        "bundle_buyout"
      ],
      "description": "Type of sale"
    },
    "operator_id": {
      "type": "string",
      "description": "Estate Sale Company Owner user ID"
    },
    "operator_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "description": "Canonical EstateSalen Company ID owning this sale. Additive in Phase 1 \u2014 legacy operator_id ownership is preserved. Inventory derives company ownership from its sale."
    },
    "property_address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "formatted_address": {
          "type": "string"
        }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "description": "Geographic coordinates"
    },
    "distance_miles": {
      "type": "number",
      "description": "Chapter 5 P1 \u2014 operational distance snapshot from the operator's operating base to this sale location, captured at save time when both geocodes exist. Null = UNKNOWN; the system never invents 0-mile precision. Not recalculated when the operating base changes \u2014 only on an explicit save of this sale (its snapshot records the distance as known at that time).",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "distance_calculated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 5 P1 \u2014 when the distance snapshot was captured.",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "site_assessment": {
      "type": "object",
      "description": "Chapter 5 P1 \u2014 CANONICAL operational site assessment: practical property factors that affect the work, sale economics, and sale-day operations. This is the single editable copy (no second property/site entity, no deal-side duplicate). Captured at consultation/site visit via the sale editor. It is an operational assessment, NOT a home inspection and NOT the investor-oriented Property entity. Unknown defaults are honest: the system never guesses site conditions.",
      "properties": {
        "property_type": {
          "type": "string",
          "description": "Operator's shorthand for the property (single-family home, condo, apartment building, estate property, storage unit, commercial space...)."
        },
        "approx_size": {
          "type": "string",
          "description": "Approximate size sense (e.g. 2-bedroom, ~3000 sq ft, small condo, packed 3-story house)."
        },
        "stairs_levels": {
          "type": "string",
          "enum": [
            "single_level",
            "one_flight",
            "multiple_flights",
            "unknown"
          ],
          "default": "unknown"
        },
        "elevator": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "default": "unknown"
        },
        "parking": {
          "type": "string",
          "enum": [
            "easy",
            "limited",
            "difficult",
            "unknown"
          ],
          "default": "unknown"
        },
        "gated_access": {
          "type": "string",
          "enum": [
            "no",
            "gated",
            "controlled_entry",
            "unknown"
          ],
          "default": "unknown"
        },
        "community_restrictions": {
          "type": "string",
          "enum": [
            "none",
            "some",
            "significant",
            "unknown"
          ],
          "default": "unknown",
          "description": "HOA / community restrictions affecting signage, hours, traffic, or the sale itself. This field IS the Chapter 5 community-restrictions checklist \u2014 there is no second checklist system."
        },
        "loading_access": {
          "type": "string",
          "enum": [
            "easy",
            "limited",
            "difficult",
            "unknown"
          ],
          "default": "unknown"
        },
        "merchandise_volume": {
          "type": "string",
          "enum": [
            "light",
            "moderate",
            "heavy",
            "unknown"
          ],
          "default": "unknown"
        },
        "storage_areas": {
          "type": "string",
          "description": "Garage, outbuildings, attic, basement, sheds, off-site storage \u2014 where contents live beyond the main living space."
        },
        "pickup_constraints": {
          "type": "string",
          "enum": [
            "none",
            "limited",
            "difficult",
            "unknown"
          ],
          "default": "unknown"
        },
        "sale_day_restrictions": {
          "type": "string",
          "description": "HOA rules, permitted time windows, noise/sign restrictions, traffic constraints, and other sale-day conditions."
        },
        "notes": {
          "type": "string",
          "description": "Any other operational factor that affects the work."
        }
      },
      "default": {},
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "sale_dates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "upcoming",
        "active",
        "completed",
        "archived"
      ],
      "default": "draft",
      "description": "Type-agnostic public/operational sale state. draft is PRIVATE (operator/team/admin only); upcoming/active/completed are the deliberate public listing states; archived is private again."
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "synopsis": {
            "type": "string",
            "description": "AI-generated internal synopsis visible only to the operator. Not shown publicly."
          },
          "rotation": {
            "type": "number",
            "default": 0
          },
          "price": {
            "type": "number"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "skip_item": {
            "type": "boolean",
            "default": false,
            "description": "Marked as 'Don't Search' by user"
          },
          "skip_saved_name": {
            "type": "string",
            "description": "Saved name before skip was toggled"
          },
          "skip_saved_description": {
            "type": "string",
            "description": "Saved description before skip was toggled"
          },
          "skip_updated_at": {
            "type": "string",
            "description": "Timestamp when skip was toggled"
          },
          "skip_serp_search": {
            "type": "boolean",
            "description": "Legacy skip search flag"
          },
          "serp_search_status": {
            "type": "string",
            "description": "Status from SalePhotoReviewStep (search_allowed, do_not_search, etc)"
          },
          "ai_first_search_price": {
            "type": "number",
            "description": "AI-suggested price from initial search"
          },
          "ai_deep_search_price": {
            "type": "number",
            "description": "AI-suggested price from deep search"
          },
          "thumbnail_url": {
            "type": "string",
            "description": "Pre-generated thumbnail URL"
          }
        }
      },
      "description": "Array of image objects with metadata",
      "default": []
    },
    "image_thumbnails": {
      "type": "object",
      "description": "Lightweight map of image index to thumbnail URL (avoids payload issues with large images arrays)",
      "default": {},
      "additionalProperties": {
        "type": "string"
      }
    },
    "featured_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "estimated_value": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Furniture, Art, Jewelry, etc.",
      "default": []
    },
    "total_items": {
      "type": "integer",
      "default": 0
    },
    "estimated_value": {
      "type": "number"
    },
    "actual_revenue": {
      "type": "number",
      "default": 0,
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "commission_rate": {
      "type": "number",
      "description": "Percentage",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "commission_earned": {
      "type": "number",
      "default": 0,
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
