              }
            },
            {
              "data.sale_team": {
                "$in": [
                  "{{user.id}}"
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.status": {
            "$in": [
