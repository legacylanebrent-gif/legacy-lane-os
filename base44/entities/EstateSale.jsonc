      "type": "string",
      "enum": [
        "not_submitted",
        "submitted",
        "indexed",
        "not_indexed",
        "unknown"
      ],
      "default": "not_submitted"
    },
    "website_slug": {
      "type": "string",
      "description": "Company-scoped public routing slug, server-generated, never a replacement for Sale ID."
    },
    "source_deal_id": {
      "type": "string",
      "description": "Activation provenance reference to the pipeline deal."
    },
    "activation": {
      "type": "object",
      "default": {},
      "description": "Immutable activation provenance references; proposal/agreement truth is never copied here.",
      "properties": {
        "deal_id": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string"
        },
        "agreement_id": {
          "type": "string"
        },
        "activated_at": {
          "type": "string",
          "format": "date-time"
        },
        "activated_by": {
          "type": "string"
        },
        "activated_by_name": {
          "type": "string"
        }
      }
    },
    "communication_plan": {
      "type": "object",
      "default": {},
      "description": "Routine client communication preference only; never marketing or SMS consent. Involvement is not client authority.",
      "properties": {
        "primary_contact_id": {
          "type": "string"
        },
        "primary_contact_name": {
          "type": "string"
        },
        "relationship": {
          "type": "string"
        },
        "preferred_method": {
          "type": "string",
          "enum": [
            "EMAIL",
            "SMS",
            "PHONE",
            "OTHER"
          ]
        },
        "cadence": {
          "type": "string",
          "enum": [
            "AS_NEEDED",
            "WEEKLY",
            "TWICE_WEEKLY",
            "MILESTONE",
            "CUSTOM"
          ]
        },
        "update_note": {
          "type": "string"
        }
      }
    },
    "excluded_areas": {
      "type": "array",
      "default": [],
      "description": "Team-safe retained/restricted areas, never credentials. Family deadlines are distinct from team task deadlines.",
      "items": {
        "type": "object",
        "properties": {
          "area_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "room",
              "closet",
              "cabinet",
              "storage",
              "outbuilding",
              "other"
            ],
            "default": "room"
          },
          "note": {
            "type": "string"
          },
          "family_deadline": {
            "type": "string",
            "format": "date"
          },
          "resolved": {
            "type": "boolean",
            "default": false
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "prep_zones": {
      "type": "array",
      "default": [],
      "description": "Canonical team-readable preparation/staging zone registry. Consultation provenance projects room names only. Human-set prep and sale-day states are independent; discovery counts are derived, never stored. Category plans never auto-relocate Items. No credentials or private consultation notes.",
      "items": {
        "type": "object",
        "properties": {
          "zone_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "CONSULTATION_ROOM",
              "EXCLUDED_AREA",
              "MANUAL"
            ],
            "default": "MANUAL"
          },
          "source_id": {
            "type": "string"
          },
          "prep_status": {
            "type": "string",
            "enum": [
              "untouched",
              "sorting",
              "waiting_decision",
              "waiting_research",
              "ready_for_inventory",
              "complete"
            ],
            "default": "untouched"
          },
          "assignee_user_id": {
            "type": "string"
          },
          "assignee_name": {
            "type": "string"
          },
          "access_class": {
            "type": "string",
            "enum": [
              "UNCLASSIFIED",
              "OPEN_TO_CUSTOMERS",
              "STAFF_ONLY",
              "CLOSED_RESTRICTED",
              "PICKUP_ONLY",
              "CHECKOUT"
            ],
            "default": "UNCLASSIFIED"
          },
          "security_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "difficult_to_monitor",
                "high_value_control_needed",
                "customer_flow_concern",
                "other_security_concern"
              ]
            },
            "default": []
          },
          "removal_route_note": {
            "type": "string"
          },
          "protection_note": {
            "type": "string"
          },
          "condition_photo_uri": {
            "type": "string",
            "description": "PRIVATE property-condition photo file_uri; never marketing."
          },
          "notes": {
            "type": "string"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "staging_purpose": {
            "type": "string",
            "enum": [
              "SALE_FLOOR",
              "PREP_ONLY",
              "STORAGE",
              "CHECKOUT",
              "OTHER"
            ]
          },
          "category_plan": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string"
                },
                "intent": {
                  "type": "string",
                  "enum": [
                    "KEEP_HERE",
                    "CONSOLIDATE_TO"
                  ],
                  "default": "KEEP_HERE"
                },
                "target_zone_id": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "signage_needs": {
            "type": "string"
          },
          "equipment_needs": {
            "type": "string"
          },
          "lighting_concern": {
            "type": "string",
            "enum": [
              "ok",
              "insufficient",
              "additional_needed",
              "unknown"
            ],
            "default": "unknown"
          },
          "flow_concerns": {
            "type": "string"
          },
          "staging_notes": {
            "type": "string"
          },
          "sale_day_status": {
            "type": "string",
            "enum": [
              "READY",
              "ACTIVE",
              "DEPLETED",
              "CONSOLIDATE",
              "CLOSED"
            ]
          }
        }
      }
    },
    "customer_flow": {
      "type": "object",
      "default": {},
      "description": "Practical customer path, not CAD, legal occupancy or security certification. Never private access/security credentials.",
      "properties": {
        "entry_note": {
          "type": "string"
        },
        "exit_note": {
          "type": "string"
        },
        "checkout_location": {
          "type": "string"
        },
        "queue_note": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "pickup_plan": {
      "type": "object",
      "default": {},
      "description": "Project-level planning defaults only; canonical transaction/pickup truth remains on Item and checkout.",
      "properties": {
        "pickup_window": {
          "type": "string"
        },
        "pickup_location": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        }
      }
    },
    "entry_management": {
      "type": "object",
      "default": {},
      "description": "Operator-defined entry/capacity procedure, never a fire-code or legal occupancy certification. Absent mode is unknown.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "OPEN_ENTRY",
            "CAPACITY_CONTROLLED"
          ]
        },
        "capacity_target": {
          "type": "integer"
        },
        "one_out_one_in": {
          "type": "boolean",
          "default": false
        },
        "procedure_note": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        }
      }
    },
    "client_day_plan": {
      "type": "object",
      "default": {},
      "description": "Team-safe sale-day client presence/boundaries only. Presence is not authority. No private contact details or notes.",
      "properties": {
        "client_expected": {
          "type": "boolean"
        },
        "expected_time": {
          "type": "string"
        },
        "client_on_site": {
          "type": "boolean"
        },
        "boundaries_note": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        }
      }
    },
    "transition": {
      "type": "object",
      "default": {},
      "description": "Human-approved transition completion, independent of sale-event status or settlement. Canonical records plus approval determine readiness, never this block alone.",
      "properties": {
        "objective": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "enum": [
                "MAXIMIZE_PROCEEDS",
                "MEET_PROPERTY_DEADLINE",
                "CLEAR_PROPERTY",
                "MINIMIZE_ADDITIONAL_WORK",
                "PRESERVE_SPECIFIC_PROPERTY",
                "BALANCED_CUSTOM"
              ]
            },
            "notes": {
              "type": "string"
            },
            "achieved": {
              "type": "string",
              "enum": [
                "YES",
                "PARTIAL",
                "NO"
              ]
            },
            "achieved_note": {
              "type": "string"
            }
          }
        },
        "property_deadline": {
          "type": "object",
          "description": "Absent date means no deadline recorded, not no deadline needed.",
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "deadline_type": {
              "type": "string",
              "enum": [
                "REAL_ESTATE_CLOSING",
                "WALKTHROUGH",
                "MOVE",
                "CLEANING",
                "POSSESSION",
                "TURNOVER",
                "OTHER"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "completion_standard": {
          "type": "object",
          "description": "Agreed engagement scope, never an assumed empty house.",
          "properties": {
            "standard": {
              "type": "string",
              "enum": [
                "SALE_SERVICES_ONLY",
                "POST_SALE_SERVICES",
                "ROOMS_CLEARED",
                "DONATION_COORDINATED",
                "CLEANOUT_COORDINATED",
                "CLEANOUT_COMPLETED",
                "PROPERTY_CLEARED",
                "CUSTOM_AGREED"
              ]
            },
            "requires_item_disposition": {
              "type": "boolean",
              "default": true
            },
            "note": {
              "type": "string"
            }
          }
        },
        "buyout_award": {
          "type": "object",
          "description": "Sanctioned setTransitionEventScope only, requiring client-authorized decision and rejecting protected merchandise.",
          "properties": {
            "buyer_name": {
              "type": "string"
            },
            "offer_amount": {
              "type": "number"
            },
            "conditions_note": {
              "type": "string"
            },
            "decision_id": {
              "type": "string"
            },
            "authorized_by_name": {
              "type": "string"
            },
            "authorized_at": {
              "type": "string",
              "format": "date-time"
            },
            "included_item_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "excluded_item_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "transferred_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "walkthrough": {
          "type": "object",
          "description": "Human area-by-area confirmations; software does not physically inspect. Intentionally remaining merchandise requires an exception reason.",
          "properties": {
            "areas": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "properties": {
                  "area_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "PREP_ZONE",
                      "CUSTOM"
                    ]
                  },
                  "confirmed_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "confirmed_by_name": {
                    "type": "string"
                  },
                  "exception_note": {
                    "type": "string"
                  }
                }
              }
            },
            "condition_note": {
              "type": "string"
            },
            "condition_photo_uri": {
              "type": "string",
              "description": "PRIVATE completion photo file_uri."
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "transition_completed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Human approval through approveTransitionCompletion only; absent means open."
        },
        "completed_by": {
          "type": "string"
        },
        "completed_by_name": {
          "type": "string"
        },
        "approval_note": {
          "type": "string"
        }
      }
    },
    "access_closeout": {
      "type": "object",
      "default": {},
      "description": "Human confirmation of keys/access devices returned, transferred or disabled. No credentials. Absent/unresolved blocks close.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_APPLICABLE",
            "UNRESOLVED",
            "RETURNED",
            "TRANSFERRED",
            "DISABLED"
          ]
        },
        "note": {
          "type": "string"
        },
        "closed_at": {
          "type": "string",
          "format": "date-time"
        },
        "closed_by_name": {
          "type": "string"
        }
      }
    },
    "discount_schedule": {
      "type": "array",
      "default": [],
      "description": "Operator-defined planned guidance only, never automatically applied. Item excluded_from_discounts requires explicit human handling. Printed signs are snapshots, never price changes.",
      "items": {
        "type": "object",
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "start_at": {
            "type": "string",
            "format": "date-time"
          },
          "discount_percent": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "operator_id",
    "property_address"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.sale_team": {
                "$in": [
                  "{{user.id}}"
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.status": {
            "$in": [
              "upcoming",
              "active",
              "completed"
            ]
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.sale_team": {
                "$in": [
                  "{{user.id}}"
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}