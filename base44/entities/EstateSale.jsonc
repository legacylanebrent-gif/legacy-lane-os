                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "national_featured": {
      "type": "boolean",
      "default": false
    },
    "local_featured": {
      "type": "boolean",
      "default": false
    },
    "local_featured_until": {
      "type": "string",
