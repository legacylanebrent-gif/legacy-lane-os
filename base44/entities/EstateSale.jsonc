    "early_sign_in_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether early sign-in list is allowed for this sale"
    },
    "buyout_config": {
      "type": "object",
      "description": "Configuration for buyout events \u2014 only applies when sale_type is buyout_or_cleanout",
      "properties": {
        "bid_deadline": {
          "type": "string",
          "format": "date-time",
          "description": "Deadline for resellers to submit buyout bids"
        },
        "buyout_mode": {
          "type": "string",
          "enum": [
            "full_buyout",
            "cherry_pick"
          ],
          "default": "full_buyout",
          "description": "Full buyout = all or nothing; cherry_pick = resellers can pick individual items"
        },
        "reseller_radius_miles": {
          "type": "integer",
          "default": 25,
          "description": "Marketing radius in miles to notify resellers"
        },
        "minimum_bid": {
          "type": "number",
          "description": "Minimum acceptable buyout bid (whole dollars)"
        },
        "estimated_total_value": {
          "type": "number",
          "description": "Estimated total value of all contents (whole dollars)"
        },
        "inventory_summary": {
          "type": "string",
          "description": "Brief summary of what is included in the buyout"
        },
        "pickup_deadline": {
          "type": "string",
          "format": "date",
          "description": "Deadline for the winning bidder to remove all items"
        },
        "payment_terms": {
          "type": "string",
          "description": "Payment terms for the buyout (e.g. cash, certified check, wire transfer)"
        },
        "reseller_registration_required": {
          "type": "boolean",
          "default": true,
          "description": "Whether resellers must register before bidding"
        },
        "max_reseller_spots": {
          "type": "integer",
          "description": "Maximum number of resellers who can participate"
        },
        "highlights": {
          "type": "string",
          "description": "Notable or high-value items to promote in the buyout listing"
        },
        "cleanout_required": {
          "type": "boolean",
          "default": false,
          "description": "Whether the property must be completely emptied (cleanout)"
        }
      },
      "default": null
    },
    "promoted_to_all_users": {
      "type": "boolean",
      "default": false,
      "description": "Whether this sale is promoted to all platform users"
    },
    "sale_team": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "User IDs of team members assigned to manage this sale",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "seo_title": {
      "type": "string",
      "description": "SEO optimized page title"
    },
    "seo_description": {
      "type": "string",
      "description": "SEO meta description"
    },
    "seo_slug": {
      "type": "string",
      "description": "URL slug for SEO"
    },
    "seo_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "SEO keywords"
    },
    "ai_summary": {
      "type": "string",
      "description": "AI-generated summary of the sale"
    },
    "schema_json": {
      "type": "object",
      "description": "JSON-LD structured data schema"
    },
    "indexed_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "submitted",
        "indexed",
        "not_indexed",
        "unknown"
      ],
      "default": "not_submitted",
      "description": "Google indexing status"
    },
    "website_slug": {
      "type": "string",
      "description": "Public website URL slug (human-readable, normalized, URL-safe; Company-scoped unique; deterministic initial generation with collision-safe ordinal suffixes). Presentation/routing identity ONLY \u2014 never replaces the canonical Sale ID. Generated server-side."
    },
    "source_deal_id": {
      "type": "string",
      "description": "Chapter 13 P1 \u2014 ACTIVATION PROVENANCE: the SaleConversionPipeline deal this active project was activated from. The deal's estate_sale_id link points back here; this field lets the sale itself answer WHERE DID THIS ACTIVE PROJECT COME FROM? even before/without the deal link."
    },
    "activation": {
      "type": "object",
      "default": {},
      "description": "Chapter 13 P1 \u2014 activation provenance snapshot (references only \u2014 immutable snapshot truth stays in the proposal/agreement records and is never copied here): deal, accepted proposal, executed agreement, when, and who activated.",
      "properties": {
        "deal_id": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string",
          "description": "The ACCEPTED SaleProposal at activation time, when one exists (reference, never a copy)."
        },
        "agreement_id": {
          "type": "string",
          "description": "The EXECUTED/READY SaleAgreement at activation time, when one exists (reference, never a copy)."
        },
        "activated_at": {
          "type": "string",
          "format": "date-time"
        },
        "activated_by": {
          "type": "string"
        },
        "activated_by_name": {
          "type": "string"
        }
      }
    },
    "communication_plan": {
      "type": "object",
      "default": {},
      "description": "Chapter 13 P1 \u2014 the project's CLIENT COMMUNICATION PLAN: primary communication contact, preferred method, and update cadence. This is OPERATIONAL PREFERENCE ONLY \u2014 it is NEVER marketing consent, and an SMS preference is NEVER SMS marketing consent. Customer.io / marketing consent state is never created or changed by this field.",
      "properties": {
        "primary_contact_id": {
          "type": "string",
          "description": "Optional canonical Contact link for the primary communication contact."
        },
        "primary_contact_name": {
          "type": "string",
          "description": "Who the operator communicates with routinely (client or family member). INVOLVEMENT IS NOT AUTHORITY \u2014 the authorized decision-makers live in SaleAuthority."
        },
        "relationship": {
          "type": "string",
          "description": "Relationship to the client/estate (e.g. daughter, executor, attorney)."
        },
        "preferred_method": {
          "type": "string",
          "enum": [
            "EMAIL",
            "SMS",
            "PHONE",
            "OTHER"
          ],
          "description": "How this contact prefers routine project updates. PREFERENCE \u2260 CONSENT \u2014 it never opts anyone into marketing."
        },
        "cadence": {
          "type": "string",
          "enum": [
            "AS_NEEDED",
            "WEEKLY",
            "TWICE_WEEKLY",
            "MILESTONE",
            "CUSTOM"
          ],
          "description": "How often the operator committed to updating the client. Informs the human (and optional client-update tasks); nothing is auto-sent."
        },
        "update_note": {
          "type": "string",
          "description": "Custom cadence / context in the operator's words."
        }
      }
    },
    "excluded_areas": {
      "type": "array",
      "default": [],
      "description": "Chapter 13 P1 \u2014 areas EXCLUDED / RESTRICTED FROM SALE (rooms, closets, cabinets, storage, outbuildings the client retains or restricts). TEAM-SAFE by design: names and notes only \u2014 never access codes or credentials (those live in the operator-only site_assessment.access_details). Deliberately on the sale (team-readable), not the operator-private consultation deal.",
      "items": {
        "type": "object",
        "properties": {
          "area_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Area name (e.g. Primary bedroom closet, Garage workshop, Attic)."
          },
          "type": {
            "type": "string",
            "enum": [
              "room",
              "closet",
              "cabinet",
              "storage",
              "outbuilding",
              "other"
            ],
            "default": "room"
          },
          "note": {
            "type": "string",
            "description": "Why it is excluded / handling notes (team-safe, no codes)."
          },
          "family_deadline": {
            "type": "string",
            "format": "date",
            "description": "Chapter 13 P1 \u2014 CLIENT/FAMILY ACTION DEADLINE: the date the family committed to handle this area by (e.g. remove retained items). Deliberately distinct from any team task due date \u2014 this is the family's own commitment, surfaced on the timeline, never a scheduling engine."
          },
          "resolved": {
            "type": "boolean",
            "default": false,
            "description": "Family/owner confirmed the area is handled."
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "prep_zones": {
      "type": "array",
      "default": [],
      "description": "Chapter 14 P1 \u2014 TEAM-READABLE PREP ZONES (rooms / work areas) for preparation. Same projection pattern as excluded_areas: deliberately ON THE SALE (team-readable), NOT on the operator-private Chapter 12 consultation deal. source_type/source_id preserves provenance back to the consultation room a zone originated from WITHOUT exposing private consultation content \u2014 only the room NAME is projected, so the two never drift independently. Zone notes are TEAM-SAFE (no codes/credentials). Prep status is honest human-set state \u2014 no percentage progress anywhere. Discovery counts are DERIVED at read time from SaleDiscovery records, never stored here. Chapter 17 P1 extends the SAME zone with the smallest staging layer (purpose, category plan, signage/equipment needs, lighting/flow concerns, staging notes, and a sale-day status that NEVER overwrites Chapter 14 preparation truth) \u2014 there is NO second room/staging system. Chapter 22 P1: prep zones are also the suggested room list for the FINAL WALKTHROUGH (human confirmations recorded in transition.walkthrough).",
      "items": {
        "type": "object",
        "properties": {
          "zone_id": {
            "type": "string",
            "description": "Stable zone identifier (referenced by SaleDiscovery.zone_id, Item.zone_id, and work-zone QR signs)."
          },
          "name": {
            "type": "string",
            "description": "Zone/room name (Living Room, Basement, Garage, Attic...)."
          },
          "source_type": {
            "type": "string",
            "enum": [
              "CONSULTATION_ROOM",
              "EXCLUDED_AREA",
              "MANUAL"
            ],
            "default": "MANUAL",
            "description": "Chapter 14 P1-7 \u2014 where this zone came from."
          },
          "source_id": {
            "type": "string",
            "description": "Provenance reference (consultation room_id) when source_type is CONSULTATION_ROOM."
          },
          "prep_status": {
            "type": "string",
            "enum": [
              "untouched",
              "sorting",
              "waiting_decision",
              "waiting_research",
              "ready_for_inventory",
              "complete"
            ],
            "default": "untouched",
            "description": "Chapter 14 P1-8 \u2014 deterministic preparation state, human-set. WAITING states pair with the canonical open decision/research records; never a percentage. Chapter 17 P1: PREPARATION truth \u2014 the separate sale_day_status carries the sale-day operational state and this history is never overwritten."
          },
          "assignee_user_id": {
            "type": "string",
            "description": "User ID of the responsible team member. Work assignment itself reuses SaleTask (ASSIGN WORK creates a task) \u2014 this is the zone-level responsibility display."
          },
          "assignee_name": {
            "type": "string",
            "description": "Assignee display-name snapshot."
          },
          "access_class": {
            "type": "string",
            "enum": [
              "UNCLASSIFIED",
              "OPEN_TO_CUSTOMERS",
              "STAFF_ONLY",
              "CLOSED_RESTRICTED",
              "PICKUP_ONLY",
              "CHECKOUT"
            ],
            "default": "UNCLASSIFIED",
            "description": "Chapter 14 P1-37 \u2014 customer access plan for this area. Reuses the Chapter 8/13 security walkthrough; UNCLASSIFIED is the honest default, never guessed."
          },
          "security_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "difficult_to_monitor",
                "high_value_control_needed",
                "customer_flow_concern",
                "other_security_concern"
              ]
            },
            "default": [],
            "description": "Chapter 14 P1-38 \u2014 sightline/security attention flags. Planning aids only \u2014 never a claim of surveillance or safety."
          },
          "removal_route_note": {
            "type": "string",
            "description": "Chapter 14 P1-41 \u2014 large-item removal route / special concern for this zone. Chapter 21 transaction/pickup state is untouched."
          },
          "protection_note": {
            "type": "string",
            "description": "Chapter 14 P1-39 \u2014 property-protection concern for this zone (floors, walls, doors, stairs, landscaping, architectural features)."
          },
          "condition_photo_uri": {
            "type": "string",
            "description": "Chapter 14 P1-40 \u2014 PRIVATE pre-sale property-condition photo (private storage; viewed via short-lived signed URL). NEVER public gallery or marketing."
          },
          "notes": {
            "type": "string",
            "description": "Team-safe prep notes (no codes/credentials)."
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "description": "When prep_status was set to complete."
          },
          "staging_purpose": {
            "type": "string",
            "enum": [
              "SALE_FLOOR",
              "PREP_ONLY",
              "STORAGE",
              "CHECKOUT",
              "OTHER"
            ],
            "description": "Chapter 17 P1-1 \u2014 the zone's role in the temporary retail environment. Absent = not yet planned (honest unknown)."
          },
          "category_plan": {
            "type": "array",
            "default": [],
            "description": "Chapter 17 P1-7 \u2014 PLANNING intent for merchandise categories in this zone. A PLAN ONLY: Item locations change only when merchandise physically moves; nothing is ever auto-relocated. References the existing Item.category vocabulary \u2014 no competing category truth.",
            "items": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string",
                  "description": "Existing Item category (or 'other')."
                },
                "intent": {
                  "type": "string",
                  "enum": [
                    "KEEP_HERE",
                    "CONSOLIDATE_TO"
                  ],
                  "default": "KEEP_HERE",
                  "description": "Keep this category displayed here, or plan to consolidate it into another zone."
                },
                "target_zone_id": {
                  "type": "string",
                  "description": "Destination zone when intent is CONSOLIDATE_TO (planning reference only)."
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "signage_needs": {
            "type": "string",
            "description": "Chapter 17 P1-1 \u2014 signs this zone needs (category, directional, restricted...). Team-safe."
          },
          "equipment_needs": {
            "type": "string",
            "description": "Chapter 17 P1-1 \u2014 tables/racks/lighting equipment this zone needs (actual equipment truth stays in SaleEquipmentAssignment \u2014 this is the plan)."
          },
          "lighting_concern": {
            "type": "string",
            "enum": [
              "ok",
              "insufficient",
              "additional_needed",
              "unknown"
            ],
            "default": "unknown",
            "description": "Chapter 17 P1 \u2014 honest lighting state for merchandising visibility. unknown until assessed; never a claim the space is safe or code-compliant."
          },
          "flow_concerns": {
            "type": "string",
            "description": "Chapter 17 P1-4/P1-5 \u2014 customer-flow / bottleneck observations for this zone (narrow passage, doorway, stairs, queue conflict, removal conflict). Team-safe; never access codes."
          },
          "staging_notes": {
            "type": "string",
            "description": "Chapter 17 P1-1 \u2014 team-safe staging notes. NEVER private consultation content, codes, or credentials (those stay in the operator-only consultation deal / access plan)."
          },
          "sale_day_status": {
            "type": "string",
            "enum": [
              "READY",
              "ACTIVE",
              "DEPLETED",
              "CONSOLIDATE",
              "CLOSED"
            ],
            "description": "Chapter 17 P1-37 \u2014 SALE-DAY operational state, deliberately a SEPARATE field from prep_status so Chapter 14 preparation history is never overwritten. Absent = pre-opening / not applicable. Human-set; marking CONSOLIDATE never auto-moves Items."
          }
        }
      }
    },
    "customer_flow": {
      "type": "object",
      "default": {},
      "description": "Chapter 17 P1-3/P1-4 \u2014 the sale's practical CUSTOMER PATH: entry, exit, checkout location, and queue notes. Operational strings only \u2014 NOT floor-plan/CAD architecture, and NEVER private access/security details (those stay in the operator-only site_assessment.access_details). Safe buyer-facing subsets of this plan may render on the public sale guide.",
      "properties": {
        "entry_note": {
          "type": "string",
          "description": "Where customers enter (e.g. 'Front porch door')."
        },
        "exit_note": {
          "type": "string",
          "description": "Where customers exit / where large purchases leave (e.g. 'Side door to driveway')."
        },
        "checkout_location": {
          "type": "string",
          "description": "Where checkout is set up (e.g. 'Dining room table by the stairs')."
        },
        "queue_note": {
          "type": "string",
          "description": "Where the line should form and what it must not block."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "pickup_plan": {
      "type": "object",
      "default": {},
      "description": "Chapter 13 P1 \u2014 project-level DEFAULT large-item pickup plan (window/location/instructions) for buyer pickups. A planning default only: Chapter 21 transaction truth stays on Item records and checkout \u2014 this plan never alters it.",
      "properties": {
        "pickup_window": {
          "type": "string",
          "description": "Default pickup window (e.g. 'Sat 3pm\u20135pm, Sun 12pm\u20134pm')."
        },
        "pickup_location": {
          "type": "string",
          "description": "Where buyers pick up (e.g. 'Side driveway, 2nd garage door')."
        },
        "instructions": {
          "type": "string",
          "description": "Default pickup instructions for buyers."
        }
      }
    },
    "entry_management": {
      "type": "object",
      "default": {},
      "description": "Chapter 20 P1-8/P1-9 \u2014 the sale's ENTRY OPERATING MODE and capacity PROCEDURE, operator-defined. This is the operator's own procedure \u2014 NEVER a legal or fire-code occupancy certification, and capacity_target is the operator's own working number, not a code limit. Team-visible (shown to the entry staffer in My Sale Day). Absent mode = not yet decided (honest unknown).",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "OPEN_ENTRY",
            "CAPACITY_CONTROLLED"
          ],
          "description": "OPEN_ENTRY = customers enter freely. CAPACITY_CONTROLLED = the operator manages the flow per the procedure below."
        },
        "capacity_target": {
          "type": "integer",
          "description": "Operator's own working target for approximate people inside at once (operator procedure \u2014 never a code/legal capacity)."
        },
        "one_out_one_in": {
          "type": "boolean",
          "default": false,
          "description": "Operator procedure: one-out-one-in when the target is reached."
        },
        "procedure_note": {
          "type": "string",
          "description": "The operator's entry procedure in their own words (group entry, stroller/bag rules, line management...)."
        },
        "instructions": {
          "type": "string",
          "description": "Any other team-facing entry instructions (team-safe \u2014 no access codes; those stay in the operator-only access plan)."
        }
      }
    },
    "client_day_plan": {
      "type": "object",
      "default": {},
      "description": "Chapter 20 P1-53/P1-55 \u2014 the sale-day CLIENT PRESENCE PLAN: whether the client/family is expected or on site, and TEAM-SAFE sale-day instructions/boundaries. Deliberately holds NO private contact information (routine communication identity lives in communication_plan; private notes stay private) \u2014 only what the team operationally needs: CLIENT EXPECTED / CLIENT ON SITE plus the operator's team-safe instructions. A client's presence is NEVER client authority (decision-makers live in SaleAuthority; Chapter 19 P0 decision enforcement is untouched).",
      "properties": {
        "client_expected": {
          "type": "boolean",
          "description": "The client/family is expected to visit during the sale."
        },
        "expected_time": {
          "type": "string",
          "description": "When they are expected (free text \u2014 'Sat morning', 'after 1pm')."
        },
        "client_on_site": {
          "type": "boolean",
          "description": "Operator-set: the client is currently on site. Team-visible operational fact only."
        },
        "boundaries_note": {
          "type": "string",
          "description": "Team-safe boundaries while the client is present (merchandise conversations, pricing involvement, private areas) \u2014 stated so any staffer can read it. No private client notes."
        },
        "instructions": {
          "type": "string",
          "description": "Other team-safe sale-day instructions tied to the client visit (e.g. 'let the operator know when they arrive')."
        }
      }
    },
    "transition": {
      "type": "object",
      "default": {},
      "description": "Chapter 22 P1 \u2014 the sale's TRANSITION COMPLETION block: the client's objective, the property deadline that drives the project, what FINISHED means for this engagement, the final human-verified walkthrough, the buyout award, and the human completion approval. SALE COMPLETE \u2260 TRANSITION COMPLETE: the sale event ends (status) and financial settlement finalizes independently; this block records when the PROPERTY TRANSITION itself concluded \u2014 a conclusion the system supports only after required obligations have endings (approveTransitionCompletion gate). Completion is DERIVED from canonical records plus human approval \u2014 this block stores the human-approved conclusion and planning inputs, never a parallel truth store.",
      "properties": {
        "objective": {
          "type": "object",
          "description": "The client's actual transition objective \u2014 THE CLIENT'S OBJECTIVE DEFINES SUCCESS. 'Everything gone' is not a scope.",
          "properties": {
            "key": {
              "type": "string",
              "enum": [
                "MAXIMIZE_PROCEEDS",
                "MEET_PROPERTY_DEADLINE",
                "CLEAR_PROPERTY",
                "MINIMIZE_ADDITIONAL_WORK",
                "PRESERVE_SPECIFIC_PROPERTY",
                "BALANCED_CUSTOM"
              ]
            },
            "notes": {
              "type": "string",
              "description": "The objective in the client's/operator's own words \u2014 nuance is never reduced to the enum."
            },
            "achieved": {
              "type": "string",
              "enum": [
                "YES",
                "PARTIAL",
                "NO"
              ],
              "description": "Operator-recorded honest judgment on whether the objective was achieved (recorded at/after completion)."
            },
            "achieved_note": {
              "type": "string"
            }
          }
        },
        "property_deadline": {
          "type": "object",
          "description": "The real project-driving property deadline (closing, walkthrough, move, cleaning, possession, turnover). Absent date = NO DEADLINE RECORDED \u2014 unknown stays unknown, never silently 'no deadline needed'.",
          "properties": {
            "date": {
              "type": "string",
              "format": "date"
            },
            "deadline_type": {
              "type": "string",
              "enum": [
                "REAL_ESTATE_CLOSING",
                "WALKTHROUGH",
                "MOVE",
                "CLEANING",
                "POSSESSION",
                "TURNOVER",
                "OTHER"
              ]
            },
            "note": {
              "type": "string",
              "description": "Source/context of the deadline."
            }
          }
        },
        "completion_standard": {
          "type": "object",
          "description": "What FINISHED means for THIS project \u2014 tied back to the accepted SaleScope, never an assumed 'empty house'.",
          "properties": {
            "standard": {
              "type": "string",
              "enum": [
                "SALE_SERVICES_ONLY",
                "POST_SALE_SERVICES",
                "ROOMS_CLEARED",
                "DONATION_COORDINATED",
                "CLEANOUT_COORDINATED",
                "CLEANOUT_COMPLETED",
                "PROPERTY_CLEARED",
                "CUSTOM_AGREED"
              ]
            },
            "requires_item_disposition": {
              "type": "boolean",
              "default": true,
              "description": "Whether every remaining tracked item must have a recorded disposition/reason before completion (NOTHING IS LEFTOVER \u2014 everything has a next status)."
            },
            "note": {
              "type": "string"
            }
          }
        },
        "buyout_award": {
          "type": "object",
          "description": "Chapter 22 P0-9 \u2014 the accepted BUYOUT on this sale's remaining merchandise, written ONLY through the sanctioned setTransitionEventScope path (client-authorized decision required; protected merchandise is structurally rejected from the included list).",
          "properties": {
            "buyer_name": {
              "type": "string"
            },
            "offer_amount": {
              "type": "number"
            },
            "conditions_note": {
              "type": "string"
            },
            "decision_id": {
              "type": "string",
              "description": "Canonical SaleClientDecision evidencing client approval of this buyout."
            },
            "authorized_by_name": {
              "type": "string"
            },
            "authorized_at": {
              "type": "string",
              "format": "date-time"
            },
            "included_item_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "excluded_item_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "transferred_at": {
              "type": "string",
              "format": "date-time",
              "description": "When the bulk transfer physically completed (absent = not transferred)."
            }
          }
        },
        "walkthrough": {
          "type": "object",
          "description": "Chapter 22 P1 \u2014 the FINAL WALKTHROUGH: area-by-area HUMAN confirmations (software records the operator's confirmation; software does NOT claim it physically inspected anything). Anything intentionally remaining carries a reason.",
          "properties": {
            "areas": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "properties": {
                  "area_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "PREP_ZONE",
                      "CUSTOM"
                    ]
                  },
                  "confirmed_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "confirmed_by_name": {
                    "type": "string"
                  },
                  "exception_note": {
                    "type": "string",
                    "description": "Why something intentionally remains here (BUYER PICKUP / CLIENT RETAINED / DONATION PENDING / PROVIDER PENDING / SPECIALIST / OUTSIDE SCOPE / OTHER EXPLAINED)."
                  }
                }
              }
            },
            "condition_note": {
              "type": "string",
              "description": "Factual final property-condition observations (walls, floors, stairs, doors...). Never an inspection claim."
            },
            "condition_photo_uri": {
              "type": "string",
              "description": "PRIVATE completion photo (private storage file_uri; viewed via short-lived signed URL)."
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "transition_completed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Human-approved TRANSITION COMPLETE conclusion (written by approveTransitionCompletion after all required obligations have endings). Absent = TRANSITION OPEN."
        },
        "completed_by": {
          "type": "string"
        },
        "completed_by_name": {
          "type": "string"
        },
        "approval_note": {
          "type": "string"
        }
      }
    },
    "discount_schedule": {
      "type": "array",
      "default": [],
      "description": "Chapter 16 P1-39/P1-40 \u2014 the operator's PLANNED discount stages for this sale (Day 1 full price, Day 2, final hours...). OPERATOR-DEFINED PLAN ONLY: the system never applies a discount automatically; a stage is guidance for the team, and an Item marked excluded_from_discounts is never silently discounted \u2014 applying a stage to such an item is an explicit human price change through the normal price-change path (changeItemPrice), never a batch effect. Chapter 17 P1: discount SIGNS may be printed from this plan \u2014 a printed sign is a SNAPSHOT and never modifies Item.price. Chapter 20 P1-25/P1-26: checkout and the Live Sale Command Center DISPLAY the current stage as cashier guidance; a human still applies any authorized discount.",
      "items": {
        "type": "object",
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Stage name (e.g. 'Day 2', 'Final Hours')."
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the stage begins (optional)."
          },
          "discount_percent": {
            "type": "number",
            "description": "Planned percent off the current price at this stage."
          },
          "note": {
            "type": "string",
            "description": "Operator note (e.g. 'Everything except jewelry and the dining set')."
          }
        }
      }
    }
  },
  "required": [
    "title",
    "operator_id",
    "property_address"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.sale_team": {
                "$in": [
                  "{{user.id}}"
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.status": {
            "$in": [
              "upcoming",
              "active",
              "completed"
            ]
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.sale_team": {
                "$in": [
                  "{{user.id}}"
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}