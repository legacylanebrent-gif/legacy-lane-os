    "saves": {
      "type": "integer",
      "default": 0
    },
    "premium_listing": {
      "type": "boolean",
      "default": false
    },
    "payment_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "cash",
        "credit_card",
        "venmo"
      ]
    },
    "special_notes": {
      "type": "string"
    },
    "parking_info": {
      "type": "string"
    },
    "referral_source_type": {
      "type": "string",
      "enum": [
        "real_estate_agent",
        "attorney",
        "senior_move_manager",
        "professional_organizer",
        "estate_sale_company",
        "past_client",
        "buyer_customer",
        "friend_family",
        "online_search",
        "social_media",
        "website",
        "other"
      ],
      "description": "Projection from the linked pipeline deal; the deal remains the capture point.",
      "rls": {
        "read": {
          "$or": [
            {
