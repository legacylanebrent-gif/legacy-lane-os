{
  "name": "MasterReferralAgreement",
  "type": "object",
  "description": "Legacy referral exchange master participation agreement (electronic signature). Referral Rebuild Phase 1B: signatures are created ONLY through the sanctioned signMasterReferralAgreement backend function, which binds the AUTHENTICATED user (server-side identity), a SERVER-GENERATED timestamp, and the SERVER-PINNED terms version \u2014 a client can never assert a timestamp, a different terms version, an executed status, or someone else's signature. Direct client creation is closed (admin-only RLS). A signed acknowledgement is NOT verified licensing, broker approval, or an executed brokerage referral agreement. Historical records are preserved unchanged; a null terms_version means 'version not recorded' (pre-versioning historical record) and is NEVER backfilled or upgraded.",
  "properties": {
    "agreement_id": {
      "type": "string",
      "description": "Unique agreement identifier"
    },
    "user_id": {
      "type": "string",
      "description": "User ID of the signer (server-derived from the authenticated session)"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "agent",
        "Estate Sale Company Owner"
      ],
      "description": "Whether the signer is an agent or Estate Sale Company Owner"
    },
    "signed_name": {
      "type": "string",
      "description": "Full name as entered at signature"
    },
    "signed_email": {
      "type": "string",
      "description": "Email at time of signing (server-derived from the authenticated user)"
    },
    "signed_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "SERVER-GENERATED timestamp when the agreement was accepted"
    },
    "signed_ip": {
      "type": "string",
      "description": "IP address at time of signing (best-effort from request headers; may be empty)"
    },
    "terms_version": {
      "type": "string",
      "description": "The EXACT terms version the signer acknowledged (pinned server-side at signing time by signMasterReferralAgreement). Changing the displayed terms requires bumping this server constant; a signature never silently covers a different version. Null on historical records = version not recorded \u2014 never backfilled."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active",
      "description": "Current status of the agreement"
    }
  },
  "required": [
    "user_id",
    "user_type",
    "signed_name",
    "signed_email",
    "signed_timestamp",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}