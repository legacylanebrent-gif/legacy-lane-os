{
  "name": "MasterReferralAgreement",
  "type": "object",
  "description": "Legacy referral exchange master participation agreement (self-signed electronic signature). Referral Rebuild Phase 1: a user may read only their own signed agreements and may create (sign) only an agreement for THEMSELVES; revocation and all other mutations are admin-only. Signed agreements are historical records and are preserved unchanged.",
  "properties": {
    "agreement_id": {
      "type": "string",
      "description": "Unique agreement identifier"
    },
    "user_id": {
      "type": "string",
      "description": "User ID of the signer"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "agent",
        "Estate Sale Company Owner"
      ],
      "description": "Whether the signer is an agent or Estate Sale Company Owner"
    },
    "signed_name": {
      "type": "string",
      "description": "Full name as entered at signature"
    },
    "signed_email": {
      "type": "string",
      "description": "Email at time of signing"
    },
    "signed_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when agreement was signed"
    },
    "signed_ip": {
      "type": "string",
      "description": "IP address at time of signing"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active",
      "description": "Current status of the agreement"
    }
  },
  "required": [
    "user_id",
    "user_type",
    "signed_name",
    "signed_email",
    "signed_timestamp",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}