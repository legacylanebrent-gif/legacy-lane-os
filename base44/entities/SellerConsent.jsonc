{
  "name": "SellerConsent",
  "type": "object",
  "description": "Versioned seller introduction consent. Production rollout remains disabled. Requests received by staff are unverified reports in SellerConsentWithdrawalEvent and do not change consent. Only the explicitly designated administrator may confirm a relay through withdrawSellerConsent; its single-record conditional update appends withdrawal_history and changes status together. Queued notices never prove delivery. Historical fields and records are preserved. No compensation entitlement. Unique creation and cross-record transactions are not supported; initial-create concurrency remains an activation blocker.",
  "properties": {
    "consent_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "estate_transition_lead",
        "partner_referred_inquiry",
        "website_lead",
        "manual"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "submission_id": {
      "type": "string"
    },
    "submission_identity": {
      "type": "string",
      "description": "Private server-derived SHA-256 of normalized seller information and operator/referrer scope. Never supplied by callers."
    },
    "operator_id": {
      "type": "string"
    },
    "intended_recipient_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Intended audience only. Not evidence of delivery or withdrawal authority."
    },
    "contact_purpose": {
      "type": "string",
      "enum": [
        "introduction_only",
        "other"
      ],
      "default": "introduction_only"
    },
    "consent_text_version": {
      "type": "string"
    },
    "consent_text_snapshot": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "attribution_source": {
      "type": "string"
    },
    "marketing_consent": {
      "type": "object",
      "default": {},
      "description": "Separate optional marketing permission; introduction withdrawal never changes this block.",
      "properties": {
        "granted": {
          "type": "boolean"
        },
        "scope_note": {
          "type": "string"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "withdrawn_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server confirmation time. Historical relay timestamps are preserved until explicitly reverified."
    },
    "withdrawal_reason": {
      "type": "string",
      "description": "Historical reason preserved; new relay notes are minimal evidence references, never private documents."
    },
    "withdrawn_by": {
      "type": "string"
    },
    "withdrawn_by_name": {
      "type": "string"
    },
    "withdrawal_confirmation": {
      "type": "object",
      "description": "Server-derived designated-administrator confirmation, not an operator report. No default, so absence can be checked atomically.",
      "properties": {
        "event_type": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "actor_id": {
          "type": "string"
        },
        "actor_name": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "consent_record_id": {
          "type": "string"
        },
        "consent_id": {
          "type": "string"
        },
        "verification_method": {
          "type": "string"
        },
        "verification_reference": {
          "type": "string"
        },
        "representative_authority_verified": {
          "type": "boolean"
        }
      }
    },
    "withdrawal_history": {
      "type": "array",
      "default": [],
      "description": "Append-only confirmation audit, appended in the SAME atomic write as withdrawal state. Earlier entries never replaced by sanctioned functions.",
      "items": {
        "type": "object"
      }
    },
    "processing_lock": {
      "type": "boolean",
      "default": false
    },
    "processing_locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "processing_version": {
      "type": "integer",
      "default": 0
    },
    "propagation_lock": {
      "type": "boolean",
      "default": false
    },
    "propagation_locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "downstream_notifications": {
      "type": "array",
      "default": [],
      "description": "Historical queued/failed log, never overwritten. New attempts are append-only SellerConsentWithdrawalEvent records. Queued is not delivery.",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "recipient_user_id": {
            "type": "string"
          },
          "notification_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "failed"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "intake_tracking": {
      "type": "object",
      "default": {},
      "properties": {
        "submission_id": {
          "type": "string"
        },
        "consent_status": {
          "type": "string",
          "enum": [
            "granted",
            "storage_failed"
          ]
        },
        "intake_status": {
          "type": "string",
          "enum": [
            "completed"
          ]
        },
        "lead_id": {
          "type": "string"
        },
        "deal_id": {
          "type": "string"
        },
        "forwarding_status": {
          "type": "string",
          "enum": [
            "pending",
            "completed",
            "retry_required"
          ]
        },
        "forwarding_attempts": {
          "type": "integer",
          "default": 0
        },
        "last_attempt_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_error": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "granted",
        "withdrawn"
      ],
      "default": "granted"
    }
  },
  "required": [
    "consent_id",
    "source_type",
    "source_id",
    "operator_id",
    "consent_text_version",
    "consent_text_snapshot",
    "submitted_at",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.intended_recipient_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    },
    "update": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    },
    "delete": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    }
  }
}