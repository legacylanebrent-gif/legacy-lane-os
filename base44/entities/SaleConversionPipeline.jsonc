{
  "name": "SaleConversionPipeline",
  "type": "object",
  "description": "Canonical PRE-SALE opportunity record and, once linked, the settlement/commission agreement record. Chapter 4 P1 adds the pre-sale economics block: contractual minimum fee, expected additional service revenue, category-level estimated labor, estimated direct costs, and the operator's internal minimum-revenue/minimum-contribution thresholds. Projected figures are estimates for evaluation only \u2014 authoritative actuals derive from settlement/closeout. Chapter 5 P1 adds the operational distance snapshot (distance_miles, projected from the linked EstateSale when the sale already carries one) and the structured client-fit assessment that feeds the Sale Acceptance Scorecard as advisory, explainable input. Chapter 9 P1 adds the client-facing estimated sale RANGE (low/high \u2014 never auto-invented from a single estimate), the owner-time flag on projected labor rows, and ACCEPTED COMMERCIAL TERMS metadata: the deal remains the ONE settlement-facing source of commercial truth, and commercial_terms_accepted_at records when the client accepted it \u2014 the accepted_terms_snapshot preserves exactly what was accepted so later deal edits never rewrite accepted history. Chapter 10 P1 adds CRM DISCIPLINE to this same record (no second CRM): a canonical NEXT ACTION (what happens next, when \u2014 deterministic seed from an inquiry, operator-owned thereafter), distinct OUTCOME stages (CONTACTED progression; NURTURE = not ready but not lost; REFERRED = directed elsewhere with destination/provenance; LOST with a structured reason), INQUIRY PROVENANCE (source system, source record, inquiry timestamp, first meaningful HUMAN response timestamp), and an optional client Contact link for exact-identity continuity. Inquiry capture NEVER grants marketing consent; consent lives only where it was explicitly captured.",
  "properties": {
    "operator_id": {
      "type": "string",
      "description": "Estate Sale Company Owner user ID \u2014 the ACCOUNTABLE OWNER of this opportunity (operational ownership, not just security ownership)."
    },
    "lead_id": {
      "type": "string",
      "description": "Linked Lead entity ID (optional)"
    },
    "estate_sale_id": {
      "type": "string",
      "description": "Linked EstateSale entity ID once created"
    },
    "stage": {
      "type": "string",
      "enum": [
        "new_lead",
        "contacted",
        "consultation_scheduled",
        "contract_signed",
        "setup_in_progress",
        "sale_live",
        "completed",
        "lost",
        "referred",
        "nurture"
      ],
      "default": "new_lead",
      "description": "Chapter 10 P1 \u2014 progression AND outcome truth on one axis. new_lead \u2192 contacted \u2192 consultation_scheduled \u2192 contract_signed \u2192 setup_in_progress \u2192 sale_live \u2192 completed (WON). Terminal outcomes are DISTINCT by design: lost (with structured lost_reason), referred (Chapter 10: the family was directed to a more appropriate professional/service \u2014 NOT lost; see referred_* provenance), nurture (Chapter 10: legitimate opportunity, not ready now, future relationship stays active \u2014 NOT lost, NOT stale, and excluded from immediate active-work views). NOT READY IS NOT LOST. REFERRED IS NOT LOST."
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_contact_id": {
      "type": "string",
      "description": "Chapter 10 P1 \u2014 optional canonical Contact link for the seller PERSON (exact-identity continuity across inquiries and future engagements). Linked by exact email/phone match at bridge time; never fuzzy-merged. The deal fields above remain the operational snapshot."
    },
    "property_address": {
      "type": "string"
    },
    "property_city": {
      "type": "string"
    },
    "property_state": {
      "type": "string"
    },
    "situation": {
      "type": "string",
      "enum": [
        "probate",
        "divorce",
        "downsizing",
        "relocation",
        "foreclosure",
        "standard"
      ]
    },
    "distance_miles": {
      "type": "number",
      "description": "Chapter 5 P1 \u2014 operational distance snapshot from the operator's operating base to this project at the time it was captured (projected from the linked EstateSale's own snapshot when linked). Null = UNKNOWN; the system never invents 0-mile precision. Historical snapshots are not silently recalculated when the operating base changes."
    },
    "distance_calculated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 5 P1 \u2014 when the distance snapshot was captured."
    },
    "client_fit": {
      "type": "object",
      "description": "Chapter 5 P1 \u2014 structured client-fit assessment: OBSERVABLE PROJECT CONDITIONS (not personality, psychology, or character judgments). Advisory input to the existing Sale Acceptance Scorecard; it never auto-accepts or auto-rejects a client. Each dimension is rated good/caution/concern/unknown (unknown until assessed).",
      "properties": {
        "communication": {
          "type": "string",
          "enum": [
            "good",
            "caution",
            "concern",
            "unknown"
          ],
          "default": "unknown"
        },
        "authority_clarity": {
          "type": "string",
          "enum": [
            "good",
            "caution",
            "concern",
            "unknown"
          ],
          "default": "unknown"
        },
        "expectation_realism": {
          "type": "string",
          "enum": [
            "good",
            "caution",
            "concern",
            "unknown"
          ],
          "default": "unknown"
        },
        "deadline_realism": {
          "type": "string",
          "enum": [
            "good",
            "caution",
            "concern",
            "unknown"
          ],
          "default": "unknown"
        },
        "responsiveness": {
          "type": "string",
          "enum": [
            "good",
            "caution",
            "concern",
            "unknown"
          ],
          "default": "unknown"
        },
        "family_complexity": {
          "type": "string",
          "enum": [
            "good",
            "caution",
            "concern",
            "unknown"
          ],
          "default": "unknown"
        },
        "scope_stability": {
          "type": "string",
          "enum": [
            "good",
            "caution",
            "concern",
            "unknown"
          ],
          "default": "unknown"
        },
        "property_access": {
          "type": "string",
          "enum": [
            "good",
            "caution",
            "concern",
            "unknown"
          ],
          "default": "unknown"
        },
        "notes": {
          "type": "string",
          "description": "Optional context where it matters. Not required for every dimension."
        }
      },
      "default": {}
    },
    "estimated_value": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 projected GROSS merchandise sales for this sale (pre-sale estimate). Gross is client merchandise proceeds, NOT company revenue. Chapter 9 P1: serves as the current working estimate / midpoint; the client-facing RANGE lives in estimated_value_low/high when the operator supplies it."
    },
    "estimated_value_low": {
      "type": "number",
      "description": "Chapter 9 P1 \u2014 LOW end of the client-facing estimated sale range. Optional and operator-supplied only: the system NEVER invents a range from a single estimate. Null = range UNKNOWN until the operator supplies it. AN ESTIMATE IS A PLANNING TOOL, NOT A PROMISE."
    },
    "estimated_value_high": {
      "type": "number",
      "description": "Chapter 9 P1 \u2014 HIGH end of the client-facing estimated sale range. Optional and operator-supplied only; null = range UNKNOWN."
    },
    "commission_rate": {
      "type": "number",
      "default": 35,
      "description": "Contract commission rate (percent of gross merchandise sales)."
    },
    "minimum_fee": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 contractual MINIMUM company fee. Company fee due = MAX(calculated commission, this minimum). Distinct from the operator's internal minimum-revenue threshold (min_company_revenue_threshold)."
    },
    "expected_service_revenue": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 anticipated ADDITIONAL authorized service revenue for this sale (chargeable services beyond the commission), pre-sale estimate only. Actual service revenue comes only from client-authorized SaleClientDecision 'financial' charges."
    },
    "estimated_advertising": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 projected advertising direct cost for this sale."
    },
    "estimated_supplies": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 projected supplies/materials direct cost."
    },
    "estimated_transportation": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 projected transportation/fuel/mileage direct cost."
    },
    "estimated_processing": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 projected card/POS processing fee cost."
    },
    "estimated_other_costs": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 projected other direct costs (dumpster, rentals, outside services, etc.)."
    },
    "labor_estimates": {
      "type": "array",
      "default": [],
      "description": "Chapter 4 P1 \u2014 category-level projected labor for this sale. Estimated hours and estimated cash labor cost; compared against actual LaborEntry hours at closeout. Chapter 9 P1 adds is_owner_time: projected OWNER hours display separately and are NEVER counted as projected cash labor expense.",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "preparation",
              "research",
              "staging",
              "sale_day",
              "pickup",
              "closeout",
              "travel",
              "other"
            ]
          },
          "hours": {
            "type": "number",
            "description": "Estimated hours."
          },
          "rate": {
            "type": "number",
            "description": "Estimated hourly cash rate. Ignored for cash cost when is_owner_time is true \u2014 owner time is reported in hours only."
          },
          "is_owner_time": {
            "type": "boolean",
            "default": false,
            "description": "Chapter 9 P1 \u2014 this row is the OWNER'S OWN projected time. Hours display separately; the row never counts as projected cash labor cost (matching the Chapter 4 LaborEntry owner-time doctrine)."
          }
        }
      }
    },
    "min_company_revenue_threshold": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 operator's INTERNAL minimum acceptable company revenue for taking this sale (acceptance scorecard input). Not the client contract minimum fee."
    },
    "min_contribution_threshold": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 operator's INTERNAL minimum acceptable sale contribution for taking this sale (acceptance scorecard input)."
    },
    "commercial_terms_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 9 P1 \u2014 when the client ACCEPTED the commercial terms. Null = terms proposed/projected but NOT YET ACCEPTED. Acceptance is operator-recorded from an accepted SaleProposal; this metadata marks the transition from projected to accepted without moving financial truth off this deal."
    },
    "commercial_terms_accepted_by": {
      "type": "string",
      "description": "Chapter 9 P1 \u2014 name of the client authority who accepted the terms (operator-recorded)."
    },
    "commercial_terms_acceptance_source": {
      "type": "string",
      "description": "Chapter 9 P1 \u2014 how acceptance was received (phone, email, in_person, signed proposal, other)."
    },
    "accepted_proposal_id": {
      "type": "string",
      "description": "Chapter 9 P1 \u2014 the ACCEPTED SaleProposal whose terms the client accepted (provenance)."
    },
    "accepted_terms_snapshot": {
      "type": "object",
      "description": "Chapter 9 P1 \u2014 structured snapshot of the commercial terms as ACCEPTED (commission_rate, minimum_fee, estimated range). Preserves WHAT THE CLIENT ACCEPTED at acceptance time \u2014 later edits to the deal's working/projected fields never rewrite this. Settlement reads the deal's canonical fields; this snapshot is the accepted-history record.",
      "properties": {
        "commission_rate": {
          "type": "number"
        },
        "minimum_fee": {
          "type": "number"
        },
        "estimated_value_low": {
          "type": "number"
        },
        "estimated_value_high": {
          "type": "number"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "default": {}
    },
    "notes": {
      "type": "string"
    },
    "next_action": {
      "type": "string",
      "description": "Chapter 10 P1 \u2014 THE canonical WHAT HAPPENS NEXT for this opportunity ('Call seller', 'Follow up after family meeting', 'Contact after probate hearing', 'Check back in 60 days'). Null on an ACTIVE opportunity = NEEDS NEXT ACTION (surfaced as a strong operational warning). Never AI-invented: it is set by the operator or deterministically seeded at inquiry bridge time ('Respond to seller inquiry'). One next action at a time \u2014 completing it prompts the operator for the next."
    },
    "next_action_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 10 P1 \u2014 WHEN the next action is due. Past date with no completion = NEXT ACTION OVERDUE. Free-scheduled per the family's circumstances \u2014 never a forced cadence."
    },
    "next_action_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 10 P1 \u2014 when the current next action was completed. Set on completion; replacing with the next action clears it. Operational history of past actions lives in Activity."
    },
    "lost_reason": {
      "type": "string",
      "enum": [
        "client_chose_another_company",
        "price_fee",
        "not_enough_saleable_value",
        "location",
        "timing",
        "client_not_ready",
        "scope_mismatch",
        "authority_family_issue",
        "operator_capacity",
        "no_response",
        "alternative_service",
        "other",
        "unknown"
      ],
      "description": "Chapter 10 P1 \u2014 structured reason captured when stage becomes lost. CLIENT NOT READY should usually be NURTURE, and a more appropriate service should usually be REFERRED \u2014 the outcome dialog guides the operator there. Notes go in the deal notes."
    },
    "referred_to_contact_id": {
      "type": "string",
      "description": "Chapter 10 P1 \u2014 canonical Contact link for the professional/service the family was referred to (referred stage). Reuses Contact; no ReferralOut entity."
    },
    "referred_service": {
      "type": "string",
      "enum": [
        "cleanout",
        "donation",
        "auction",
        "consignment",
        "mover",
        "real_estate_agent",
        "attorney",
        "organizer",
        "specialist",
        "other"
      ],
      "description": "Chapter 10 P1 \u2014 service category the opportunity was referred to."
    },
    "referred_reason": {
      "type": "string",
      "description": "Chapter 10 P1 \u2014 why the opportunity was directed elsewhere (operator's words)."
    },
    "referred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 10 P1 \u2014 when the referral-out was recorded."
    },
    "inquiry_source_type": {
      "type": "string",
      "enum": [
        "operator_website",
        "estatesalen_public",
        "estate_transition",
        "seo",
        "manual",
        "professional_referral",
        "houszu"
      ],
      "description": "Chapter 10 P1 \u2014 provenance: WHICH SYSTEM captured the original inquiry that created this opportunity. Preserved so the operator can always answer WHERE DID THIS OPPORTUNITY COME FROM? Distinct from referral_source_type (Chapter 2: how the seller heard about the company, self-reported)."
    },
    "inquiry_source_record_id": {
      "type": "string",
      "description": "Chapter 10 P1 \u2014 ID of the original inquiry record (WebsiteLead / EstateTransitionLead) \u2014 the source-of-truth link back to the captured inquiry, its consent flags and its timestamps."
    },
    "inquiry_received_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 10 P1 \u2014 when the original inquiry arrived (bridge-time copy of the source record's creation). Null = inquiry capture time UNKNOWN (manually created opportunities)."
    },
    "first_meaningful_response_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 10 P1 \u2014 when the FIRST HUMAN/OPERATOR response occurred (set when the first call/email/SMS/meeting Activity is logged against this deal). Automated acknowledgments, system notifications and Customer.io ingestion NEVER count. Null = no human response recorded yet."
    },
    "referral_source_type": {
      "type": "string",
      "enum": [
        "real_estate_agent",
        "attorney",
        "senior_move_manager",
        "professional_organizer",
        "estate_sale_company",
        "past_client",
        "buyer_customer",
        "friend_family",
        "online_search",
        "social_media",
        "website",
        "other"
      ],
      "description": "Chapter 2 P1 \u2014 structured source attribution: what kind of source introduced this seller opportunity. This is source tracking on the operator's own pipeline; it is NOT the agent/operator Referral Exchange. SELF-REPORTED by the seller/operator \u2014 it is not click attribution."
    },
    "referral_source_name": {
      "type": "string",
      "description": "Chapter 2 P1 \u2014 name of the referring person or source (e.g. the agent, attorney, move manager, or past client)."
    },
    "referral_source_contact_id": {
      "type": "string",
      "description": "Chapter 2 P1 \u2014 optional link to an existing Contact record for the referrer. Prefer linking over duplicating people; a Contact record is never required to record a simple source."
    },
    "referral_source_notes": {
      "type": "string",
      "description": "Chapter 2 P1 \u2014 optional context about the referral source."
    },
    "consultation_date": {
      "type": "string",
      "format": "date-time"
    },
    "consultation_notes": {
      "type": "string"
    },
    "contract_signed_date": {
      "type": "string",
      "format": "date"
    },
    "estimated_sale_start_date": {
      "type": "string",
      "format": "date"
    },
    "estimated_sale_end_date": {
      "type": "string",
      "format": "date"
    },
    "pre_sale_selling_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Estate Sale Company Owner has agreed to allow pre-sale item sales"
    },
    "post_sale_selling_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Estate Sale Company Owner has agreed to allow post-sale item sales"
    },
    "ai_timeline_generated": {
      "type": "boolean",
      "default": false
    },
    "ai_timeline_tasks": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          },
          "days_before_sale": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "in_progress",
              "completed"
            ],
            "default": "not_started"
          },
          "priority": {
            "type": "string"
          }
        }
      }
    },
    "lost_notes": {
      "type": "string",
      "description": "Chapter 10 P1 \u2014 operator notes captured at the LOST review (context, competitor if relevant, what could be reconsidered). Completes the interactive Lost Lead Review."
    },
    "actual_revenue": {
      "type": "number",
      "description": "Deal-level actual revenue snapshot written by the settlement/closeout writer (mirrors EstateSale fields; EstateSale remains the canonical sale record). Chapter 10 source-to-revenue reporting reads this canonical figure."
    },
    "total_paid_to_client": {
      "type": "number",
      "default": 0,
      "description": "Running total of payments already made to the client"
    },
    "payout_records": {
      "type": "array",
      "default": [],
      "description": "History of payments made to the client",
      "items": {
        "type": "object",
        "properties": {
          "payout_id": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "paid_date": {
            "type": "string",
            "format": "date"
          },
          "method": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "statement_generated": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "settlement_finalized": {
      "type": "boolean",
      "default": false
    },
    "settlement_finalized_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "operator_id",
    "client_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.operator_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}