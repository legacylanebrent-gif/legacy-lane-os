{
  "name": "SaleConversionPipeline",
  "type": "object",
  "description": "Canonical PRE-SALE opportunity record and, once linked, the settlement/commission agreement record. Chapter 4 P1 adds the pre-sale economics block: contractual minimum fee, expected additional service revenue, category-level estimated labor, estimated direct costs, and the operator's internal minimum-revenue/minimum-contribution thresholds. Projected figures are estimates for evaluation only \u2014 authoritative actuals derive from settlement/closeout.",
  "properties": {
    "operator_id": {
      "type": "string",
      "description": "Estate Sale Company Owner user ID"
    },
    "lead_id": {
      "type": "string",
      "description": "Linked Lead entity ID (optional)"
    },
    "estate_sale_id": {
      "type": "string",
      "description": "Linked EstateSale entity ID once created"
    },
    "stage": {
      "type": "string",
      "enum": [
        "new_lead",
        "consultation_scheduled",
        "contract_signed",
        "setup_in_progress",
        "sale_live",
        "completed",
        "lost"
      ],
      "default": "new_lead"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "property_address": {
      "type": "string"
    },
    "property_city": {
      "type": "string"
    },
    "property_state": {
      "type": "string"
    },
    "situation": {
      "type": "string",
      "enum": [
        "probate",
        "divorce",
        "downsizing",
        "relocation",
        "foreclosure",
        "standard"
      ]
    },
    "estimated_value": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 projected GROSS merchandise sales for this sale (pre-sale estimate). Gross is client merchandise proceeds, NOT company revenue."
    },
    "commission_rate": {
      "type": "number",
      "default": 35,
      "description": "Contract commission rate (percent of gross merchandise sales)."
    },
    "minimum_fee": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 contractual MINIMUM company fee. Company fee due = MAX(calculated commission, this minimum). Distinct from the operator's internal minimum-revenue threshold (min_company_revenue_threshold)."
    },
    "expected_service_revenue": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 anticipated ADDITIONAL authorized service revenue for this sale (chargeable services beyond the commission), pre-sale estimate only. Actual service revenue comes only from client-authorized SaleClientDecision 'financial' charges."
    },
    "estimated_advertising": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 projected advertising direct cost for this sale."
    },
    "estimated_supplies": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 projected supplies/materials direct cost."
    },
    "estimated_transportation": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 projected transportation/fuel/mileage direct cost."
    },
    "estimated_processing": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 projected card/POS processing fee cost."
    },
    "estimated_other_costs": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 projected other direct costs (dumpster, rentals, outside services, etc.)."
    },
    "labor_estimates": {
      "type": "array",
      "default": [],
      "description": "Chapter 4 P1 \u2014 category-level projected labor for this sale. Estimated hours and estimated cash labor cost; compared against actual LaborEntry hours at closeout.",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "preparation",
              "research",
              "staging",
              "sale_day",
              "pickup",
              "closeout",
              "travel",
              "other"
            ]
          },
          "hours": {
            "type": "number",
            "description": "Estimated hours."
          },
          "rate": {
            "type": "number",
            "description": "Estimated hourly cash rate."
          }
        }
      }
    },
    "min_company_revenue_threshold": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 operator's INTERNAL minimum acceptable company revenue for taking this sale (acceptance scorecard input). Not the client contract minimum fee."
    },
    "min_contribution_threshold": {
      "type": "number",
      "description": "Chapter 4 P1 \u2014 operator's INTERNAL minimum acceptable sale contribution for taking this sale (acceptance scorecard input)."
    },
    "notes": {
      "type": "string"
    },
    "referral_source_type": {
      "type": "string",
      "enum": [
        "real_estate_agent",
        "attorney",
        "senior_move_manager",
        "professional_organizer",
        "estate_sale_company",
        "past_client",
        "buyer_customer",
        "friend_family",
        "online_search",
        "social_media",
        "website",
        "other"
      ],
      "description": "Chapter 2 P1 \u2014 structured source attribution: what kind of source introduced this seller opportunity. This is source tracking on the operator's own pipeline; it is NOT the agent/operator Referral Exchange."
    },
    "referral_source_name": {
      "type": "string",
      "description": "Chapter 2 P1 \u2014 name of the referring person or source (e.g. the agent, attorney, move manager, or past client)."
    },
    "referral_source_contact_id": {
      "type": "string",
      "description": "Chapter 2 P1 \u2014 optional link to an existing Contact record for the referrer. Prefer linking over duplicating people; a Contact record is never required to record a simple source."
    },
    "referral_source_notes": {
      "type": "string",
      "description": "Chapter 2 P1 \u2014 optional context about the referral source."
    },
    "consultation_date": {
      "type": "string",
      "format": "date-time"
    },
    "consultation_notes": {
      "type": "string"
    },
    "contract_signed_date": {
      "type": "string",
      "format": "date"
    },
    "estimated_sale_start_date": {
      "type": "string",
      "format": "date"
    },
    "estimated_sale_end_date": {
      "type": "string",
      "format": "date"
    },
    "pre_sale_selling_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Estate Sale Company Owner has agreed to allow pre-sale item sales"
    },
    "post_sale_selling_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Estate Sale Company Owner has agreed to allow post-sale item sales"
    },
    "ai_timeline_generated": {
      "type": "boolean",
      "default": false
    },
    "ai_timeline_tasks": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          },
          "days_before_sale": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "in_progress",
              "completed"
            ],
            "default": "not_started"
          },
          "priority": {
            "type": "string"
          }
        }
      }
    },
    "lost_reason": {
      "type": "string"
    },
    "actual_revenue": {
      "type": "number",
      "description": "Deal-level actual revenue snapshot written by the settlement/closeout writer (mirrors EstateSale fields; EstateSale remains the canonical sale record)."
    },
    "total_paid_to_client": {
      "type": "number",
      "default": 0,
      "description": "Running total of payments already made to the client"
    },
    "payout_records": {
      "type": "array",
      "default": [],
      "description": "History of payments made to the client",
      "items": {
        "type": "object",
        "properties": {
          "payout_id": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "paid_date": {
            "type": "string",
            "format": "date"
          },
          "method": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "statement_generated": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "settlement_finalized": {
      "type": "boolean",
      "default": false
    },
    "settlement_finalized_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "operator_id",
    "client_name"
  ]
}