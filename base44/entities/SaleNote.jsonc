{
  "name": "SaleNote",
  "type": "object",
  "description": "Chapter 2 P1 \u2014 lightweight operational note attached to a sale: ordinary internal team memory (who did what, property quirks, logistics). NOT a client decision (SaleClientDecision), NOT a task (SaleTask), NOT client communication. Author + timestamp come from the platform built-ins (created_by_id / created_date); created_by_name is a display snapshot.",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "EstateSale this note belongs to."
    },
    "operator_id": {
      "type": "string",
      "description": "EstateSale.operator_id projection \u2014 sale owner (RLS anchor). Derived from the sale at creation."
    },
    "sale_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "READ-SCOPE PROJECTION of EstateSale.sale_team for RLS. The sale remains the source of truth."
    },
    "note": {
      "type": "string",
      "description": "The note body (plain text)."
    },
    "pinned": {
      "type": "boolean",
      "default": false,
      "description": "Operator-set importance flag \u2014 pinned notes surface first."
    },
    "created_by_name": {
      "type": "string",
      "description": "Display-name snapshot of the author at write time."
    }
  },
  "required": [
    "sale_id",
    "note"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "data.sale_team_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}