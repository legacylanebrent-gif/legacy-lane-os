{
  "name": "UserReward",
  "type": "object",
  "description": "Reward ledger record (engagement points, software-affiliate referral rewards). Referral Rebuild Phase 1B: ALL creation goes through sanctioned backend paths \u2014 the admin reward functions (referral rewards via the ONE canonical action_id 'referral_<id>' path) and completeRewardAction, which derives points SERVER-SIDE from a qualifying record the user actually created and deduplicates per event. Direct client creation is closed (admin-only RLS) so a participant can never mint points, forge a qualifying event, or duplicate a reward. A user reads only their own rewards; all other mutations are admin-only. Points feed monthly prize-draw eligibility \u2014 they are fulfillment-relevant, never client-assertable.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID"
    },
    "action_id": {
      "type": "string",
      "description": "Action that was completed"
    },
    "action_name": {
      "type": "string",
      "description": "Name of the action"
    },
    "points_earned": {
      "type": "integer",
      "description": "Points earned from this action"
    },
    "month": {
      "type": "string",
      "description": "Month in YYYY-MM format"
    },
    "reference_id": {
      "type": "string",
      "description": "Reference to related entity (sale_id, referral_id, etc)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the action"
    }
  },
  "required": [
    "user_id",
    "action_id",
    "points_earned",
    "month"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}