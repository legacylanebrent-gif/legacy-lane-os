{
  "name": "ConsumerMarketingProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "preferred_radius_miles": {
      "type": "number",
      "default": 25
    },
    "global_marketing_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Global marketing emails \u2014 explicit opt-in only (never default true)"
    },
    "estate_sale_alerts_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Estate sale listing alerts \u2014 explicit opt-in only (never default true)"
    },
    "vip_alerts_opt_in": {
      "type": "boolean",
      "default": false
    },
    "weekly_digest_opt_in": {
      "type": "boolean",
      "default": false
    },
    "sms_marketing_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Chapter 18 P1-2 \u2014 EXPLICIT SMS marketing consent, COMPLETELY SEPARATE from email consent. Email opt-in never authorizes SMS. Explicit opt-in only (never default true, never inferred from RSVP/attendance/purchase)."
    },
    "email_consent_source": {
      "type": "string",
      "description": "Chapter 18 P1-3 \u2014 provenance of the recorded EMAIL opt-in (where it was captured, e.g. operator_website_alerts, early_sign_in). Null = never recorded / unknown \u2014 unknown stays unknown; historical provenance is never fabricated."
    },
    "email_consent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 18 P1-3 \u2014 when the EMAIL opt-in was captured, when recorded."
    },
    "email_opt_out_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 18 P1-3 \u2014 when the buyer withdrew EMAIL consent, when recorded."
    },
    "sms_consent_source": {
      "type": "string",
      "description": "Chapter 18 P1-3 \u2014 provenance of the recorded SMS opt-in. Null = unknown."
    },
    "sms_consent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 18 P1-3 \u2014 when the SMS opt-in was captured, when recorded."
    },
    "sms_opt_out_at": {
      "type": "string",
      "format": "date-time",
      "description": "Chapter 18 P1-3 \u2014 when the buyer withdrew SMS consent, when recorded."
    },
    "interest_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Phase 4C buyer signup interests from the controlled website vocabulary (furniture, jewelry, vintage, coins, tools, vehicles, art, collectibles, designer, electronics, household, other). Buyer preference LIVES HERE \u2014 the canonical buyer profile; no parallel buyer database."
    },
    "last_synced_to_customerio_at": {
      "type": "string",
      "format": "date-time"
    },
    "customerio_profile_id": {
      "type": "string"
    },
    "suppression_status": {
      "type": "string",
      "enum": [
        "active",
        "unsubscribed_all",
        "bounced",
        "complained",
        "suppressed"
      ],
      "default": "active"
    },
    "source": {
      "type": "string",
      "enum": [
        "website_signup",
        "operator_page",
        "sale_page",
        "import",
        "admin_added"
      ],
      "default": "website_signup"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "masterUserID": {
      "type": "string",
      "description": "Permanent cross-platform identity ID from Houszu. Used as the Customer.io identifier."
    },
    "identityResolutionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "resolved",
        "provisional",
        "review_required",
        "failed",
        "retrying"
      ],
      "default": "pending"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}