{
  "name": "ReferralLead",
  "type": "object",
  "description": "Legacy real-estate referral exchange lead (Houszu / Legacy Lane). Holds client PII. Referral Rebuild Phase 1: reads are limited to the lead's source, assigned agent, assigned operator, and admins \u2014 unassigned leads are no longer visible to ordinary exchange participants while compensated acceptance is paused; all writes are admin-only (server functions operate as service role). A client referral submitted by an Estate Sale Company Owner through the operator referral form is written only by the sanctioned submitClientReferral function, is flagged agent_lead, and notifies the real estate agents serving the property's city. Agents report their contact attempts through the sanctioned referralContactReport function, which appends to contact_attempts with a server-derived agent identity and timestamp so the referring company can see what was actually done for their client. Each referral also carries an AI market value estimate for the property (home_value_*) and the resulting referral-fee illustration (referral_fee_estimate), written only by server functions: the estimate is a market estimate for illustration, NOT an appraisal, and the payout figure is an illustration of the 2% referral fee \u00d7 15% payout share, never a quote, guarantee, or entitlement.",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Unique lead identifier"
    },
    "property_address": {
      "type": "string",
      "description": "Full property address"
    },
    "property_city": {
      "type": "string",
      "description": "Property city. Drives which agents are notified for an agent_lead referral."
    },
    "property_state": {
      "type": "string",
      "description": "Two-letter property state."
    },
    "property_zip": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "client_name": {
      "type": "string",
      "description": "Name of the client/property owner"
    },
    "client_email": {
      "type": "string",
      "description": "Client email supplied by the referring Estate Sale Company Owner (not verified)."
    },
    "client_phone": {
      "type": "string",
      "description": "Client phone supplied by the referring Estate Sale Company Owner (not verified)."
    },
    "source_user_id": {
      "type": "string",
      "description": "User ID of the agent or Estate Sale Company Owner who sourced/introduced the lead"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "agent",
        "Estate Sale Company Owner"
      ],
      "description": "Whether the lead was sourced by an agent or Estate Sale Company Owner"
    },
    "source_channel": {
      "type": "string",
      "enum": [
        "operator_form",
        "partner_link",
        "legacy"
      ],
      "default": "legacy",
      "description": "How the lead entered the system. operator_form = an Estate Sale Company Owner submitted it from the operator referral form."
    },
    "submitted_by_name": {
      "type": "string",
      "description": "Display-name snapshot of the submitting Estate Sale Company Owner."
    },
    "agent_lead": {
      "type": "boolean",
      "default": false,
      "description": "Flagged as a lead for real estate agents. Only these leads trigger the agent notification to agents serving the property city."
    },
    "timeline": {
      "type": "string",
      "enum": [
        "within_30_days",
        "one_to_three_months",
        "three_to_six_months",
        "six_plus_months",
        "unknown"
      ],
      "description": "Client's stated timeline as reported by the Estate Sale Company Owner."
    },
    "need_notes": {
      "type": "string",
      "description": "What the client needs, in the referring operator's words."
    },
    "assigned_agent_id": {
      "type": "string",
      "description": "User ID of the assigned real estate agent"
    },
    "assigned_operator_id": {
      "type": "string",
      "description": "User ID of the assigned Estate Sale Company Owner"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "accepted",
        "in_progress",
        "closed"
      ],
      "default": "new",
      "description": "Current status of the referral lead"
    },
    "agent_notified_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of agents the referral email was delivered to."
    },
    "agent_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the agent notification ran."
    },
    "agent_notify_status": {
      "type": "string",
      "enum": [
        "not_sent",
        "sent",
        "partial",
        "no_agents",
        "failed"
      ],
      "default": "not_sent",
      "description": "Outcome of the agent notification. no_agents = nobody is listed for this city; failed = the send failed."
    },
    "agent_notify_note": {
      "type": "string",
      "description": "Plain-language explanation of the notification outcome."
    },
    "notified_agent_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Lowercased emails of the agents the referral was actually delivered to. This is the authorization anchor for agent self-reporting (a signed-in user may read/report on this lead only when their account email is on this list), plus the assigned agent, the source, and admins. Empty on referrals sent before reporting existed \u2014 nobody was recorded, so no agent claim can be verified for them."
    },
    "contact_attempts": {
      "type": "array",
      "default": [],
      "description": "Append-only log of the agents' contact attempts on this referral, written ONLY by the sanctioned referralContactReport function. Each entry carries the agent identity and email derived from the authenticated session (never supplied by the caller as authority), the contact time the agent reports, and what actually happened. The referring company reads this to see what was done for their client. Entries are never edited or removed by the reporting agents.",
      "items": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "description": "When the contact attempt happened, as reported by the agent."
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "description": "Server timestamp of when the report was filed."
          },
          "agent_user_id": {
            "type": "string",
            "description": "Server-derived user ID of the reporting agent."
          },
          "agent_name": {
            "type": "string",
            "description": "Name the agent reported under (defaults to their account name)."
          },
          "agent_email": {
            "type": "string",
            "description": "Server-derived account email of the reporting agent. Identity evidence, not a claim."
          },
          "method": {
            "type": "string",
            "enum": [
              "call",
              "text",
              "email",
              "in_person",
              "other"
            ],
            "description": "How the agent reached out."
          },
          "outcome": {
            "type": "string",
            "enum": [
              "connected",
              "left_message",
              "no_answer",
              "wrong_number",
              "declined",
              "other"
            ],
            "description": "What happened on this attempt."
          },
          "connected": {
            "type": "boolean",
            "default": false,
            "description": "Whether the agent actually spoke with the client on this attempt."
          },
          "spoke_with": {
            "type": "string",
            "description": "Who the agent spoke with (client, spouse, family member, attorney...)."
          },
          "notes": {
            "type": "string",
            "description": "The agent's notes about the attempt, in their own words."
          }
        }
      }
    },
    "last_contact_at": {
      "type": "string",
      "format": "date-time",
      "description": "Reported time of the most recent contact attempt (summary of contact_attempts; the log itself stays the source of truth)."
    },
    "last_contact_outcome": {
      "type": "string",
      "description": "Outcome of the most recent reported attempt."
    },
    "agent_engagement": {
      "type": "string",
      "enum": [
        "not_contacted",
        "attempted",
        "connected",
        "declined"
      ],
      "default": "not_contacted",
      "description": "Plain-language engagement summary derived from the reported attempts: no report yet, attempts made without reaching the client, client reached, or client declined. Reported by agents \u2014 never inferred from the email delivery."
    },
    "home_value_status": {
      "type": "string",
      "enum": [
        "pending",
        "estimated",
        "unavailable"
      ],
      "default": "pending",
      "description": "Whether the property has an AI market value estimate. pending = requested and not yet returned; estimated = a value was recorded; unavailable = the estimate could not be produced (address unusable or the estimate failed)."
    },
    "estimated_home_value": {
      "type": "number",
      "description": "AI MARKET ESTIMATE of what the property would sell for, in whole US dollars, based on public market data for the address. This is an illustration for the referral fee, NOT an appraisal, market analysis, or price opinion, and is never a promise of sale price."
    },
    "home_value_low": {
      "type": "number",
      "description": "Low end of the estimate range, in whole US dollars."
    },
    "home_value_high": {
      "type": "number",
      "description": "High end of the estimate range, in whole US dollars."
    },
    "home_value_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "How well the address could be matched to public market data, as reported by the estimate."
    },
    "home_value_basis": {
      "type": "string",
      "description": "Short plain-language explanation of how the value was estimated (comparable sales, public estimates, property characteristics)."
    },
    "home_value_source": {
      "type": "string",
      "description": "Where the estimate came from (e.g. AI market estimate using public web sources)."
    },
    "home_value_estimated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server timestamp of the valuation attempt. An old timestamp means the estimate is stale."
    },
    "referral_commission_estimate": {
      "type": "number",
      "description": "Illustration: estimated_home_value \u00d7 2% referral fee, in whole US dollars. Illustration only \u2014 the actual fee is set by the executed referral agreement."
    },
    "referral_fee_estimate": {
      "type": "number",
      "description": "Illustration: the referral commission \u00d7 15% agent payout share that a participating agent could earn on this referral. Illustration only \u2014 it is NOT a quote, guarantee, or entitlement, and earning it requires the agent to complete eligibility and the referral to close."
    }
  },
  "required": [
    "lead_id",
    "property_address",
    "client_name",
    "source_user_id",
    "source_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.source_user_id": "{{user.id}}"
        },
        {
          "data.assigned_agent_id": "{{user.id}}"
        },
        {
          "data.assigned_operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}