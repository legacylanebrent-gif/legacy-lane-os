{
  "name": "ReferralLead",
  "type": "object",
  "description": "Legacy real-estate referral exchange lead (Houszu / Legacy Lane). Holds client PII. Referral Rebuild Phase 1: reads are limited to the lead's source, assigned agent, assigned operator, and admins \u2014 unassigned leads are no longer visible to ordinary exchange participants while compensated acceptance is paused; all writes are admin-only (server functions operate as service role).",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Unique lead identifier"
    },
    "property_address": {
      "type": "string",
      "description": "Full property address"
    },
    "client_name": {
      "type": "string",
      "description": "Name of the client/property owner"
    },
    "source_user_id": {
      "type": "string",
      "description": "User ID of the agent or Estate Sale Company Owner who sourced/introduced the lead"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "agent",
        "Estate Sale Company Owner"
      ],
      "description": "Whether the lead was sourced by an agent or Estate Sale Company Owner"
    },
    "assigned_agent_id": {
      "type": "string",
      "description": "User ID of the assigned real estate agent"
    },
    "assigned_operator_id": {
      "type": "string",
      "description": "User ID of the assigned Estate Sale Company Owner"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "accepted",
        "in_progress",
        "closed"
      ],
      "default": "new",
      "description": "Current status of the referral lead"
    }
  },
  "required": [
    "lead_id",
    "property_address",
    "client_name",
    "source_user_id",
    "source_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.source_user_id": "{{user.id}}"
        },
        {
          "data.assigned_agent_id": "{{user.id}}"
        },
        {
          "data.assigned_operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}