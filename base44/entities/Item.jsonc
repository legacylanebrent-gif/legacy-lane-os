                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "payment_notes": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.seller_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "authorized_pickup": {
      "type": "string",
      "description": "Chapter 15 P1-46 \u2014 name of an alternate person authorized by the buyer to pick up this item (operator-recorded). Only a NAME is recorded \u2014 the system never collects ID documents."
    },
    "pickup_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When sold merchandise was picked up / released to the buyer (guided closeout tracking). Absent = pickup still pending. Independent of selling status.",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.seller_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "included_in_settlement": {
      "type": "boolean",
      "default": false,
      "description": "Has this item been included in a client settlement statement"
    },
    "controlled_location": {
      "type": "string",
      "description": "Chapter 15 P1-6/P1-49 \u2014 LEAST-PRIVILEGE record of where HIGH_VALUE merchandise is secured (locked box, office, operator custody). Not visible to ordinary sale-team members. Continues the Chapter 14 discovery controlled_location chain after promotion.",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.operator_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "custody_events": {
      "type": "array",
      "default": [],
      "description": "Chapter 15 P1-49/P1-50 \u2014 append-only custody trail for HIGH_VALUE/controlled merchandise, CONTINUING the Chapter 14 discovery chain (promotion seeds the item's chain with the discovery's events \u2014 one continuity chain, not a second system). Only SIGNIFICANT movements are recorded \u2014 never every minor ordinary movement. Earlier events are never rewritten. NOT forensic evidence software.",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "FOUND",
              "SECURED_CONTROLLED_LOCATION",
              "MOVED",
              "TRANSFERRED_SPECIALIST",
              "RETURNED_FROM_SPECIALIST",
              "SOLD",
              "RELEASED",
              "OTHER"
            ]
          },
          "note": {
            "type": "string",
            "description": "Who/where/why context (with whom, expected return...). Team-safe \u2014 no codes or credentials."
          },
          "by": {
            "type": "string",
            "description": "User ID recording the event."
          },
          "by_name": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "offsite_research": {
