{
  "name": "Item",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "antiques",
        "art",
        "artwork_prints_posters",
        "books_media",
        "china_porcelain",
        "clocks_watches",
        "clothing_accessories",
        "coins_currency",
        "collectibles",
        "craft_sewing",
        "electronics",
        "furniture",
        "garden_outdoor",
        "glassware_crystal",
        "holiday_seasonal",
        "home_decor",
        "kitchen_dining",
        "lighting_lamps",
        "medical_mobility",
        "musical_instruments",
        "office_business",
        "rugs_textiles",
        "sporting_goods",
        "tools_hardware",
        "toys_games",
        "vehicles",
        "other"
      ]
    },
    "subcategory": {
      "type": "string"
    },
    "seller_id": {
      "type": "string",
      "description": "User ID of seller"
    },
    "seller_name": {
      "type": "string"
    },
    "estate_sale_id": {
      "type": "string",
      "description": "If from estate sale"
    },
    "operator_id": {
      "type": "string",
      "description": "EstateSale.operator_id projection for sale inventory (RLS anchor); equals the seller for personal/marketplace items. Derived from the sale at creation."
    },
    "sale_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "READ-SCOPE PROJECTION of EstateSale.sale_team for RLS. The sale remains the source of truth."
    },
    "storage_location_id": {
      "type": "string"
    },
    "storage_location_path": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "price": {
      "type": "number"
    },
    "sold_price": {
      "type": "number",
      "description": "Price item sold for if different from listed price"
    },
    "original_price": {
      "type": "number"
    },
    "brand": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "shipping_weight": {
      "type": "number"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "used_like_new",
        "used_good",
        "used_fair",
        "for_parts"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "pending",
        "sold",
        "reserved"
      ],
      "default": "available",
      "description": "Master status"
    },
    "sale_phase": {
      "type": "string",
      "enum": [
        "pre_sale",
        "during_sale",
        "post_sale"
      ],
      "default": "during_sale",
      "description": "When the item was sold relative to the sale event"
    },
    "pre_sale_allowed": {
      "type": "boolean",
      "default": false,
      "description": "Estate Sale Company Owner has enabled pre-sale selling for this item",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.seller_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "post_sale_allowed": {
      "type": "boolean",
      "default": false,
      "description": "Estate Sale Company Owner has enabled post-sale selling for this item",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.seller_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "sold_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when item was sold",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
