    "dimensions": {
      "type": "object",
      "properties": {
        "length": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "weight": {
          "type": "number"
        }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        }
      }
    },
    "fulfillment_options": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "shipping",
          "pickup",
          "digital"
        ]
      },
      "default": [
        "pickup"
      ]
    },
    "shipping_cost": {
      "type": "number",
      "default": 0
    },
    "pickup_location": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        }
      }
    },
    "digital_download_url": {
      "type": "string"
    },
    "payment_methods_accepted": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cash",
          "check",
          "credit_card",
          "venmo",
          "paypal",
          "zelle",
          "cashapp",
          "stripe",
          "square",
          "other"
        ]
      },
      "default": []
    },
    "views": {
      "type": "integer",
      "default": 0
    },
    "saves": {
      "type": "integer",
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "quantity": {
      "type": "integer",
      "default": 1
    },
    "rating": {
      "type": "number"
    },
    "total_reviews": {
      "type": "integer",
      "default": 0
    },
    "category_specs": {
      "type": "object",
      "default": {}
    },
    "specs": {
      "type": "object"
    },
    "sales_channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "inventory",
          "marketplace"
        ]
      },
      "default": []
    },
    "inventory_display_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "hidden"
      ],
      "default": "active"
    },
    "marketplace_item_id": {
      "type": "string"
    },
    "marketplace_display_status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "inactive"
      ],
      "default": "draft"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
