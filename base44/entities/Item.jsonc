    "specialist_opinions": {
      "type": "array",
      "default": [],
      "description": "Chapter 16 P1-22/P1-23 \u2014 structured record of a specialist's opinion on this item's identification/value, as EVIDENCE for the pricing decision. The RELATIONSHIP is operator-declared and never inferred (a potential buyer's opinion is displayed as such). NOT an authentication or appraisal; the operator remains responsible for the price.",
      "items": {
        "type": "object",
        "properties": {
          "opinion_id": {
            "type": "string"
          },
          "contact_id": {
            "type": "string",
            "description": "Optional canonical Contact link for the specialist."
          },
          "specialist_name": {
            "type": "string",
            "description": "Display-name snapshot of the specialist."
          },
          "relationship": {
            "type": "string",
            "enum": [
              "INDEPENDENT",
              "POTENTIAL_BUYER",
              "BOTH",
              "UNKNOWN"
            ],
            "default": "UNKNOWN",
            "description": "Chapter 16 P1-23 \u2014 the specialist's relationship to the potential sale, OPERATOR-DECLARED. Never inferred; a POTENTIAL_BUYER opinion is visibly labeled and never represented as independent."
          },
          "opinion": {
            "type": "string",
            "description": "What the specialist said, in plain words \u2014 never a system conclusion."
          },
          "basis": {
            "type": "string",
            "description": "Context/basis (in-person inspection, photos, documents...)."
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "description": "When the opinion was recorded."
          },
          "by": {
            "type": "string",
            "description": "User ID who recorded the opinion."
          },
          "by_name": {
            "type": "string"
          }
        }
      }
    },
    "appraisal_context": {
      "type": "object",
      "default": {},
      "description": "Chapter 16 P1-26/P1-27 \u2014 smallest metadata for understanding a client-provided or commissioned APPRAISAL attached as an item-scoped BusinessDocument. The appraisal is EVIDENCE/CONTEXT ONLY: its value is never copied into Item.price, and the operator records the appraisal's own context without interpreting its methodology. Comparing current condition against the appraisal happens in the pricing view \u2014 the source document is never altered.",
      "properties": {
        "document_id": {
          "type": "string",
          "description": "Canonical BusinessDocument (category APPRAISAL, scope 'item') holding the private file."
        },
        "value": {
          "type": "number",
          "description": "The appraisal's stated value \u2014 CONTEXT ONLY, never transferred to Item.price."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Appraisal date as stated in the document."
        },
        "professional": {
          "type": "string",
          "description": "Appraiser/professional/source as stated."
        },
        "purpose": {
          "type": "string",
          "description": "Valuation purpose/standard context if known (insurance, estate, resale...)."
        },
        "condition_differs_note": {
          "type": "string",
          "description": "Chapter 16 P1-28 \u2014 operator note where current item condition differs from the appraised condition. The appraisal document itself is never altered."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "display_attention": {
      "type": "string",
      "enum": [
        "NONE",
        "HIGH_VALUE",
        "CONTROLLED_DISPLAY",
        "CHECKOUT_HOLD",
        "STAFF_ATTENTION"
      ],
      "default": "NONE",
      "description": "Chapter 8 P1 \u2014 operational DISPLAY/HANDLING attention for this item DURING the sale (how staff should handle it on the floor). Deliberately distinct from research_status (whether we know enough about the item) \u2014 the two are never merged. INTERNAL operational information only: never projected to public sale pages, public marketplace detail, website presentations, or Marketing Kit drafts; public-facing merchandise may still be marketed normally.",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
