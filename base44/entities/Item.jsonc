                    "role": "user"
                  }
                },
                {
                  "data.seller_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "high_consequence_note": {
      "type": "string",
      "description": "Chapter 16 P1-12 \u2014 what the competing-identification risk is, in the operator's words.",
