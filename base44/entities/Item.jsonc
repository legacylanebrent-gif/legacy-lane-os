                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
