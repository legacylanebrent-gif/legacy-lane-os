{
  "name": "Item",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "antiques",
        "art",
        "artwork_prints_posters",
        "books_media",
        "china_porcelain",
        "clothing_accessories",
        "coins_currency",
        "collectibles",
        "craft_sewing",
        "electronics",
        "furniture",
        "garden_outdoor",
        "glassware_crystal",
        "holiday_seasonal",
        "home_decor",
        "kitchen_dining",
        "lighting_lamps",
        "medical_mobility",
        "musical_instruments",
        "office_business",
        "rugs_textiles",
        "sporting_goods",
        "tools_hardware",
        "toys_games",
        "vehicles",
        "other"
      ]
    },
    "subcategory": {
      "type": "string"
    },
    "seller_id": {
      "type": "string",
      "description": "User ID of seller"
    },
    "seller_name": {
      "type": "string"
    },
    "estate_sale_id": {
      "type": "string",
      "description": "If from estate sale"
    },
    "operator_id": {
      "type": "string",
      "description": "EstateSale.operator_id projection for sale inventory (RLS anchor); equals the seller for personal/marketplace items. Derived from the sale at creation."
    },
    "sale_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "READ-SCOPE PROJECTION of EstateSale.sale_team for RLS. The sale remains the source of truth."
    },
    "inventory_level": {
      "type": "string",
      "enum": [
        "QUICK",
        "STANDARD",
        "RESEARCH",
        "HIGH_VALUE"
      ],
      "default": "STANDARD",
      "description": "Chapter 15 P1-1 \u2014 WORKFLOW DEPTH of this record, never a value judgment and never automatic truth. QUICK = minimal documentation for ordinary low-value merchandise. STANDARD = normal sale merchandise. RESEARCH = research workflow prominent (evidence, notes, verification). HIGH_VALUE = stronger operational controls (custody, controlled location, pickup control). Human operator chooses; deterministic operator guidance may SUGGEST, never set. Changing level never deletes data/photos/research/history/offers \u2014 it only changes UI emphasis (P1-7/P1-8)."
    },
    "item_number": {
      "type": "integer",
      "description": "Chapter 15 P1-10 \u2014 sale-scoped human-readable ordinal (unique within estate_sale_id), generated server-side (assignItemNumber) at creation, STABLE AND IMMUTABLE afterwards; survives every status/level/location change and label reprints. Display zero-padded. Never replaces the canonical database id and is never derived from the mutable title."
    },
    "zone_id": {
      "type": "string",
      "description": "Chapter 15 P1-14 \u2014 canonical team-readable prep zone (EstateSale.prep_zones zone_id) where this merchandise sits. Reuses the Chapter 14 zone registry; there is NO second room entity. Empty = unassigned."
    },
    "location_detail": {
      "type": "string",
      "description": "Chapter 15 P1-14 \u2014 optional sub-location free text within the zone (Back Wall, Dresser, Upper Cabinet...). Combined display: zone name + detail (Garage \u2014 Back Wall)."
    },
    "group_note": {
      "type": "string",
      "description": "Chapter 15 P1-17 \u2014 grouped-merchandise description when ONE record represents a practical group of ordinary merchandise (Set of 6 glasses; Box of kitchen utensils; Contents of shelf). quantity carries the count; no child Item records unless merchandise is individually tracked."
    },
    "included_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Chapter 15 P1-28 \u2014 what comes with this item (dresser includes mirror; stereo includes speakers). Plain team/buyer-facing answers, not a parts inventory."
    },
    "excluded_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Chapter 15 P1-28 \u2014 what does NOT come with this item (lamp excludes shade). Prevents buyer misunderstanding."
    },
    "storage_location_id": {
      "type": "string"
    },
    "storage_location_path": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "PUBLISHED photo URLs \u2014 the public/marketing display set. Chapter 15 P0: a photo enters this published set ONLY after the existing sensitive-material screen (or explicit human clearance) AND explicit operator approval. New uploads land in photo_library (private by default). Legacy records keep their existing published images."
    },
    "photo_library": {
      "type": "array",
      "default": [],
      "description": "Chapter 15 P0/P1-23 \u2014 the Item's reusable photo library. Every photo carries a PURPOSE and privacy state; PRIVATE BY DEFAULT (approved_public=false). A photo is approved into the published set (images) only through the existing sensitive-material screen (advisory; failure NEVER means cleared) plus explicit human approval. The same underlying file is reused across workflows \u2014 no re-upload for research vs marketing vs condition. CUSTODY/EVIDENCE and RESEARCH photos are never casually publishable.",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Photo URL (public storage reference; discovery evidence may carry a private file_uri rendered only via signed URL)."
          },
          "purpose": {
            "type": "string",
            "enum": [
              "RESEARCH",
              "CONDITION",
              "DETAIL",
              "MARKETING",
              "CUSTODY_EVIDENCE",
              "OTHER_PRIVATE"
            ],
            "default": "RESEARCH",
            "description": "Why this photo exists. Purpose drives privacy defaults and marketing eligibility \u2014 never a claim about content."
          },
          "approved_public": {
            "type": "boolean",
            "default": false,
            "description": "Explicit operator approval for public/marketing use. Settable only when screen_status is screen_passed or cleared_by_human."
          },
          "screen_status": {
            "type": "string",
            "enum": [
              "not_run",
              "screen_passed",
              "review_required",
              "cleared_by_human"
            ],
            "default": "not_run",
            "description": "Advisory result of the EXISTING sensitive-material screen (analyzeItemImage) before publication. FAIL-SAFE: screening failure or a sensitive flag yields review_required \u2014 never silently cleared. A human clears explicitly."
          },
          "note": {
            "type": "string",
            "description": "Team-safe caption (mark, signature, underside, damage detail...)."
          },
          "source_discovery_id": {
            "type": "string",
            "description": "Chapter 15 P1-12 \u2014 provenance when the photo came from a promoted SaleDiscovery (private evidence photo)."
          },
          "added_by": {
            "type": "string"
          },
          "added_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "price": {
      "type": "number"
    },
    "sold_price": {
      "type": "number",
      "description": "Price item sold for if different from listed price"
    },
    "original_price": {
      "type": "number",
      "description": "Chapter 16 P1-17 \u2014 the OPENING PRICE snapshot, written ONCE when the item is first priced (changeItemPrice sets it only when empty) and NEVER overwritten by later price changes. Price history lives in Activity; Item.price remains the single CURRENT price \u2014 there is no competing current-price field."
    },
    "brand": {
      "type": "string"
    },
    "maker": {
      "type": "string",
      "description": "Chapter 15 P1-27 \u2014 maker/manufacturer/artist when identified (RESEARCH-level identification, optional). An unverified identification lives in research_notes, never asserted here as fact."
    },
    "model": {
      "type": "string",
      "description": "Chapter 15 P1-27 \u2014 model when known."
    },
    "serial_number": {
      "type": "string",
      "description": "Chapter 15 P1-27 \u2014 serial number evidence (research/identification)."
    },
    "signature_mark": {
      "type": "string",
      "description": "Chapter 15 P1-27 \u2014 signature/maker's mark OBSERVATION (what was seen, not who authenticated it)."
    },
    "materials": {
      "type": "string",
      "description": "Chapter 15 P1-27 \u2014 observed materials (oak, brass, sterling...)."
    },
    "size": {
      "type": "string"
    },
    "shipping_weight": {
      "type": "number"
    },
    "condition": {
      "type": "string",
      "enum": [
        "new",
        "used_like_new",
        "used_good",
        "used_fair",
        "for_parts"
      ]
    },
    "condition_notes": {
      "type": "object",
      "default": {},
      "description": "Chapter 15 P1-26 \u2014 useful buyer-facing condition detail beyond the enum. No universal numeric grade; plain honest description.",
      "properties": {
        "damage": {
          "type": "string",
          "description": "Observed damage (chips, cracks, wear spots...)."
        },
        "missing_parts": {
          "type": "string",
          "description": "What is missing."
        },
        "repairs": {
          "type": "string",
          "description": "Repairs/restoration observed."
        },
        "summary": {
          "type": "string",
          "description": "One-line honest condition summary."
        }
      }
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "length": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "depth": {
          "type": "number",
          "description": "Chapter 15 P1-25 \u2014 depth for furniture/case goods."
        },
        "weight": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "in",
            "cm"
          ],
          "default": "in",
          "description": "Chapter 15 P1-25 \u2014 measurement unit for length/width/height/depth."
        }
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "UNVERIFIED",
        "RESEARCHING",
        "REASONABLY_VERIFIED",
        "SPECIALIST_REVIEWED"
      ],
      "default": "UNVERIFIED",
      "description": "Chapter 15 P1-19 \u2014 internal business-process verification state for the item's identification facts. REASONABLY_VERIFIED is operator/business-process language ONLY \u2014 not an appraisal, authentication, or guarantee of authenticity. SPECIALIST_REVIEWED records that a specialist looked; still not a certification. Chapter 16 P1-11: this remains the ONE verification architecture; research_status (attention/ready state) is deliberately separate and the two are never merged."
    },
    "verified_facts": {
      "type": "array",
      "default": [],
      "description": "Chapter 15 P1-18/P1-22 \u2014 COMPANY-REPRESENTED, operator-approved facts. This is the HUMAN APPROVAL BOUNDARY: researched/AI-generated information becomes buyer-facing ONLY when an authorized human moves it here. Each fact carries its source type so provenance is never silently upgraded. Distinct by design from research_notes (working information).",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The approved fact, stated as the company is willing to represent it."
          },
          "source_type": {
            "type": "string",
            "enum": [
              "OPERATOR_OBSERVATION",
              "CLIENT_FAMILY_STATEMENT",
              "DOCUMENTARY_EVIDENCE",
              "RESEARCH_SOURCE",
              "SPECIALIST_INPUT"
            ],
            "description": "Chapter 15 P1-20 \u2014 provenance of the fact. A family statement moved here is still labeled CLIENT_FAMILY_STATEMENT \u2014 the label travels with the fact."
          },
          "verified_by": {
            "type": "string"
          },
          "verified_by_name": {
            "type": "string"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "research_notes": {
      "type": "array",
      "default": [],
      "description": "Chapter 15 P1-18 \u2014 WORKING research information: possibilities, leads, AI suggestions, family statements. NEVER buyer-facing on its own and NEVER silently marketed as fact. The path to buyer-facing is an authorized human moving a note into verified_facts.",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "OPERATOR_OBSERVATION",
              "CLIENT_FAMILY_STATEMENT",
              "DOCUMENTARY_EVIDENCE",
              "RESEARCH_SOURCE",
              "SPECIALIST_INPUT",
              "AI_SUGGESTION"
            ],
            "default": "RESEARCH_SOURCE",
            "description": "AI_SUGGESTION exists ONLY here \u2014 an AI suggestion is never a verified fact and never appears in verified_facts."
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "pending",
        "sold",
        "reserved"
      ],
      "default": "available",
      "description": "Master status"
    },
    "sale_phase": {
      "type": "string",
      "enum": [
        "pre_sale",
        "during_sale",
        "post_sale"
      ],
      "default": "during_sale",
      "description": "When the item was sold relative to the sale event"
    },
    "pre_sale_allowed": {
      "type": "boolean",
      "default": false,
      "description": "Estate Sale Company Owner has enabled pre-sale selling for this item",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.seller_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "post_sale_allowed": {
      "type": "boolean",
      "default": false,
      "description": "Estate Sale Company Owner has enabled post-sale selling for this item",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.seller_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "sold_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when item was sold",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.seller_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "buyer_name": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.seller_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "buyer_contact": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.seller_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.operator_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "payment_method_used": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.seller_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
