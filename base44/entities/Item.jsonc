    "price_range_low": {
      "type": "number",
      "description": "Chapter 16 P1-16 \u2014 OPERATOR PRICING RANGE, low end. Evidence-supported planning range the human operator sets (optional \u2014 never required for QUICK merchandise and never invented by the system from a single number). NOT an appraisal and never a promise to the client."
    },
    "price_range_high": {
      "type": "number",
      "description": "Chapter 16 P1-16 \u2014 OPERATOR PRICING RANGE, high end. Optional; distinct by design from Item.price (the single current asking price)."
    },
    "pricing_rationale": {
      "type": "string",
      "description": "Chapter 16 P1-18 \u2014 concise operator rationale for an important price (three sold comparables; condition below strongest comparable; local pickup market; short selling window; client approved aggressive pricing). Optional for low-value merchandise; the system preserves WHY an important price was chosen."
    },
    "market_context": {
      "type": "string",
      "enum": [
        "LOCAL_PICKUP",
        "REGIONAL",
        "NATIONAL",
        "ONLINE_SHIPPED",
        "UNKNOWN"
      ],
      "default": "UNKNOWN",
      "description": "Chapter 16 P1-30 \u2014 the market this item realistically sells in. A NATIONAL/ONLINE internet price never automatically applies to a LOCAL_PICKUP floor market; comparables carry their own market context."
    },
    "selling_channel": {
      "type": "string",
      "enum": [
        "ESTATE_SALE",
        "AUCTION",
        "CONSIGNMENT",
        "SPECIALTY_MARKETPLACE",
        "DIRECT_SALE",
        "OTHER"
      ],
      "default": "ESTATE_SALE",
      "description": "Chapter 16 P1-32/P1-35 \u2014 the operator's decision for HOW this merchandise will be sold. Default ESTATE_SALE (normal floor sale). Recording the chosen channel preserves it for later review; it never auto-reroutes anything and never duplicates Chapter 22 disposition."
    },
    "channel_considered": {
      "type": "boolean",
      "default": false,
      "description": "Chapter 16 P1-33 \u2014 operator flagged CONSIDER ALTERNATE CHANNEL for this merchandise. A review flag only \u2014 the system never reroutes the item automatically."
    },
    "channel_consideration_reason": {
      "type": "string",
      "description": "Chapter 16 P1-33 \u2014 why an alternate channel is being considered (specialist interest, auction potential, better venue...)."
    },
    "channel_decision_id": {
      "type": "string",
      "description": "Chapter 16 P1-34 \u2014 canonical SaleClientDecision link when a channel change required client/authority approval. Reuses the ONE client-approval system; no duplicate approval record."
    },
    "negotiation_override": {
      "type": "string",
      "enum": [
        "NONE",
        "NO_DISCOUNT_WITHOUT_OPERATOR"
      ],
      "default": "NONE",
      "description": "Chapter 16 P1-37 \u2014 ITEM-LEVEL override of the company's general negotiation policy (Company.negotiation_policy). NO_DISCOUNT_WITHOUT_OPERATOR wins over any company-level employee authority for this item. Guidance/authority truth only \u2014 the system never auto-accepts or auto-declines an Offer."
    },
    "excluded_from_discounts": {
      "type": "boolean",
      "default": false,
      "description": "Chapter 16 P1-40 \u2014 this item is EXCLUDED from the sale's planned discount schedule (EstateSale.discount_schedule). Typical for HIGH_VALUE, specialist-reviewed, or client-restricted merchandise. A stage that would discount this item surfaces it for explicit human handling instead."
    },
    "high_consequence_research": {
      "type": "boolean",
      "default": false,
      "description": "Chapter 16 P1-12 \u2014 operator-controlled HIGH-CONSEQUENCE RESEARCH flag: competing identifications could materially affect price or client outcome (original vs reproduction; signed vs unsigned; attributed vs copy). Surfaces the item for more research attention. NEVER an authentication or value conclusion \u2014 AI may suggest looking, never set it.",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "created_by_id": "{{user.id}}"
                }
              ]
            },
            {
              "$and": [
                {
