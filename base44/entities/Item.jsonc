    "pickup_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When sold merchandise was picked up / released to the buyer (guided closeout tracking). Absent = pickup still pending. Independent of selling status.",
      "rls": {
        "read": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
