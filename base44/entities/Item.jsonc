              ]
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "user"
                  }
                },
                {
                  "data.sale_team_ids": {
                    "$in": [
                      "{{user.id}}"
                    ]
                  }
                }
              ]
            },
