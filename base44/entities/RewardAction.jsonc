{
  "name": "RewardAction",
  "type": "object",
  "description": "Platform reward catalog (points per action). Referral Rebuild Phase 1: the catalog is readable by all authenticated users; creating, changing point values, or retiring actions is admin-only so participants cannot mint reward definitions.",
  "properties": {
    "action_id": {
      "type": "string",
      "description": "Unique action identifier"
    },
    "action_name": {
      "type": "string",
      "description": "Name of the action"
    },
    "action_description": {
      "type": "string",
      "description": "Description of what user needs to do"
    },
    "points": {
      "type": "integer",
      "description": "Points awarded for completing this action"
    },
    "category": {
      "type": "string",
      "enum": [
        "engagement",
        "social",
        "sales",
        "referrals",
        "purchases",
        "content"
      ],
      "description": "Category of the action"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "once",
        "daily",
        "weekly",
        "unlimited"
      ],
      "default": "unlimited",
      "description": "How often this action can be completed"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this action is currently available"
    }
  },
  "required": [
    "action_id",
    "action_name",
    "points",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}