{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "Estate sale ID"
    },
    "item_name": {
      "type": "string"
    },
    "quantity": {
      "type": "integer",
      "default": 1
    },
    "price": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "credit_card",
        "venmo",
        "zelle",
        "check"
      ],
      "default": "cash"
    },
    "notes": {
      "type": "string"
    },
    "transaction_date": {
      "type": "string",
      "format": "date-time"
    },
    "seller_amount": {
      "type": "number",
      "description": "LEGACY \u2014 client share of proceeds at the applicable agreement commission rate. Earlier records assumed a fixed 80/20 split; the authoritative split is settlement-derived (see SettlementStatement), never this field."
    },
    "company_amount": {
      "type": "number",
      "description": "LEGACY \u2014 company share of proceeds at the applicable agreement commission rate. Earlier records assumed a fixed 20% split; authoritative company revenue derives from settlement/closeout, never from a fixed split."
    }
  },
  "required": [
    "sale_id",
    "item_name",
    "quantity",
    "price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}