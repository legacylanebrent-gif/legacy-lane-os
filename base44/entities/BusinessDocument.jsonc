{
  "name": "BusinessDocument",
  "type": "object",
  "description": "Chapter 6 P1 \u2014 the ONE canonical business document vault record (insurance, formation, agreements, policies, registrations, permits, certifications, professional documents \u2014 no separate vaults). Files live in PRIVATE storage (file_uri); viewing/downloading always goes through a short-lived signed URL. The document owns its expiration_date; a missing expiration_date means NO EXPIRATION KNOWN (never 'never expires'). version is the acknowledgment-truth anchor: it increments when the file is replaced, so an old acknowledgment never silently covers a new version. Chapter 16 P1-25 adds the 'item' scope so a client-provided APPRAISAL (or other item evidence document) attaches to a canonical Item \u2014 no Appraisal entity; an appraisal is EVIDENCE/CONTEXT and its value is never copied into Item.price.",
  "properties": {
    "operator_id": {
      "type": "string",
      "description": "Estate Sale Company Owner user ID (RLS anchor)."
    },
    "company_id": {
      "type": "string",
      "description": "Canonical Company when known (additive projection)."
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "FORMATION",
        "INSURANCE",
        "AGREEMENT",
        "POLICY",
        "REGISTRATION",
        "PERMIT",
        "CERTIFICATION",
        "PROFESSIONAL",
        "APPRAISAL",
        "OTHER"
      ],
      "default": "OTHER",
      "description": "Document category. Deliberately small taxonomy. Chapter 16 APPRAISAL = a client-provided or commissioned appraisal document attached to an Item \u2014 evidence/context only, never a price the system applies."
    },
    "policy_type": {
      "type": "string",
      "description": "For POLICY documents only: e.g. Confidentiality Policy, Safety Policy, Team Policy, Photo / Privacy Policy, Sale-Day Procedure."
    },
    "scope": {
      "type": "string",
      "enum": [
        "business",
        "sale",
        "contact",
        "team_member",
        "item"
      ],
      "default": "business",
      "description": "Explicit scope. sale_id / contact_id / team_member_id / item_id must match this scope (enforced by the vault UI \u2014 one ref per scope, never contradictory combinations). Chapter 16 P1-25 'item' scope attaches an item-scoped evidence document (e.g. an appraisal) to a canonical Item."
    },
    "sale_id": {
      "type": "string",
      "description": "EstateSale ID when scope is 'sale'."
    },
    "contact_id": {
      "type": "string",
      "description": "Contact ID when scope is 'contact'."
    },
    "team_member_id": {
      "type": "string",
      "description": "TeamMember ID when scope is 'team_member'."
    },
    "item_id": {
      "type": "string",
      "description": "Chapter 16 P1-25 \u2014 canonical Item ID when scope is 'item' (e.g. an appraisal attached to specific merchandise). The Item remains the merchandise record; this document is private evidence only."
    },
    "file_uri": {
      "type": "string",
      "description": "PRIVATE storage URI (UploadPrivateFile). Never a public URL."
    },
    "file_name": {
      "type": "string",
      "description": "Original filename at upload."
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "The document owns this date. Null = NO EXPIRATION KNOWN (not 'never expires')."
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "ARCHIVED",
        "REVIEW"
      ],
      "default": "ACTIVE",
      "description": "No status implies a legal retention conclusion."
    },
    "notes": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "default": 1,
      "description": "Incremented when the file is replaced. Acknowledgment truth anchor: an acknowledgment records the version acknowledged, so a replaced policy is never silently considered acknowledged."
    },
    "template_text": {
      "type": "string",
      "description": "Chapter 9 P0 \u2014 for operator-designated AGREEMENT templates only: the operator's own attorney-reviewed agreement TEXT containing {{MERGE_VARIABLE}} placeholders (e.g. {{CLIENT_NAME}}, {{COMMISSION_RATE}}). EstateSalen populates approved variables from structured records; it never authors, edits, or AI-generates legal language, and a placeholder with no source is flagged MISSING VALUE \u2014 never fabricated."
    },
    "uploaded_by": {
      "type": "string",
      "description": "User ID of the uploader."
    },
    "reminders_sent": {
      "type": "array",
      "default": [],
      "description": "Reminder-engine idempotency ledger. Each warning window (60/30/7/expired) fires at most once per document; a second daily run creates no duplicate notification.",
      "items": {
        "type": "object",
        "properties": {
          "window": {
            "type": "string"
          },
          "sent_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  },
  "required": [
    "operator_id",
    "title",
    "category",
    "file_uri"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.operator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}