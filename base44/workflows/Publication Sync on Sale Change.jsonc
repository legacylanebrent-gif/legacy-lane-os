{
  "name": "Publication Sync on Sale Change",
  "description": "When a canonical EstateSale changes, republishes its existing Publications to their destinations (marks update_pending, then safe idempotent republish). Never creates publications.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "EstateSale"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "publication_sync_on_sale_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_publications": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncSalePublications",
            "args": {
              "sale_id": "${ .trigger.data.id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync publications",
            "description": "Republish changed sale to destinations"
          }
        }
      }
    ]
  }
}