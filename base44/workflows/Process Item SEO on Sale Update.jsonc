      "dsl": "1.0.0",
      "name": "process_item_seo_on_sale_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processItemSeoOnSaleUpdate",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processItemSeoOnSaleUpdate"
  }
}