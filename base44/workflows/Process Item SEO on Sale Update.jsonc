{
  "name": "Process Item SEO on Sale Update",
  "description": "When a sale is updated, generate or refresh SEO item profiles and SEO pages for all named items in the sale.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"images\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "EstateSale"
    }
  },
  "definition": {
