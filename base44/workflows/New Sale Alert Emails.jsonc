{
  "name": "New Sale Alert Emails",
  "description": "Fires sendNewSaleAlerts when a new EstateSale is created \u2014 matches users by location radius, categories, and preferences, then sends personalized alert emails.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"upcoming\" or .trigger.data.status == \"active\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "EstateSale"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_sale_alert_emails",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendNewSaleAlerts",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendNewSaleAlerts"
  }
}