{
  "name": "Sale Status Change Notifications",
  "description": "Notifies operators when their sale status changes (upcoming, active, completed, archived) via in-app and email.',",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "EstateSale"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sale_status_change_notifications",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifySaleStatusChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifySaleStatusChange"
  }
}