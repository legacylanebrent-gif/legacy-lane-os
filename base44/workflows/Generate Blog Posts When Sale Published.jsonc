{
  "name": "Generate Blog Posts When Sale Published",
  "description": "When a sale status changes to upcoming or active, analyze its inventory and generate SEO blog posts.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"upcoming\" or .trigger.data.status == \"active\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "EstateSale"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "generate_blog_posts_when_sale_published",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateInventoryBasedBlogPosts",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateInventoryBasedBlogPosts"
  }
}