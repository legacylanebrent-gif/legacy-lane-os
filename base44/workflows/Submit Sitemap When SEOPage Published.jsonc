{
  "name": "Submit Sitemap When SEOPage Published",
  "description": "Re-submits the sitemap to GSC whenever a new SEOPage is published.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"published\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "SEOPage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "submit_sitemap_when_seopage_published",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "submitSitemapToGSC",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "submitSitemapToGSC"
  }
}