{
  "name": "Generate Marketplace Item SEO on Publish",
  "description": "When a MarketplaceItem is created or updated, generate SEO title, description, keywords, schema, and submit to Google indexing.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"ACTIVE\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "MarketplaceItem"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "generate_marketplace_item_seo_on_publish",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateMarketplaceItemSEO",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateMarketplaceItemSEO"
  }
}