{
  "name": "Auto-Generate Social Campaign on Sale Publish",
  "description": "When a sale goes active, Marketing Autopilot auto-generates social media campaigns.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"upcoming\" or .trigger.data.status == \"active\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "EstateSale"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_generate_social_campaign_on_sale_publish",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateSocialCampaign",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateSocialCampaign"
  }
}