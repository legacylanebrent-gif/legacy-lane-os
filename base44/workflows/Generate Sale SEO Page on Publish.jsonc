{
  "name": "Generate Sale SEO Page on Publish",
  "description": "When a sale is published (status becomes upcoming or active), generate a full SEO page with AI content, event schema, breadcrumb schema, and update all related hub pages.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"upcoming\" or .trigger.data.status == \"active\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "EstateSale"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "generate_sale_seo_page_on_publish",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateSaleSeoPage",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateSaleSeoPage"
  }
}