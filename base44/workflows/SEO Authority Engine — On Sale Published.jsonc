{
  "name": "SEO Authority Engine \u2014 On Sale Published",
  "description": "Runs the full SEO expansion pipeline when a sale is published: sale page, item profiles, brand/category/city hubs, blog opportunities, internal links, schema, sitemap.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"upcoming\" or .trigger.data.status == \"active\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "EstateSale"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "seo_authority_engine_on_sale_published",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onSalePublished",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onSalePublished"
  }
}