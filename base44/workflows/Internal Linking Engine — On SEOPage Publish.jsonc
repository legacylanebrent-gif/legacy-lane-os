{
  "name": "Internal Linking Engine \u2014 On SEOPage Publish",
  "description": "Injects relevant internal links into every SEOPage when it is published or updated.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"published\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "SEOPage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "internal_linking_engine_on_seopage_publish",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "internalLinkingEngine",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "internalLinkingEngine"
  }
}